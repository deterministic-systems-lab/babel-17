(module core
  (header
    (purpose "The core library (WP16, docs/b17-0.md §9): ghost-fns in scope in every B17-0 module, and the laws a proof may use about integers and collections, each a lemma.")
    (invariants "Every ghost-fn is total on its parameter types. Every law is one of §9's background facts or the laws of integer order, or follows directly from them, and its witness examples are confirmed by the reference interpreter (b17c/test_core.py). The effects of push and set-idx are §9's statement facts, which no lemma can state.")
    (failures "None. Ghost-fns and lemmas never run."))
  (ghost-fn sorted ((s (seq int))) bool
    (body (forall ((i int) (j int)) (=> (and (and (<= 0 i) (< i j)) (< j (len s))) (<= (idx s i) (idx s j))))))
  (ghost-fn in_i64 ((x int)) bool
    (body (and (<= -9223372036854775808 x) (< x 9223372036854775808))))
  (ghost-fn seq_update ((s (seq int)) (i int) (e int)) (seq int)
    (requires (and (<= 0 i) (< i (len s))))
    (body (concat (take s i) (concat (seq-lit e) (drop s (+ i 1))))))
  (lemma law_len_nonneg
    (params (s (seq int)))
    (ensures (>= (len s) 0))
    (body))
  (lemma law_len_unit
    (params (x int))
    (ensures (== (len (seq-lit x)) 1))
    (body))
  (lemma law_len_concat
    (params (s (seq int)) (t (seq int)))
    (ensures (== (len (concat s t)) (+ (len s) (len t))))
    (body))
  (lemma law_len_take
    (params (s (seq int)) (k int))
    (requires (and (<= 0 k) (<= k (len s))))
    (ensures (== (len (take s k)) k))
    (body))
  (lemma law_len_drop
    (params (s (seq int)) (k int))
    (requires (and (<= 0 k) (<= k (len s))))
    (ensures (== (len (drop s k)) (- (len s) k)))
    (body))
  (lemma law_idx_concat
    (params (s (seq int)) (t (seq int)) (i int))
    (requires (and (<= 0 i) (< i (+ (len s) (len t)))))
    (ensures (== (idx (concat s t) i) (if (< i (len s)) (idx s i) (idx t (- i (len s))))))
    (body))
  (lemma law_idx_take
    (params (s (seq int)) (k int) (i int))
    (requires (and (and (<= 0 i) (< i k)) (<= k (len s))))
    (ensures (== (idx (take s k) i) (idx s i)))
    (body))
  (lemma law_idx_drop
    (params (s (seq int)) (k int) (i int))
    (requires (and (and (<= 0 k) (<= k (len s))) (and (<= 0 i) (< i (- (len s) k)))))
    (ensures (== (idx (drop s k) i) (idx s (+ i k))))
    (body))
  (lemma law_last
    (params (s (seq int)))
    (requires (> (len s) 0))
    (ensures (== (last s) (idx s (- (len s) 1))))
    (body))
  (lemma law_take_all
    (params (s (seq int)))
    (ensures (== (take s (len s)) s))
    (body))
  (lemma law_take_none
    (params (s (seq int)))
    (ensures (== (len (take s 0)) 0))
    (body))
  (lemma law_take_take
    (params (s (seq int)) (k int) (j int))
    (requires (and (and (<= 0 j) (<= j k)) (<= k (len s))))
    (ensures (== (take (take s k) j) (take s j)))
    (body))
  (lemma law_take_step
    (params (s (seq int)) (i int))
    (requires (and (<= 0 i) (< i (len s))))
    (ensures (== (take s (+ i 1)) (concat (take s i) (seq-lit (idx s i)))))
    (body))
  (lemma law_seq_ext
    (params (s (seq int)) (t (seq int)))
    (requires (and (== (len s) (len t)) (forall ((i int)) (=> (and (<= 0 i) (< i (len s))) (== (idx s i) (idx t i))))))
    (ensures (== s t))
    (body))
  (lemma law_contains
    (params (s (seq int)) (x int))
    (ensures (== (contains s x) (exists ((i int)) (and (and (<= 0 i) (< i (len s))) (== (idx s i) x)))))
    (body))
  (lemma law_contains_concat
    (params (s (seq int)) (t (seq int)) (x int))
    (ensures (== (contains (concat s t) x) (or (contains s x) (contains t x))))
    (body))
  (lemma law_contains_unit
    (params (y int) (x int))
    (ensures (== (contains (seq-lit y) x) (== x y)))
    (body))
  (lemma law_contains_none
    (params (s (seq int)) (x int))
    (ensures (not (contains (take s 0) x)))
    (body))
  (lemma law_occurrences_concat
    (params (s (seq int)) (t (seq int)) (x int))
    (ensures (== (occurrences (concat s t) x) (+ (occurrences s x) (occurrences t x))))
    (body))
  (lemma law_occurrences_unit
    (params (y int) (x int))
    (ensures (== (occurrences (seq-lit y) x) (if (== x y) 1 0)))
    (body))
  (lemma law_occurrences_none
    (params (s (seq int)) (x int))
    (ensures (== (occurrences (take s 0) x) 0))
    (body))
  (lemma law_multiset_concat
    (params (s (seq int)) (t (seq int)))
    (ensures (== (multiset (concat s t)) (msum (multiset s) (multiset t))))
    (body))
  (lemma law_update_len
    (params (s (seq int)) (i int) (e int))
    (requires (and (<= 0 i) (< i (len s))))
    (ensures (== (len (seq_update s i e)) (len s)))
    (body))
  (lemma law_update_at
    (params (s (seq int)) (i int) (e int))
    (requires (and (<= 0 i) (< i (len s))))
    (ensures (== (idx (seq_update s i e) i) e))
    (body))
  (lemma law_update_other
    (params (s (seq int)) (i int) (e int) (k int))
    (requires (and (and (<= 0 i) (< i (len s))) (and (and (<= 0 k) (< k (len s))) (!= k i))))
    (ensures (== (idx (seq_update s i e) k) (idx s k)))
    (body))
  (lemma law_le_refl
    (params (a int))
    (ensures (<= a a))
    (body))
  (lemma law_le_trans
    (params (a int) (b int) (c int))
    (requires (and (<= a b) (<= b c)))
    (ensures (<= a c))
    (body))
  (lemma law_le_antisym
    (params (a int) (b int))
    (requires (and (<= a b) (<= b a)))
    (ensures (== a b))
    (body))
  (lemma law_le_total
    (params (a int) (b int))
    (ensures (or (<= a b) (<= b a)))
    (body))
  (lemma law_lt_succ
    (params (a int) (b int))
    (requires (< a b))
    (ensures (<= (+ a 1) b))
    (body)))
