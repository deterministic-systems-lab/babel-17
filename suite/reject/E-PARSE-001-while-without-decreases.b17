(module count_up
  (header
    (purpose "A while loop must give a decreases clause.")
    (invariants "None.")
    (failures "None."))
  (spec count_up
    (params (n i64))
    (returns (r i64))
    (requires (>= n 0))
    (ensures (== r n))
    (effects))
  (def count_up
    (body
      (let-mut i i64 0)
      (while (< i n)
        (invariant (and (<= 0 i) (<= i n)))
        (set i (+ i 1)))
      (return i))))
