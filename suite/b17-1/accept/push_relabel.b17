(module push_relabel
  (header
    (purpose "Find the value of a maximum flow from s to t in a directed graph with edge capacities, with the push-relabel algorithm.")
    (invariants "The result is the value of a valid flow that no valid flow exceeds.")
    (failures "Allocation failure aborts."))
  (data capacity_graph () (capacity_graph (adj (vec (vec (tuple i64 i64))))))
  (ghost-fn size ((cg capacity_graph)) int
    (body (len (field cg adj))))
  (ghost-fn view ((cg capacity_graph)) (seq (seq (tuple int int)))
    (body (field cg adj)))
  (ghost-fn well_formed ((cg capacity_graph)) bool
    (body (and
      (forall ((u int) (i int))
        (=> (and (and (<= 0 u) (< u (len (field cg adj)))) (and (<= 0 i) (< i (len (idx (field cg adj) u)))))
            (and (<= 0 (get (idx (idx (field cg adj) u) i) 0)) (< (get (idx (idx (field cg adj) u) i) 0) (len (field cg adj))))))
      (forall ((u int) (i int) (j int))
        (=> (and (and (and (<= 0 u) (< u (len (field cg adj)))) (and (<= 0 i) (< i (len (idx (field cg adj) u)))))
                 (and (and (<= 0 j) (< j (len (idx (field cg adj) u)))) (!= i j)))
            (!= (get (idx (idx (field cg adj) u) i) 0) (get (idx (idx (field cg adj) u) j) 0)))))))
  (ghost-fn has_capacity ((g (seq (seq (tuple int int)))) (u int) (v int) (c int)) bool
    (body (exists ((i int))
      (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u)))))
           (and (== (get (idx (idx g u) i) 0) v) (== (get (idx (idx g u) i) 1) c))))))
  (ghost-fn get_flow ((f (seq (seq int))) (u int) (v int)) int
    (body (if (and (and (<= 0 u) (< u (len f))) (and (<= 0 v) (< v (len (idx f u))))) (idx (idx f u) v) 0)))
  (ghost-fn respects_capacity ((g (seq (seq (tuple int int)))) (f (seq (seq int)))) bool
    (body (forall ((u int) (v int))
      (=> (and (and (<= 0 u) (< u (len f))) (and (<= 0 v) (< v (len (idx f u)))))
          (=> (> (idx (idx f u) v) 0) (exists ((c int)) (and (has_capacity g u v c) (<= (idx (idx f u) v) c))))))))
  (ghost-fn sum_flow_out_recursive ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (u int) (k int)) int (decreases k)
    (body (if (or (<= k 0) (or (< u 0) (>= u (len g)))) 0
            (if (< (- k 1) (len (idx g u)))
              (+ (sum_flow_out_recursive g f u (- k 1)) (get_flow f u (get (idx (idx g u) (- k 1)) 0)))
              (sum_flow_out_recursive g f u (- k 1))))))
  (ghost-fn sum_flow_in_recursive ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (u int) (k int)) int (decreases k)
    (body (if (<= k 0) 0 (+ (sum_flow_in_recursive g f u (- k 1)) (get_flow f (- k 1) u)))))
  (ghost-fn total_flow_out ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (u int)) int
    (body (if (and (<= 0 u) (< u (len g))) (sum_flow_out_recursive g f u (len (idx g u))) 0)))
  (ghost-fn total_flow_in ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (u int)) int
    (body (sum_flow_in_recursive g f u (len g))))
  (ghost-fn is_conserved ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (s int) (t int)) bool
    (body (forall ((u int))
      (=> (and (and (<= 0 u) (< u (len g))) (and (!= u s) (!= u t))) (== (total_flow_in g f u) (total_flow_out g f u))))))
  (ghost-fn is_valid_flow ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (s int) (t int)) bool
    (body (and (and (respects_capacity g f) (is_conserved g f s t))
               (forall ((u int) (v int))
                 (=> (and (and (<= 0 u) (< u (len f))) (and (<= 0 v) (< v (len (idx f u))))) (>= (idx (idx f u) v) 0))))))
  (ghost-fn flow_val ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (s int)) int
    (body (- (total_flow_out g f s) (total_flow_in g f s))))
  (ghost-fn is_max_flow ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (s int) (t int)) bool
    (body (and (is_valid_flow g f s t)
               (forall ((other (seq (seq int))))
                 (=> (is_valid_flow g other s t) (>= (flow_val g f s) (flow_val g other s)))))))
  (ghost-fn capacities_bounded ((g (seq (seq (tuple int int))))) bool
    (body (and (<= (len g) 1000)
               (forall ((u int) (v int) (c int)) (=> (has_capacity g u v c) (and (>= c 0) (<= c 100000)))))))
  (spec max_flow_value
    (params (graph capacity_graph) (s i64) (t i64))
    (returns (max_val i64))
    (requires (well_formed graph) (capacities_bounded (view graph))
              (and (<= 0 s) (< s (size graph))) (and (<= 0 t) (< t (size graph))) (!= s t))
    (ensures (exists ((f (seq (seq int)))) (and (is_max_flow (view graph) f s t) (== (flow_val (view graph) f s) max_val))))
    (effects alloc))

  (ghost-fn total ((a (seq int))) int (decreases (len a))
    (body (if (== (len a) 0) 0 (+ (total (take a (- (len a) 1))) (idx a (- (len a) 1))))))
  (ghost-fn frow ((m (seq (seq int))) (u int) (k int)) (seq int) (requires (>= k 0))
    (body (seq-build k (fn (v) (get_flow m u v)))))
  (ghost-fn fcol ((m (seq (seq int))) (v int) (k int)) (seq int) (requires (>= k 0))
    (body (seq-build k (fn (u) (get_flow m u v)))))
  (ghost-fn rsum ((m (seq (seq int))) (p int) (n int)) (seq int) (requires (and (>= p 0) (>= n 0)))
    (body (seq-build p (fn (u) (total (frow m u n))))))
  (ghost-fn csum ((m (seq (seq int))) (p int) (n int)) (seq int) (requires (and (>= p 0) (>= n 0)))
    (body (seq-build n (fn (v) (total (fcol m v p))))))
  (ghost-fn zeros ((n int)) (seq int) (requires (>= n 0))
    (body (seq-build n (fn (v) 0))))
  (ghost-fn spot ((m (seq (seq int))) (u int) (w int) (n int)) (seq int) (requires (>= n 0))
    (body (seq-build n (fn (v) (if (== v w) (get_flow m u v) 0)))))
  (ghost-fn hit ((g (seq (seq (tuple int int)))) (u int) (v int) (k int)) bool
    (body (exists ((i int))
      (and (and (and (<= 0 u) (< u (len g))) (and (and (<= 0 i) (< i k)) (< i (len (idx g u)))))
           (== (get (idx (idx g u) i) 0) v)))))
  (ghost-fn mrow ((g (seq (seq (tuple int int)))) (h (seq (seq int))) (u int) (k int)) (seq int)
    (body (seq-build (len g) (fn (v) (if (hit g u v k) (get_flow h u v) 0)))))
  (ghost-fn in_range ((g (seq (seq (tuple int int))))) bool
    (body (forall ((a int) (i int)) (=> (and (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
      (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len g)))))))
  (ghost-fn distinct ((g (seq (seq (tuple int int))))) bool
    (body (forall ((u int) (i int) (j int))
      (=> (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u))))) (and (and (<= 0 j) (< j (len (idx g u)))) (!= i j)))
          (!= (get (idx (idx g u) i) 0) (get (idx (idx g u) j) 0))))))
  (ghost-fn square ((m (seq (seq int))) (n int)) bool
    (body (and (== (len m) n) (forall ((u int)) (=> (and (<= 0 u) (< u n)) (== (len (idx m u)) n))))))
  (ghost-fn under ((h (seq (seq int))) (cm (seq (seq int))) (n int)) bool
    (body (forall ((u int) (v int)) (=> (and (and (<= 0 u) (< u n)) (and (<= 0 v) (< v n)))
      (and (<= 0 (get_flow h u v)) (<= (get_flow h u v) (get_flow cm u v)))))))
  (ghost-fn fits ((f (seq (seq int))) (cm (seq (seq int))) (n int)) bool
    (body (and (square f n) (under f cm n))))
  (ghost-fn capbuilt ((g (seq (seq (tuple int int)))) (cm (seq (seq int))) (a0 int) (k int)) bool
    (body (and (square cm (len g))
      (and (forall ((u int) (v int)) (=> (and (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g))))
             (and (and (<= 0 (get_flow cm u v)) (<= (get_flow cm u v) 100000))
                  (=> (> (get_flow cm u v) 0) (hit g u v (len (idx g u)))))))
           (forall ((u int) (i int))
             (=> (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u))))) (or (< u a0) (and (== u a0) (< i k))))
                 (== (get_flow cm u (get (idx (idx g u) i) 0)) (get (idx (idx g u) i) 1))))))))
  (ghost-fn capok ((g (seq (seq (tuple int int)))) (cm (seq (seq int)))) bool
    (body (capbuilt g cm (len g) 0)))
  (ghost-fn bump ((h0 (seq (seq int))) (h1 (seq (seq int))) (a int) (b int) (d int)) bool
    (body (and (and (== (len h1) (len h0)) (forall ((x int)) (=> (and (<= 0 x) (< x (len h0))) (== (len (idx h1 x)) (len (idx h0 x))))))
               (forall ((x int) (y int)) (== (get_flow h1 x y) (+ (get_flow h0 x y) (if (and (== x a) (== y b)) d 0)))))))
  (ghost-fn res ((cm (seq (seq int))) (f (seq (seq int))) (u int) (v int)) int
    (body (+ (- (get_flow cm u v) (get_flow f u v)) (get_flow f v u))))
  (ghost-fn wt ((su bool) (sv bool) (z int)) int
    (body (if su (if sv 0 z) (if sv (- 0 z) 0))))
  (ghost-fn wm ((h (seq (seq int))) (sc (seq bool))) (seq (seq int))
    (body (seq-build (len sc) (fn (u) (seq-build (len sc) (fn (v) (wt (idx sc u) (idx sc v) (get_flow h u v))))))))
  (ghost-fn km ((h (seq (seq int))) (sc (seq bool))) (seq (seq int))
    (body (seq-build (len sc) (fn (u) (seq-build (len sc) (fn (v) (if (idx sc v) (get_flow h u v) 0)))))))
  (ghost-fn opart ((h (seq (seq int))) (sc (seq bool))) (seq int)
    (body (seq-build (len sc) (fn (u) (if (idx sc u) (total (frow h u (len sc))) 0)))))
  (ghost-fn epart ((g (seq (seq (tuple int int)))) (h (seq (seq int))) (sc (seq bool))) (seq int)
    (body (seq-build (len sc) (fn (u) (if (idx sc u) (- (total_flow_out g h u) (total_flow_in g h u)) 0)))))
  (ghost-fn cutok ((f (seq (seq int))) (cm (seq (seq int))) (sc (seq bool))) bool
    (body (forall ((u int) (v int)) (=> (and (and (<= 0 u) (< u (len sc))) (and (<= 0 v) (< v (len sc))))
      (and (=> (and (idx sc u) (not (idx sc v))) (== (get_flow f u v) (get_flow cm u v)))
           (=> (and (not (idx sc u)) (idx sc v)) (== (get_flow f u v) 0)))))))
  (ghost-fn outside ((vis (seq bool)) (k int)) int (requires (and (<= 0 k) (<= k (len vis)))) (decreases k)
    (body (if (== k 0) 0 (+ (outside vis (- k 1)) (if (idx vis (- k 1)) 0 1)))))
  (ghost-fn upd ((s0 (seq int)) (s1 (seq int)) (v int) (x int)) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))
  (ghost-fn updb ((s0 (seq bool)) (s1 (seq bool)) (v int) (x bool)) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))
  (lemma t_add (params (a (seq int)) (b (seq int)) (c (seq int)))
    (requires (== (len a) (len c)) (== (len b) (len c))
              (forall ((i int)) (=> (and (<= 0 i) (< i (len c))) (== (idx c i) (+ (idx a i) (idx b i))))))
    (ensures (== (total c) (+ (total a) (total b))))
    (decreases (len c))
    (body (if (> (len c) 0) (call t_add (take a (- (len c) 1)) (take b (- (len c) 1)) (take c (- (len c) 1))) (block))))
  (lemma t_le (params (a (seq int)) (b (seq int)))
    (requires (== (len a) (len b)) (forall ((i int)) (=> (and (<= 0 i) (< i (len a))) (<= (idx a i) (idx b i)))))
    (ensures (<= (total a) (total b)))
    (decreases (len a))
    (body (if (> (len a) 0) (call t_le (take a (- (len a) 1)) (take b (- (len a) 1))) (block))))
  (lemma t_zero (params (a (seq int)))
    (requires (forall ((i int)) (=> (and (<= 0 i) (< i (len a))) (== (idx a i) 0))))
    (ensures (== (total a) 0))
    (decreases (len a))
    (body (if (> (len a) 0) (call t_zero (take a (- (len a) 1))) (block))))
  (lemma t_one (params (a (seq int)) (w int))
    (requires (and (<= 0 w) (< w (len a))) (forall ((i int)) (=> (and (and (<= 0 i) (< i (len a))) (!= i w)) (== (idx a i) 0))))
    (ensures (== (total a) (idx a w)))
    (decreases (len a))
    (body (if (== w (- (len a) 1)) (call t_zero (take a w)) (call t_one (take a (- (len a) 1)) w))))
  (lemma t_bound (params (a (seq int)))
    (requires (forall ((i int)) (=> (and (<= 0 i) (< i (len a))) (and (<= 0 (idx a i)) (<= (idx a i) 100000)))))
    (ensures (<= 0 (total a)) (<= (total a) (* (len a) 100000)))
    (decreases (len a))
    (body (if (> (len a) 0) (call t_bound (take a (- (len a) 1))) (block))))
  (lemma col_step (params (m (seq (seq int))) (v int) (p int))
    (requires (> p 0))
    (ensures (== (total (fcol m v p)) (+ (total (fcol m v (- p 1))) (get_flow m (- p 1) v))))
    (body (assert (== (take (fcol m v p) (- p 1)) (fcol m v (- p 1))))))
  (lemma fubini (params (m (seq (seq int))) (p int) (n int))
    (requires (>= p 0) (>= n 0))
    (ensures (== (total (rsum m p n)) (total (csum m p n))))
    (decreases p)
    (body
      (if (== p 0)
        (call t_zero (csum m 0 n))
        (block
          (call fubini m (- p 1) n)
          (assert (== (take (rsum m p n) (- p 1)) (rsum m (- p 1) n)))
          (forall ((v int)) (call col_step m v p))
          (call t_add (csum m (- p 1) n) (frow m (- p 1) n) (csum m p n))))))
  (lemma hit_step (params (g (seq (seq (tuple int int)))) (u int) (v int) (k int))
    (requires (distinct g) (and (<= 0 u) (< u (len g))) (and (<= 1 k) (<= k (len (idx g u)))))
    (ensures (== (hit g u v k) (or (hit g u v (- k 1)) (== (get (idx (idx g u) (- k 1)) 0) v)))
             (=> (hit g u v (- k 1)) (!= (get (idx (idx g u) (- k 1)) 0) v)))
    (body
      (if (hit g u v k) (obtain ((i int)) (and (and (<= 0 i) (< i k)) (== (get (idx (idx g u) i) 0) v))) (block))
      (if (hit g u v (- k 1)) (obtain ((j int)) (and (and (<= 0 j) (< j (- k 1))) (== (get (idx (idx g u) j) 0) v))) (block))))
  (lemma reindex_k (params (g (seq (seq (tuple int int)))) (h (seq (seq int))) (u int) (k int))
    (requires (in_range g) (distinct g) (and (<= 0 u) (< u (len g))) (and (<= 0 k) (<= k (len (idx g u)))))
    (ensures (== (sum_flow_out_recursive g h u k) (total (mrow g h u k))))
    (decreases k)
    (body
      (if (> k 0)
        (block
          (call reindex_k g h u (- k 1))
          (call t_one (spot h u (get (idx (idx g u) (- k 1)) 0) (len g)) (get (idx (idx g u) (- k 1)) 0))
          (call t_add (mrow g h u (- k 1)) (spot h u (get (idx (idx g u) (- k 1)) 0) (len g)) (mrow g h u k)))
        (call t_zero (mrow g h u 0)))))
  (lemma reindex (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (h (seq (seq int))) (u int))
    (requires (in_range g) (distinct g) (capok g cm) (under h cm (len g)) (and (<= 0 u) (< u (len g))))
    (ensures (== (total_flow_out g h u) (total (frow h u (len g)))))
    (body
      (call reindex_k g h u (len (idx g u)))
      (assert (== (mrow g h u (len (idx g u))) (frow h u (len g))))))
  (lemma in_sum (params (g (seq (seq (tuple int int)))) (h (seq (seq int))) (u int) (k int))
    (requires (>= k 0))
    (ensures (== (sum_flow_in_recursive g h u k) (total (fcol h u k))))
    (decreases k)
    (body (if (> k 0) (block (call in_sum g h u (- k 1)) (call col_step h u k)) (block))))
  (lemma out_chg_k (params (g (seq (seq (tuple int int)))) (h0 (seq (seq int))) (h1 (seq (seq int))) (a int) (b int) (d int) (y int) (k int))
    (requires (distinct g) (bump h0 h1 a b d) (and (<= 0 y) (< y (len g))) (and (<= 0 k) (<= k (len (idx g y)))))
    (ensures (== (sum_flow_out_recursive g h1 y k) (+ (sum_flow_out_recursive g h0 y k) (if (and (== y a) (hit g a b k)) d 0))))
    (decreases k)
    (body (if (> k 0) (block (call out_chg_k g h0 h1 a b d y (- k 1)) (call hit_step g y b k)) (block))))
  (lemma out_chg (params (g (seq (seq (tuple int int)))) (h0 (seq (seq int))) (h1 (seq (seq int))) (a int) (b int) (d int) (y int))
    (requires (distinct g) (bump h0 h1 a b d) (and (<= 0 y) (< y (len g))))
    (ensures (== (total_flow_out g h1 y) (+ (total_flow_out g h0 y) (if (and (== y a) (hit g a b (len (idx g a)))) d 0))))
    (body (call out_chg_k g h0 h1 a b d y (len (idx g y)))))
  (lemma in_chg (params (g (seq (seq (tuple int int)))) (h0 (seq (seq int))) (h1 (seq (seq int))) (a int) (b int) (d int) (y int) (k int))
    (requires (bump h0 h1 a b d) (>= k 0))
    (ensures (== (sum_flow_in_recursive g h1 y k) (+ (sum_flow_in_recursive g h0 y k) (if (and (== y b) (and (<= 0 a) (< a k))) d 0))))
    (decreases k)
    (body (if (> k 0) (call in_chg g h0 h1 a b d y (- k 1)) (block))))
  (lemma cap_one (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f (seq (seq int))) (u int) (v int))
    (requires (capok g cm) (fits f cm (len g)) (and (<= 0 u) (< u (len f))) (and (<= 0 v) (< v (len (idx f u)))))
    (ensures (=> (> (idx (idx f u) v) 0) (exists ((c int)) (and (has_capacity g u v c) (<= (idx (idx f u) v) c)))))
    (body
      (if (> (get_flow f u v) 0)
        (block
          (obtain ((i int)) (and (and (<= 0 i) (< i (len (idx g u)))) (== (get (idx (idx g u) i) 0) v)))
          (assert (has_capacity g u v (get_flow cm u v))))
        (block))))
  (lemma capacity_of (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f (seq (seq int))))
    (requires (capok g cm) (fits f cm (len g)))
    (ensures (respects_capacity g f)
             (forall ((u int) (v int)) (=> (and (and (<= 0 u) (< u (len f))) (and (<= 0 v) (< v (len (idx f u))))) (>= (idx (idx f u) v) 0))))
    (body
      (forall ((u int) (v int)) (call cap_one g cm f u v))
      (forall ((u int) (v int)) (call nonneg f cm (len g) u v))))
  (lemma nonneg (params (f (seq (seq int))) (cm (seq (seq int))) (n int) (u int) (v int))
    (requires (fits f cm n) (and (<= 0 u) (< u (len f))) (and (<= 0 v) (< v (len (idx f u)))))
    (ensures (>= (idx (idx f u) v) 0))
    (body (assert (<= 0 (get_flow f u v)))))
  (lemma zero_flow (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (z (seq (seq int))) (u int))
    (requires (in_range g) (distinct g) (capok g cm) (fits z cm (len g))
              (forall ((a int) (b int)) (== (get_flow z a b) 0)) (and (<= 0 u) (< u (len g))))
    (ensures (== (total_flow_out g z u) 0) (== (total_flow_in g z u) 0))
    (body
      (call reindex g cm z u)
      (call in_sum g z u (len g))
      (call t_zero (frow z u (len g)))
      (call t_zero (fcol z u (len g)))))
  (lemma row_id (params (h (seq (seq int))) (sc (seq bool)) (u int))
    (requires (and (<= 0 u) (< u (len sc))))
    (ensures (== (+ (total (frow (wm h sc) u (len sc))) (total (frow (km h sc) u (len sc))))
                 (if (idx sc u) (total (frow h u (len sc))) 0)))
    (body
      (if (idx sc u)
        (call t_add (frow (wm h sc) u (len sc)) (frow (km h sc) u (len sc)) (frow h u (len sc)))
        (block
          (call t_zero (zeros (len sc)))
          (call t_add (frow (wm h sc) u (len sc)) (frow (km h sc) u (len sc)) (zeros (len sc)))))))
  (lemma col_id (params (h (seq (seq int))) (sc (seq bool)) (v int))
    (requires (and (<= 0 v) (< v (len sc))))
    (ensures (== (total (fcol (km h sc) v (len sc))) (if (idx sc v) (total (fcol h v (len sc))) 0)))
    (body
      (if (idx sc v)
        (assert (== (fcol (km h sc) v (len sc)) (fcol h v (len sc))))
        (call t_zero (fcol (km h sc) v (len sc))))))
  (lemma side (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (h (seq (seq int))) (sc (seq bool)) (u int))
    (requires (in_range g) (distinct g) (capok g cm) (under h cm (len g)) (== (len sc) (len g)) (and (<= 0 u) (< u (len g))))
    (ensures (== (idx (opart h sc) u) (+ (idx (epart g h sc) u) (idx (csum (km h sc) (len sc) (len sc)) u))))
    (body
      (call reindex g cm h u)
      (call in_sum g h u (len g))
      (call col_id h sc u)))
  (lemma row_le (params (h (seq (seq int))) (f (seq (seq int))) (cm (seq (seq int))) (sc (seq bool)) (u int))
    (requires (under h cm (len sc)) (cutok f cm sc) (and (<= 0 u) (< u (len sc))))
    (ensures (<= (total (frow (wm h sc) u (len sc))) (total (frow (wm f sc) u (len sc)))))
    (body (call t_le (frow (wm h sc) u (len sc)) (frow (wm f sc) u (len sc)))))
  (lemma max_one (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f (seq (seq int))) (sc (seq bool)) (s int) (t int) (o (seq (seq int))))
    (requires (in_range g) (distinct g) (capok g cm) (fits f cm (len g)) (is_conserved g f s t) (cutok f cm sc) (== (len sc) (len g))
              (and (<= 0 s) (< s (len g))) (idx sc s) (and (<= 0 t) (< t (len g))) (not (idx sc t)))
    (ensures (=> (is_valid_flow g o s t) (>= (flow_val g f s) (flow_val g o s))))
    (body
      (if (is_valid_flow g o s t)
        (block
          (call cut_id g cm o sc s t)
          (call cut_id g cm f sc s t)
          (forall ((u int)) (call row_le o f cm sc u))
          (call t_le (rsum (wm o sc) (len sc) (len sc)) (rsum (wm f sc) (len sc) (len sc))))
        (block))))
  (lemma cap_step (params (g (seq (seq (tuple int int)))) (cm0 (seq (seq int))) (cm (seq (seq int))) (u int) (k int))
    (requires (in_range g) (distinct g) (capacities_bounded g) (and (<= 0 u) (< u (len g))) (and (<= 0 k) (< k (len (idx g u))))
              (capbuilt g cm0 u k)
              (bump cm0 cm u (get (idx (idx g u) k) 0) (- (get (idx (idx g u) k) 1) (get_flow cm0 u (get (idx (idx g u) k) 0)))))
    (ensures (capbuilt g cm u (+ k 1)))
    (body
      (assert (has_capacity g u (get (idx (idx g u) k) 0) (get (idx (idx g u) k) 1)))
      (assert (hit g u (get (idx (idx g u) k) 0) (len (idx g u))))))
  (lemma outside_all (params (vis (seq bool)) (k int))
    (requires (and (<= 0 k) (<= k (len vis))) (forall ((j int)) (=> (and (<= 0 j) (< j (len vis))) (not (idx vis j)))))
    (ensures (== (outside vis k) k))
    (decreases k)
    (body (if (> k 0) (call outside_all vis (- k 1)) (block))))
  (lemma outside_range (params (vis (seq bool)) (k int))
    (requires (and (<= 0 k) (<= k (len vis))))
    (ensures (and (>= (outside vis k) 0) (<= (outside vis k) k)))
    (decreases k)
    (body (if (> k 0) (call outside_range vis (- k 1)) (block))))
  (lemma outside_drop (params (vis0 (seq bool)) (vis (seq bool)) (y int) (k int))
    (requires (updb vis0 vis y true) (not (idx vis0 y)) (and (<= 0 k) (<= k (len vis0))))
    (ensures (== (outside vis k) (- (outside vis0 k) (if (< y k) 1 0))))
    (decreases k)
    (body (if (> k 0) (call outside_drop vis0 vis y (- k 1)) (block))))
  (lemma cell (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f (seq (seq int))) (u int) (v int))
    (requires (capok g cm) (fits f cm (len g)) (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g))))
    (ensures (and (<= 0 (get_flow f u v)) (<= (get_flow f u v) (get_flow cm u v))) (<= (get_flow cm u v) 100000))
    (body))
  (ghost-fn exc ((g (seq (seq (tuple int int)))) (f (seq (seq int))) (e (seq int))) bool
    (body (and (== (len e) (len g))
               (forall ((y int)) (=> (and (<= 0 y) (< y (len g))) (== (idx e y) (- (total_flow_in g f y) (total_flow_out g f y))))))))
  (ghost-fn pos ((e (seq int)) (s int)) bool
    (body (forall ((y int)) (=> (and (and (<= 0 y) (< y (len e))) (!= y s)) (>= (idx e y) 0)))))
  (ghost-fn labeled ((cm (seq (seq int))) (f (seq (seq int))) (h (seq int))) bool
    (body (forall ((a int) (b int)) (=> (and (and (<= 0 a) (< a (len h))) (and (<= 0 b) (< b (len h))))
      (=> (> (res cm f a b) 0) (<= (idx h a) (+ (idx h b) 1)))))))
  (ghost-fn hok ((h (seq int)) (n int) (s int) (t int)) bool
    (body (and (and (== (len h) n) (and (and (<= 0 s) (< s n)) (and (<= 0 t) (< t n))))
               (and (and (== (idx h s) n) (== (idx h t) 0))
                    (forall ((x int)) (=> (and (<= 0 x) (< x n)) (and (<= 0 (idx h x)) (< (idx h x) (* 2 n)))))))))
  (ghost-fn stuck ((cm (seq (seq int))) (f (seq (seq int))) (h (seq int)) (e (seq int)) (s int) (t int) (a int) (b int)) bool
    (body (forall ((x int) (y int))
      (=> (and (and (and (<= 0 x) (< x (len h))) (< x (len e))) (and (and (<= 0 y) (< y (len h))) (or (< x a) (and (== x a) (< y b)))))
          (=> (and (and (!= x s) (!= x t)) (> (idx e x) 0)) (or (<= (res cm f x y) 0) (!= (idx h x) (+ (idx h y) 1))))))))
  (ghost-fn at ((h (seq int)) (vis (seq bool)) (k int)) bool
    (body (exists ((x int)) (and (and (and (<= 0 x) (< x (len vis))) (< x (len h))) (and (not (idx vis x)) (== (idx h x) k))))))
  (ghost-fn covered ((h (seq int)) (vis (seq bool)) (a int) (b int)) bool
    (body (forall ((k int)) (=> (and (<= a k) (< k b)) (at h vis k)))))
  (ghost-fn mark ((vis (seq bool)) (x int)) (seq bool)
    (body (seq-build (len vis) (fn (y) (or (idx vis y) (== y x))))))
  (ghost-fn blank ((n int)) (seq bool) (requires (>= n 0))
    (body (seq-build n (fn (x) false))))
  (ghost-fn marks ((n int) (s int) (t int) (u int)) (seq bool) (requires (>= n 0))
    (body (seq-build n (fn (x) (or (or (== x s) (== x t)) (== x u))))))
  (ghost-fn above ((h (seq int)) (k int)) (seq bool)
    (body (seq-build (len h) (fn (x) (> (idx h x) k)))))
  (ghost-fn rep ((c int) (k int)) (seq int) (requires (>= k 0))
    (body (seq-build k (fn (j) c))))
  (ghost-fn pw ((e (seq int)) (h (seq int)) (s int)) (seq int)
    (body (seq-build (len e) (fn (x) (if (or (== x s) (>= x (len h))) 0 (if (< (idx h x) 0) 0 (total (rep (idx e x) (idx h x)))))))))
  (ghost-fn room ((h (seq int)) (n int)) (seq int)
    (body (seq-build (len h) (fn (x) (- (* 2 n) (idx h x))))))

  (lemma t_set (params (a (seq int)) (c (seq int)) (w int))
    (requires (== (len a) (len c)) (and (<= 0 w) (< w (len a)))
              (forall ((i int)) (=> (and (and (<= 0 i) (< i (len a))) (!= i w)) (== (idx c i) (idx a i)))))
    (ensures (== (total c) (+ (total a) (- (idx c w) (idx a w)))))
    (decreases (len a))
    (body (if (== w (- (len a) 1)) (assert (== (take c w) (take a w))) (call t_set (take a (- (len a) 1)) (take c (- (len a) 1)) w))))
  (lemma t_pos (params (a (seq int)))
    (requires (forall ((i int)) (=> (and (<= 0 i) (< i (len a))) (>= (idx a i) 0))))
    (ensures (>= (total a) 0))
    (decreases (len a))
    (body (if (> (len a) 0) (call t_pos (take a (- (len a) 1))) (block))))
  (lemma t_neg (params (a (seq int)) (w int))
    (requires (and (<= 0 w) (< w (len a))) (forall ((i int)) (=> (and (<= 0 i) (< i (len a))) (<= (idx a i) 0))) (< (idx a w) 0))
    (ensures (< (total a) 0))
    (decreases (len a))
    (body (if (== w (- (len a) 1)) (block (call t_le (take a w) (zeros w)) (call t_zero (zeros w))) (call t_neg (take a (- (len a) 1)) w))))
  (lemma ebound (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f (seq (seq int))) (e (seq int)) (y int))
    (requires (in_range g) (distinct g) (capok g cm) (fits f cm (len g)) (exc g f e) (<= (len g) 1000) (and (<= 0 y) (< y (len g))))
    (ensures (and (<= (- 0 100000000) (idx e y)) (<= (idx e y) 100000000)))
    (body
      (call reindex g cm f y)
      (call in_sum g f y (len g))
      (call t_bound (frow f y (len g)))
      (call t_bound (fcol f y (len g)))))
  (lemma cut_sum (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (h (seq (seq int))) (sc (seq bool)))
    (requires (in_range g) (distinct g) (capok g cm) (under h cm (len g)) (== (len sc) (len g)))
    (ensures (== (total (epart g h sc)) (total (rsum (wm h sc) (len sc) (len sc)))))
    (body
      (forall ((u int)) (call row_id h sc u))
      (call t_add (rsum (wm h sc) (len sc) (len sc)) (rsum (km h sc) (len sc) (len sc)) (opart h sc))
      (call fubini (km h sc) (len sc) (len sc))
      (forall ((u int)) (call side g cm h sc u))
      (call t_add (epart g h sc) (csum (km h sc) (len sc) (len sc)) (opart h sc))))
  (lemma cut_id (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (h (seq (seq int))) (sc (seq bool)) (s int) (t int))
    (requires (in_range g) (distinct g) (capok g cm) (under h cm (len g)) (== (len sc) (len g))
              (and (<= 0 s) (< s (len g))) (idx sc s) (and (<= 0 t) (< t (len g))) (not (idx sc t)) (is_conserved g h s t))
    (ensures (== (flow_val g h s) (total (rsum (wm h sc) (len sc) (len sc)))))
    (body
      (call cut_sum g cm h sc)
      (call t_one (epart g h sc) s)))
  (lemma at_drop (params (h (seq int)) (vis (seq bool)) (x int) (a int) (b int) (k int))
    (requires (covered h vis a b) (and (and (<= 0 x) (< x (len vis))) (< x (len h))) (== (idx h x) (- b 1)))
    (ensures (=> (and (<= a k) (< k (- b 1))) (at h (mark vis x) k)))
    (body
      (if (and (<= a k) (< k (- b 1)))
        (block
          (assert (at h vis k))
          (obtain ((y int)) (and (and (and (<= 0 y) (< y (len vis))) (< y (len h))) (and (not (idx vis y)) (== (idx h y) k))))
          (assert (not (idx (mark vis x) y))))
        (block))))
  (lemma pigeon (params (h (seq int)) (vis (seq bool)) (a int) (b int))
    (requires (covered h vis a b))
    (ensures (>= (outside vis (len vis)) (- b a)))
    (decreases (- b a))
    (body
      (if (< a b)
        (block
          (assert (at h vis (- b 1)))
          (obtain ((x int)) (and (and (and (<= 0 x) (< x (len vis))) (< x (len h))) (and (not (idx vis x)) (== (idx h x) (- b 1)))))
          (forall ((k int)) (call at_drop h vis x a b k))
          (call outside_drop vis (mark vis x) x (len vis))
          (call pigeon h (mark vis x) a (- b 1)))
        (call outside_range vis (len vis)))))
  (lemma marks_out (params (n int) (s int) (t int) (u int))
    (requires (and (<= 0 s) (< s n)) (and (<= 0 t) (< t n)) (!= s t) (and (<= 0 u) (< u n)))
    (ensures (== (outside (marks n s t u) n) (- n (if (or (== u s) (== u t)) 2 3))))
    (body
      (call outside_all (blank n) n)
      (call outside_drop (blank n) (marks n s s s) s n)
      (call outside_drop (marks n s s s) (marks n s t t) t n)
      (if (or (== u s) (== u t))
        (assert (== (marks n s t u) (marks n s t t)))
        (call outside_drop (marks n s t t) (marks n s t u) u n))))
  (lemma gap_one (params (cm (seq (seq int))) (f (seq (seq int))) (h (seq int)) (k int) (a int) (b int))
    (requires (under f cm (len h)) (labeled cm f h) (and (<= 0 a) (< a (len h))) (and (<= 0 b) (< b (len h))) (> (idx h a) k) (< (idx h b) k))
    (ensures (== (get_flow f a b) (get_flow cm a b)) (== (get_flow f b a) 0))
    (body (assert (<= (res cm f a b) 0))))
  (lemma gap_cut (params (cm (seq (seq int))) (f (seq (seq int))) (h (seq int)) (k int))
    (requires (under f cm (len h)) (labeled cm f h) (forall ((x int)) (=> (and (<= 0 x) (< x (len h))) (!= (idx h x) k))))
    (ensures (cutok f cm (above h k)))
    (body (forall ((a int) (b int)) (call gap_one cm f h k a b))))
  (lemma row_pos (params (f (seq (seq int))) (cm (seq (seq int))) (sc (seq bool)) (x int))
    (requires (under f cm (len sc)) (cutok f cm sc) (and (<= 0 x) (< x (len sc))))
    (ensures (>= (total (frow (wm f sc) x (len sc))) 0))
    (body (call t_pos (frow (wm f sc) x (len sc)))))
  (lemma drain (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f (seq (seq int))) (e (seq int)) (h (seq int)) (s int) (u int) (k int))
    (requires (in_range g) (distinct g) (capok g cm) (fits f cm (len g)) (exc g f e) (pos e s) (labeled cm f h) (== (len h) (len g))
              (and (<= 0 s) (< s (len g))) (< (idx h s) k) (and (<= 0 u) (< u (len g))) (> (idx h u) k) (> (idx e u) 0)
              (forall ((x int)) (=> (and (<= 0 x) (< x (len g))) (!= (idx h x) k))))
    (ensures false)
    (body
      (call gap_cut cm f h k)
      (call cut_sum g cm f (above h k))
      (forall ((x int)) (call row_pos f cm (above h k) x))
      (call t_pos (rsum (wm f (above h k)) (len g) (len g)))
      (call t_neg (epart g f (above h k)) u)))
  (lemma high (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f (seq (seq int))) (e (seq int)) (h (seq int)) (s int) (t int) (u int))
    (requires (in_range g) (distinct g) (capok g cm) (fits f cm (len g)) (exc g f e) (pos e s) (labeled cm f h) (== (len h) (len g))
              (and (<= 0 s) (< s (len g))) (and (<= 0 t) (< t (len g))) (!= s t) (== (idx h s) (len g)) (== (idx h t) 0)
              (and (<= 0 u) (< u (len g))) (!= u s) (!= u t) (> (idx e u) 0))
    (ensures (< (idx h u) (* 2 (len g))))
    (body
      (if (>= (idx h u) (* 2 (len g)))
        (block
          (call marks_out (len g) s t u)
          (if (covered h (marks (len g) s t u) (+ (len g) 1) (* 2 (len g)))
            (call pigeon h (marks (len g) s t u) (+ (len g) 1) (* 2 (len g)))
            (block
              (obtain ((k int)) (and (and (<= (+ (len g) 1) k) (< k (* 2 (len g)))) (not (at h (marks (len g) s t u) k))))
              (call drain g cm f e h s u k))))
        (block))))
  (lemma final (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f (seq (seq int))) (h (seq int)) (s int) (t int) (o (seq (seq int))))
    (requires (in_range g) (distinct g) (capok g cm) (fits f cm (len g)) (is_conserved g f s t) (labeled cm f h) (== (len h) (len g))
              (and (<= 0 s) (< s (len g))) (and (<= 0 t) (< t (len g))) (!= s t) (== (idx h s) (len g)) (== (idx h t) 0))
    (ensures (=> (is_valid_flow g o s t) (>= (flow_val g f s) (flow_val g o s))))
    (body
      (call marks_out (len g) s t t)
      (if (covered h (marks (len g) s t t) 1 (len g))
        (call pigeon h (marks (len g) s t t) 1 (len g))
        (block
          (obtain ((k int)) (and (and (<= 1 k) (< k (len g))) (not (at h (marks (len g) s t t) k))))
          (call gap_cut cm f h k)
          (call max_one g cm f (above h k) s t o)))))
  (lemma sat (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f0 (seq (seq int))) (f1 (seq (seq int)))
                     (e0 (seq int)) (e1 (seq int)) (e2 (seq int)) (s int) (v int))
    (requires (distinct g) (capok g cm) (exc g f0 e0) (and (<= 0 s) (< s (len g))) (and (<= 0 v) (< v (len g))) (!= v s)
              (bump f0 f1 s v (get_flow cm s v))
              (upd e0 e1 v (+ (idx e0 v) (get_flow cm s v))) (upd e1 e2 s (- (idx e1 s) (get_flow cm s v))))
    (ensures (exc g f1 e2))
    (body
      (forall ((y int)) (call out_chg g f0 f1 s v (get_flow cm s v) y))
      (forall ((y int)) (call in_chg g f0 f1 s v (get_flow cm s v) y (len g)))))
  (lemma init_lab (params (cm (seq (seq int))) (f (seq (seq int))) (h (seq int)) (s int))
    (requires (fits f cm (len h)) (and (<= 0 s) (< s (len h)))
              (forall ((x int)) (=> (and (<= 0 x) (< x (len h))) (== (idx h x) (if (== x s) (len h) 0))))
              (forall ((a int) (b int)) (== (get_flow f a b) (if (and (and (== a s) (!= b s)) (and (<= 0 b) (< b (len h)))) (get_flow cm a b) 0))))
    (ensures (labeled cm f h))
    (body))
  (lemma pushed (params (g (seq (seq (tuple int int)))) (cm (seq (seq int))) (f0 (seq (seq int))) (f1 (seq (seq int))) (f2 (seq (seq int)))
                      (e0 (seq int)) (e1 (seq int)) (e2 (seq int)) (s int) (u int) (v int) (dl int) (c1 int))
    (requires (distinct g) (capok g cm) (fits f0 cm (len g)) (exc g f0 e0) (pos e0 s)
              (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g))) (!= u s) (!= u v)
              (>= dl 1) (<= dl (idx e0 u)) (<= dl (res cm f0 u v))
              (== c1 (if (< (get_flow f0 v u) dl) (get_flow f0 v u) dl))
              (bump f0 f1 v u (- 0 c1)) (bump f1 f2 u v (- dl c1))
              (upd e0 e1 u (- (idx e0 u) dl)) (upd e1 e2 v (+ (idx e1 v) dl)))
    (ensures (fits f2 cm (len g)) (exc g f2 e2) (pos e2 s))
    (body
      (forall ((y int)) (call out_chg g f0 f1 v u (- 0 c1) y))
      (forall ((y int)) (call out_chg g f1 f2 u v (- dl c1) y))
      (forall ((y int)) (call in_chg g f0 f1 v u (- 0 c1) y (len g)))
      (forall ((y int)) (call in_chg g f1 f2 u v (- dl c1) y (len g)))))
  (lemma push_lab (params (cm (seq (seq int))) (f0 (seq (seq int))) (f1 (seq (seq int))) (f2 (seq (seq int))) (h (seq int))
                          (u int) (v int) (dl int) (c1 int))
    (requires (labeled cm f0 h) (and (<= 0 u) (< u (len h))) (and (<= 0 v) (< v (len h))) (== (idx h u) (+ (idx h v) 1))
              (<= c1 dl) (bump f0 f1 v u (- 0 c1)) (bump f1 f2 u v (- dl c1)))
    (ensures (labeled cm f2 h))
    (body (forall ((a int) (b int)) (call lab_one cm f0 f1 f2 h u v dl c1 a b))))
  (lemma lab_one (params (cm (seq (seq int))) (f0 (seq (seq int))) (f1 (seq (seq int))) (f2 (seq (seq int))) (h (seq int))
                         (u int) (v int) (dl int) (c1 int) (a int) (b int))
    (requires (labeled cm f0 h) (and (<= 0 u) (< u (len h))) (and (<= 0 v) (< v (len h))) (== (idx h u) (+ (idx h v) 1))
              (<= c1 dl) (bump f0 f1 v u (- 0 c1)) (bump f1 f2 u v (- dl c1)) (and (<= 0 a) (< a (len h))) (and (<= 0 b) (< b (len h))))
    (ensures (=> (> (res cm f2 a b) 0) (<= (idx h a) (+ (idx h b) 1))))
    (body (assert (== (res cm f2 a b) (+ (res cm f0 a b) (if (and (== a u) (== b v)) (- 0 dl) (if (and (== a v) (== b u)) dl 0)))))))
  (lemma psi_pos (params (e (seq int)) (h (seq int)) (s int))
    (requires (pos e s) (== (len h) (len e)) (forall ((x int)) (=> (and (<= 0 x) (< x (len h))) (>= (idx h x) 0))))
    (ensures (>= (total (pw e h s)) 0))
    (body
      (forall ((x int)) (call rep_pos e h s x))
      (call t_pos (pw e h s))))
  (lemma rep_pos (params (e (seq int)) (h (seq int)) (s int) (x int))
    (requires (pos e s) (== (len h) (len e)) (and (<= 0 x) (< x (len e))) (!= x s) (>= (idx h x) 0))
    (ensures (>= (total (rep (idx e x) (idx h x))) 0))
    (body (call t_pos (rep (idx e x) (idx h x)))))
  (lemma rep_step (params (c int) (k int))
    (requires (>= k 0))
    (ensures (== (total (rep c (+ k 1))) (+ (total (rep c k)) c)))
    (body (assert (== (take (rep c (+ k 1)) k) (rep c k)))))
  (lemma psi_push (params (e0 (seq int)) (e1 (seq int)) (e2 (seq int)) (h (seq int)) (s int) (u int) (v int) (dl int))
    (requires (== (len h) (len e0)) (and (<= 0 u) (< u (len e0))) (and (<= 0 v) (< v (len e0)))
              (upd e0 e1 u (- (idx e0 u) dl)) (upd e1 e2 v (+ (idx e1 v) dl)) (!= u s) (!= u v)
              (== (idx h u) (+ (idx h v) 1)) (>= (idx h v) 0) (>= dl 1))
    (ensures (<= (total (pw e2 h s)) (- (total (pw e0 h s)) 1)))
    (body
      (call t_set (pw e0 h s) (pw e1 h s) u)
      (call t_set (pw e1 h s) (pw e2 h s) v)
      (call t_add (rep (idx e1 u) (idx h u)) (rep dl (idx h u)) (rep (idx e0 u) (idx h u)))
      (call rep_step dl (idx h v))
      (call t_pos (rep dl (idx h v)))
      (if (!= v s) (call t_add (rep (idx e1 v) (idx h v)) (rep dl (idx h v)) (rep (idx e2 v) (idx h v))) (block))))
  (lemma relab (params (cm (seq (seq int))) (f (seq (seq int))) (h0 (seq int)) (h (seq int)) (a int) (m int))
    (requires (labeled cm f h0) (upd h0 h a (+ m 1)) (>= m (idx h0 a))
              (forall ((y int)) (=> (and (and (<= 0 y) (< y (len h0))) (!= y a)) (=> (> (res cm f a y) 0) (<= m (idx h0 y))))))
    (ensures (labeled cm f h))
    (body))
  (lemma stuck_step (params (cm (seq (seq int))) (f (seq (seq int))) (h (seq int)) (e (seq int)) (s int) (t int) (u int) (v int))
    (requires (stuck cm f h e s t u v) (== (len e) (len h)) (and (<= 0 u) (< u (len h))) (and (<= 0 v) (< v (len h)))
              (or (or (or (== u s) (== u t)) (<= (idx e u) 0)) (or (<= (res cm f u v) 0) (!= (idx h u) (+ (idx h v) 1)))))
    (ensures (stuck cm f h e s t u (+ v 1)))
    (body))
  (lemma stuck_row (params (cm (seq (seq int))) (f (seq (seq int))) (h (seq int)) (e (seq int)) (s int) (t int) (u int))
    (requires (stuck cm f h e s t u (len h)))
    (ensures (stuck cm f h e s t (+ u 1) 0))
    (body))
  (lemma hok_keep (params (h0 (seq int)) (h (seq int)) (n int) (s int) (t int) (a int))
    (requires (hok h0 n s t) (and (<= 0 a) (< a (len h))) (upd h0 h a (idx h a)) (!= a s) (!= a t) (and (<= 0 (idx h a)) (< (idx h a) (* 2 n))))
    (ensures (hok h n s t))
    (body))
  (lemma room_drop (params (h0 (seq int)) (h (seq int)) (n int) (a int))
    (requires (and (<= 0 a) (< a (len h))) (upd h0 h a (idx h a)) (> (idx h a) (idx h0 a)) (forall ((y int)) (=> (and (<= 0 y) (< y (len h))) (< (idx h y) (* 2 n)))))
    (ensures (< (total (room h n)) (total (room h0 n))) (>= (total (room h n)) 0))
    (body (call t_set (room h0 n) (room h n) a) (call t_pos (room h n))))
  (spec add_flow
    (params (m (vec (vec i64))) (a i64) (b i64) (d i64))
    (returns (r (vec (vec i64))))
    (requires (and (<= 0 a) (< a (len m))) (and (<= 0 b) (< b (len (idx m a))))
              (and (<= 0 (+ (idx (idx m a) b) d)) (<= (+ (idx (idx m a) b) d) 100000)))
    (ensures (bump m r a b d))
    (effects))
  (def add_flow
    (body
      (let-mut r (vec (vec i64)) m)
      (set-idx (idx r a) b (+ (idx (idx r a) b) d))
      (return r)))
  (def max_flow_value
    (body
      (let n i64 (len (field graph adj)))
      (let-mut capm (vec (vec i64)) (seq-build n (fn (a1) (seq-build n (fn (b1) 0)))))
      (let-mut cu i64 0)
      (while (< cu n)
        (invariant (and (<= 0 cu) (<= cu n)))
        (invariant (capbuilt (view graph) capm cu 0))
        (decreases (- n cu))
        (let cdeg i64 (len (idx (field graph adj) cu)))
        (let-mut ci i64 0)
        (while (< ci cdeg)
          (invariant (and (<= 0 ci) (<= ci cdeg)))
          (invariant (capbuilt (view graph) capm cu ci))
          (decreases (- cdeg ci))
          (let ce (tuple i64 i64) (idx (idx (field graph adj) cu) ci))
          (ghost-let cm0 (seq (seq int)) capm)
          (set-idx (idx capm cu) (get ce 0) (get ce 1))
          (call cap_step (view graph) cm0 capm cu ci)
          (set ci (+ ci 1)))
        (set cu (+ cu 1)))
      (let-mut fm (vec (vec i64)) (seq-build n (fn (a2) (seq-build n (fn (b2) 0)))))
      (let-mut e (vec i64) (seq-build n (fn (a3) 0)))
      (forall ((y2 int)) (call zero_flow (view graph) capm fm y2))
      (let-mut v0 i64 0)
      (while (< v0 n)
        (invariant (and (<= 0 v0) (<= v0 n)))
        (invariant (fits fm capm n))
        (invariant (exc (view graph) fm e))
        (invariant (pos e s))
        (invariant (forall ((a int) (b int))
          (== (get_flow fm a b) (if (and (and (== a s) (!= b s)) (and (<= 0 b) (< b v0))) (get_flow capm a b) 0))))
        (decreases (- n v0))
        (if (!= v0 s)
          (block
            (call ebound (view graph) capm fm e s)
            (call ebound (view graph) capm fm e v0)
            (call cell (view graph) capm fm s v0)
            (let c i64 (idx (idx capm s) v0))
            (ghost-let f0 (seq (seq int)) fm)
            (ghost-let e0 (seq int) e)
            (set-idx (idx fm s) v0 c)
            (set-idx e v0 (+ (idx e v0) c))
            (ghost-let e1 (seq int) e)
            (set-idx e s (- (idx e s) c))
            (call sat (view graph) capm f0 fm e0 e1 e s v0))
          (block))
        (set v0 (+ v0 1)))
      (let-mut h (vec i64) (seq-build n (fn (a4) (if (== a4 s) n 0))))
      (call init_lab capm fm h s)
      (call t_pos (room h n))
      (while true
        (invariant (fits fm capm n))
        (invariant (exc (view graph) fm e))
        (invariant (pos e s))
        (invariant (labeled capm fm h))
        (invariant (hok h n s t))
        (invariant (>= (total (room h n)) 0))
        (decreases (total (room h n)))
        (call psi_pos e h s)
        (let-mut go bool true)
        (while go
          (invariant (fits fm capm n))
          (invariant (exc (view graph) fm e))
          (invariant (pos e s))
          (invariant (labeled capm fm h))
          (invariant (>= (total (pw e h s)) 0))
          (invariant (=> (not go) (stuck capm fm h e s t n 0)))
          (decreases (+ (total (pw e h s)) (if go 1 0)))
          (ghost-let ez (seq int) e)
          (set go false)
          (let-mut u i64 0)
          (while (< u n)
            (invariant (and (<= 0 u) (<= u n)))
            (invariant (fits fm capm n))
            (invariant (exc (view graph) fm e))
            (invariant (pos e s))
            (invariant (labeled capm fm h))
            (invariant (<= (total (pw e h s)) (- (total (pw ez h s)) (if go 1 0))))
            (invariant (=> (not go) (stuck capm fm h e s t u 0)))
            (decreases (- n u))
            (let-mut v i64 0)
            (while (< v n)
              (invariant (and (<= 0 v) (<= v n)))
              (invariant (fits fm capm n))
              (invariant (exc (view graph) fm e))
              (invariant (pos e s))
              (invariant (labeled capm fm h))
              (invariant (<= (total (pw e h s)) (- (total (pw ez h s)) (if go 1 0))))
              (invariant (=> (not go) (stuck capm fm h e s t u v)))
              (decreases (- n v))
              (call cell (view graph) capm fm u v)
              (call cell (view graph) capm fm v u)
              (let r i64 (+ (- (idx (idx capm u) v) (idx (idx fm u) v)) (idx (idx fm v) u)))
              (assert (== r (res capm fm u v)))
              (if (and (and (and (!= u s) (!= u t)) (> (idx e u) 0)) (and (> r 0) (== (idx h u) (+ (idx h v) 1))))
                (block
                  (call ebound (view graph) capm fm e u)
                  (call ebound (view graph) capm fm e v)
                  (let dl i64 (if (< (idx e u) r) (idx e u) r))
                  (let back i64 (idx (idx fm v) u))
                  (let c1 i64 (if (< back dl) back dl))
                  (ghost-let fa (seq (seq int)) fm)
                  (ghost-let ea (seq int) e)
                  (let ((fb (vec (vec i64)))) (call add_flow fm v u (- 0 c1)))
                  (let ((fc (vec (vec i64)))) (call add_flow fb u v (- dl c1)))
                  (set fm fc)
                  (set-idx e u (- (idx e u) dl))
                  (ghost-let eb (seq int) e)
                  (set-idx e v (+ (idx e v) dl))
                  (call pushed (view graph) capm fa fb fm ea eb e s u v dl c1)
                  (call push_lab capm fa fb fm h u v dl c1)
                  (call psi_push ea eb e h s u v dl)
                  (set go true))
                (if (not go) (call stuck_step capm fm h e s t u v) (block)))
              (set v (+ v 1)))
            (if (not go) (call stuck_row capm fm h e s t u) (block))
            (set u (+ u 1)))
          (call psi_pos e h s))
        (let-mut a i64 0)
        (while (and (< a n) (or (or (== a s) (== a t)) (<= (idx e a) 0)))
          (invariant (and (<= 0 a) (<= a n)))
          (invariant (forall ((y int)) (=> (and (and (<= 0 y) (< y a)) (and (!= y s) (!= y t))) (<= (idx e y) 0))))
          (decreases (- n a))
          (set a (+ a 1)))
        (if (== a n)
          (block
            (assert (is_conserved (view graph) fm s t))
            (call capacity_of (view graph) capm fm)
            (forall ((o (seq (seq int)))) (call final (view graph) capm fm h s t o))
            (call ebound (view graph) capm fm e s)
            (assert (== (flow_val (view graph) fm s) (- 0 (idx e s))))
            (assert (is_max_flow (view graph) fm s t))
            (return (- 0 (idx e s))))
          (block))
        (let-mut m i64 (- (* 2 n) 1))
        (let-mut w i64 0)
        (while (< w n)
          (invariant (and (<= 0 w) (<= w n)))
          (invariant (and (<= (idx h a) m) (< m (* 2 n))))
          (invariant (forall ((y int)) (=> (and (and (<= 0 y) (< y w)) (!= y a)) (=> (> (res capm fm a y) 0) (<= m (idx h y))))))
          (decreases (- n w))
          (call cell (view graph) capm fm a w)
          (call cell (view graph) capm fm w a)
          (let r3 i64 (+ (- (idx (idx capm a) w) (idx (idx fm a) w)) (idx (idx fm w) a)))
          (assert (== r3 (res capm fm a w)))
          (if (and (and (!= w a) (> r3 0)) (< (idx h w) m)) (set m (idx h w)) (block))
          (set w (+ w 1)))
        (ghost-let h0 (seq int) h)
        (set-idx h a (+ m 1))
        (call relab capm fm h0 h a m)
        (call high (view graph) capm fm e h s t a)
        (call hok_keep h0 h n s t a)
        (call room_drop h0 h n a))
      (return (- 0 (idx e s))))))
