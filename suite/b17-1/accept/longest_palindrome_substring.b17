(module longest_palindrome_substring
  (header
    (purpose "Find a longest palindromic substring, as its start and length.")
    (invariants "The result is a palindromic substring, and no palindromic substring is longer.")
    (failures "None."))
  (ghost-fn is_palindrome ((t (seq int))) bool
    (body (forall ((i int)) (=> (and (<= 0 i) (< i (len t))) (== (idx t i) (idx t (- (- (len t) 1) i)))))))
  (ghost-fn is_valid_subrange ((s (seq int)) (start int) (n int)) bool
    (body (and (and (<= 0 start) (<= 0 n)) (<= (+ start n) (len s)))))
  (spec longest_palindromic_substring
    (params (s (ref (slice i64))))
    (returns (res (tuple i64 i64)))
    (requires (<= (len s) 1000000))
    (ensures
      (and (>= (get res 0) 0) (>= (get res 1) 0))
      (is_valid_subrange s (get res 0) (get res 1))
      (is_palindrome (take (drop s (get res 0)) (get res 1)))
      (forall ((k int) (m int))
        (=> (and (is_valid_subrange s k m) (is_palindrome (take (drop s k) m))) (<= m (get res 1)))))
    (effects))
  (spec is_pal
    (params (s (ref (slice i64))) (lo i64) (n i64))
    (returns (b bool))
    (requires (is_valid_subrange s lo n))
    (ensures (== b (is_palindrome (take (drop s lo) n))))
    (effects))
  (def is_pal
    (body
      (let-mut j i64 0)
      (while (< j n)
        (invariant (and (<= 0 j) (<= j n)))
        (invariant (forall ((k int)) (=> (and (<= 0 k) (< k j)) (== (idx s (+ lo k)) (idx s (- (- (+ lo n) 1) k))))))
        (decreases (- n j))
        (if (!= (idx s (+ lo j)) (idx s (- (- (+ lo n) 1) j)))
          (block
            (assert (!= (idx (take (drop s lo) n) j) (idx (take (drop s lo) n) (- (- n 1) j))))
            (return false))
          (block))
        (set j (+ j 1)))
      (return true)))
  (def longest_palindromic_substring
    (body
      (let size i64 (len s))
      (let-mut best_start i64 0)
      (let-mut best_len i64 0)
      (let-mut i i64 0)
      (while (< i size)
        (invariant (and (<= 0 i) (<= i size)))
        (invariant (is_valid_subrange s best_start best_len))
        (invariant (is_palindrome (take (drop s best_start) best_len)))
        (invariant (forall ((k int) (m int))
          (=> (and (and (<= 0 k) (< k i)) (and (is_valid_subrange s k m) (is_palindrome (take (drop s k) m)))) (<= m best_len))))
        (decreases (- size i))
        (let-mut n i64 0)
        (while (<= n (- size i))
          (invariant (and (<= 0 n) (<= n (+ (- size i) 1))))
          (invariant (is_valid_subrange s best_start best_len))
          (invariant (is_palindrome (take (drop s best_start) best_len)))
          (invariant (forall ((k int) (m int))
            (=> (and (and (<= 0 k) (< k i)) (and (is_valid_subrange s k m) (is_palindrome (take (drop s k) m)))) (<= m best_len))))
          (invariant (forall ((m int))
            (=> (and (and (<= 0 m) (< m n)) (is_palindrome (take (drop s i) m))) (<= m best_len))))
          (decreases (- (+ (- size i) 1) n))
          (let ((pal bool)) (call is_pal s i n))
          (if (and pal (> n best_len))
            (block (set best_start i) (set best_len n))
            (block))
          (set n (+ n 1)))
        (set i (+ i 1)))
      (return (tuple best_start best_len)))))
