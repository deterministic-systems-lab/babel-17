(module coin_change
  (header
    (purpose "Find the fewest coins that make up an amount, or report that no combination does.")
    (invariants "A result is the coin count of a smallest valid change; -1 means no valid change exists.")
    (failures "Allocation failure aborts."))
  (ghost-fn total_amount ((counts (seq int)) (coins (seq int))) int
    (requires (== (len counts) (len coins)))
    (decreases (len counts))
    (body (if (== (len counts) 0)
            0
            (+ (* (idx counts 0) (idx coins 0)) (total_amount (drop counts 1) (drop coins 1))))))
  (ghost-fn total_coins ((counts (seq int))) int (decreases (len counts))
    (body (if (== (len counts) 0) 0 (+ (idx counts 0) (total_coins (drop counts 1))))))
  (ghost-fn is_valid_change ((counts (seq int)) (coins (seq int)) (amount int)) bool
    (body (and (== (len counts) (len coins))
               (and (forall ((i int)) (=> (and (<= 0 i) (< i (len counts))) (>= (idx counts i) 0)))
                    (== (total_amount counts coins) amount)))))

  (ghost-fn bump ((counts (seq int)) (c int) (d int)) (seq int)
    (body (seq-build (len counts) (fn (j) (if (== j c) (+ (idx counts j) d) (idx counts j))))))
  (ghost-fn pos_coins ((coins (seq int))) bool
    (body (forall ((i int)) (=> (and (<= 0 i) (< i (len coins))) (> (idx coins i) 0)))))
  (ghost-fn no_change ((coins (seq int)) (b int)) bool
    (body (forall ((counts (seq int))) (not (is_valid_change counts coins b)))))
  (ghost-fn least ((coins (seq int)) (b int) (m int)) bool
    (body (forall ((counts (seq int))) (=> (is_valid_change counts coins b) (>= (total_coins counts) m)))))
  (ghost-fn solved ((dp (seq int)) (wc (map int (seq int))) (coins (seq int)) (b int)) bool
    (body (=> (and (<= 0 b) (< b (len dp)))
      (and (=> (== (idx dp b) -1) (no_change coins b))
           (=> (!= (idx dp b) -1)
               (and (contains wc b)
                    (and (and (is_valid_change (lookup wc b) coins b) (== (total_coins (lookup wc b)) (idx dp b)))
                         (least coins b (idx dp b)))))))))
  (ghost-fn dp_ok ((dp (seq int)) (wc (map int (seq int))) (coins (seq int)) (a int)) bool
    (body (forall ((b int)) (=> (and (<= 0 b) (< b a)) (solved dp wc coins b)))))
  (ghost-fn found_a ((dp (seq int)) (wa (seq int)) (coins (seq int)) (a int)) bool
    (body (=> (and (and (<= 0 a) (< a (len dp))) (!= (idx dp a) -1))
      (and (is_valid_change wa coins a) (== (total_coins wa) (idx dp a))))))
  (ghost-fn tried ((dp (seq int)) (coins (seq int)) (a int) (c int)) bool
    (body (forall ((k int))
      (=> (and (and (and (<= 0 k) (< k c)) (< k (len coins))) (and (and (<= 0 a) (< a (len dp))) (and (<= 0 (- a (idx coins k))) (< (- a (idx coins k)) (len dp)))))
          (=> (!= (idx dp (- a (idx coins k))) -1)
              (and (!= (idx dp a) -1) (<= (idx dp a) (+ (idx dp (- a (idx coins k))) 1))))))))
  (ghost-fn upd ((s0 (seq int)) (s1 (seq int)) (v int) (x int)) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))

  (lemma ext_totals (params (c1 (seq int)) (c2 (seq int)) (coins (seq int)))
    (requires (== (len c1) (len coins)) (== c1 c2))
    (ensures (== (total_amount c1 coins) (total_amount c2 coins)) (== (total_coins c1) (total_coins c2)))
    (decreases (len c1))
    (body (if (> (len c1) 0) (call ext_totals (drop c1 1) (drop c2 1) (drop coins 1)) (block))))
  (lemma bump_totals (params (counts (seq int)) (coins (seq int)) (c int) (d int))
    (requires (== (len counts) (len coins)) (and (<= 0 c) (< c (len counts))))
    (ensures (== (len (bump counts c d)) (len counts))
             (== (total_amount (bump counts c d) coins) (+ (total_amount counts coins) (* d (idx coins c))))
             (== (total_coins (bump counts c d)) (+ (total_coins counts) d)))
    (decreases (len counts))
    (body
      (if (== c 0)
        (call ext_totals (drop (bump counts c d) 1) (drop counts 1) (drop coins 1))
        (block
          (call bump_totals (drop counts 1) (drop coins 1) (- c 1) d)
          (call ext_totals (drop (bump counts c d) 1) (bump (drop counts 1) (- c 1) d) (drop coins 1))))))
  (lemma zero_totals (params (counts (seq int)) (coins (seq int)))
    (requires (== (len counts) (len coins)) (forall ((i int)) (=> (and (<= 0 i) (< i (len counts))) (== (idx counts i) 0))))
    (ensures (== (total_amount counts coins) 0) (== (total_coins counts) 0))
    (decreases (len counts))
    (body (if (> (len counts) 0) (call zero_totals (drop counts 1) (drop coins 1)) (block))))
  (lemma totals_nonneg (params (counts (seq int)) (coins (seq int)))
    (requires (and (== (len counts) (len coins)) (forall ((i int)) (=> (and (<= 0 i) (< i (len counts))) (>= (idx counts i) 0)))) (pos_coins coins))
    (ensures (>= (total_amount counts coins) 0) (>= (total_coins counts) 0))
    (decreases (len counts))
    (body (if (> (len counts) 0) (call totals_nonneg (drop counts 1) (drop coins 1)) (block))))
  (lemma some_coin (params (counts (seq int)) (coins (seq int)))
    (requires (and (== (len counts) (len coins)) (forall ((i int)) (=> (and (<= 0 i) (< i (len counts))) (>= (idx counts i) 0)))) (> (total_amount counts coins) 0))
    (ensures (exists ((c int)) (and (and (<= 0 c) (< c (len counts))) (> (idx counts c) 0))))
    (body (if (forall ((i int)) (=> (and (<= 0 i) (< i (len counts))) (== (idx counts i) 0)))
            (call zero_totals counts coins)
            (block))))
  (lemma close_one (params (dp (seq int)) (wc (map int (seq int))) (coins (seq int)) (a int) (counts (seq int)))
    (requires (pos_coins coins) (and (<= 1 a) (< a (len dp))) (dp_ok dp wc coins a) (tried dp coins a (len coins))
              (is_valid_change counts coins a))
    (ensures (and (!= (idx dp a) -1) (>= (total_coins counts) (idx dp a))))
    (body
      (call some_coin counts coins)
      (obtain ((k int)) (and (and (<= 0 k) (< k (len counts))) (> (idx counts k) 0)))
      (call bump_totals counts coins k -1)
      (call totals_nonneg (bump counts k -1) coins)
      (assert (is_valid_change (bump counts k -1) coins (- a (idx coins k))))
      (assert (solved dp wc coins (- a (idx coins k))))))
  (lemma extend_ok (params (dp (seq int)) (wc (map int (seq int))) (coins (seq int)) (a int))
    (requires (dp_ok dp wc coins a) (solved dp wc coins a))
    (ensures (dp_ok dp wc coins (+ a 1)))
    (body))
  (lemma solved_same (params (dp0 (seq int)) (dp (seq int)) (wc (map int (seq int))) (coins (seq int)) (b int))
    (requires (solved dp0 wc coins b) (== (len dp) (len dp0)) (=> (and (<= 0 b) (< b (len dp0))) (== (idx dp b) (idx dp0 b))))
    (ensures (solved dp wc coins b))
    (body))
  (lemma keep_ok_dp (params (dp0 (seq int)) (dp (seq int)) (wc (map int (seq int))) (coins (seq int)) (a int) (x int))
    (requires (dp_ok dp0 wc coins a) (upd dp0 dp a x))
    (ensures (dp_ok dp wc coins a))
    (body (forall ((b int)) (call solved_same dp0 dp wc coins b))))
  (lemma keep_ok_wc (params (dp (seq int)) (wc0 (map int (seq int))) (wc (map int (seq int))) (coins (seq int)) (a int)
                            (w (seq int)))
    (requires (dp_ok dp wc0 coins a) (== wc (update wc0 a w)))
    (ensures (dp_ok dp wc coins a))
    (body))
  (lemma solve_a (params (dp (seq int)) (wc (map int (seq int))) (wa (seq int)) (coins (seq int)) (a int))
    (requires (pos_coins coins) (and (<= 1 a) (< a (len dp))) (dp_ok dp wc coins a) (tried dp coins a (len coins))
              (found_a dp wa coins a))
    (ensures (solved dp (update wc a wa) coins a))
    (body (forall ((counts (seq int))) (call close_one dp wc coins a counts))))
  (lemma tried_set (params (dp0 (seq int)) (dp (seq int)) (coins (seq int)) (a int) (c int))
    (requires (pos_coins coins) (tried dp0 coins a c) (and (<= 0 c) (< c (len coins))) (and (<= 0 a) (< a (len dp0)))
              (<= (idx coins c) a) (>= (idx dp0 (- a (idx coins c))) 0)
              (or (== (idx dp0 a) -1) (< (+ (idx dp0 (- a (idx coins c))) 1) (idx dp0 a)))
              (upd dp0 dp a (+ (idx dp0 (- a (idx coins c))) 1)))
    (ensures (tried dp coins a (+ c 1)))
    (body))
  (lemma tried_keep (params (dp (seq int)) (coins (seq int)) (a int) (c int))
    (requires (pos_coins coins) (tried dp coins a c) (and (<= 0 c) (< c (len coins))) (and (<= 0 a) (< a (len dp)))
              (=> (<= (idx coins c) a)
                  (=> (!= (idx dp (- a (idx coins c))) -1)
                      (and (!= (idx dp a) -1) (<= (idx dp a) (+ (idx dp (- a (idx coins c))) 1))))))
    (ensures (tried dp coins a (+ c 1)))
    (body))
  (spec coin_change
    (params (coins (ref (slice i64))) (amount i64))
    (returns (min_coins i64))
    (requires
      (> (len coins) 0)
      (<= (len coins) 100)
      (<= amount 10000)
      (forall ((i int)) (=> (and (<= 0 i) (< i (len coins))) (> (idx coins i) 0)))
      (forall ((i int)) (=> (and (<= 0 i) (< i (len coins))) (<= (idx coins i) 10000))))
    (ensures
      (=> (!= min_coins -1)
          (and (exists ((counts (seq int))) (and (is_valid_change counts coins amount) (== (total_coins counts) min_coins)))
               (forall ((counts (seq int))) (=> (is_valid_change counts coins amount) (>= (total_coins counts) min_coins)))))
      (=> (== min_coins -1)
          (forall ((counts (seq int))) (=> (is_valid_change counts coins amount) false))))
    (effects alloc))
  (def coin_change
    (body
      (forall ((counts (seq int))) (call totals_nonneg counts coins))
      (if (< amount 0) (return -1) (block))
      (let-mut dp (vec i64) (seq-build (+ amount 1) (fn (j) -1)))
      (set-idx dp 0 0)
      (ghost-let zero (seq int) (seq-build (len coins) (fn (j0) 0)))
      (call zero_totals zero coins)
      (ghost-let-mut wc (map int (seq int)) (map-lit (0 zero)))
      (assert (solved dp wc coins 0))
      (let-mut a i64 1)
      (while (<= a amount)
        (invariant (and (<= 1 a) (<= a (+ amount 1))))
        (invariant (== (len dp) (+ amount 1)))
        (invariant (forall ((b int)) (=> (and (<= 0 b) (<= b amount)) (and (<= -1 (idx dp b)) (<= (idx dp b) b)))))
        (invariant (forall ((b int)) (=> (and (<= a b) (<= b amount)) (== (idx dp b) -1))))
        (invariant (dp_ok dp wc coins a))
        (decreases (- (+ amount 1) a))
        (let-mut c i64 0)
        (ghost-let-mut wa (seq int) zero)
        (while (< c (len coins))
          (invariant (and (<= 0 c) (<= c (len coins))))
          (invariant (== (len dp) (+ amount 1)))
          (invariant (forall ((b int)) (=> (and (<= 0 b) (<= b amount)) (and (<= -1 (idx dp b)) (<= (idx dp b) b)))))
          (invariant (forall ((b int)) (=> (and (< a b) (<= b amount)) (== (idx dp b) -1))))
          (invariant (dp_ok dp wc coins a))
          (invariant (found_a dp wa coins a))
          (invariant (tried dp coins a c))
          (decreases (- (len coins) c))
          (let coin i64 (idx coins c))
          (if (and (<= coin a) (!= (idx dp (- a coin)) -1))
            (if (or (== (idx dp a) -1) (< (+ (idx dp (- a coin)) 1) (idx dp a)))
              (block
                (ghost-let dp0 (seq int) dp)
                (assert (solved dp wc coins (- a coin)))
                (call bump_totals (lookup wc (- a coin)) coins c 1)
                (ghost-set wa (bump (lookup wc (- a coin)) c 1))
                (set-idx dp a (+ (idx dp (- a coin)) 1))
                (assert (upd dp0 dp a (+ (idx dp0 (- a coin)) 1)))
                (call keep_ok_dp dp0 dp wc coins a (+ (idx dp0 (- a coin)) 1))
                (call tried_set dp0 dp coins a c))
              (call tried_keep dp coins a c))
            (call tried_keep dp coins a c))
          (set c (+ c 1)))
        (call solve_a dp wc wa coins a)
        (ghost-let wc0 (map int (seq int)) wc)
        (ghost-set wc (update wc a wa))
        (call keep_ok_wc dp wc0 wc coins a wa)
        (call extend_ok dp wc coins a)
        (set a (+ a 1)))
      (assert (solved dp wc coins amount))
      (return (idx dp amount)))))
