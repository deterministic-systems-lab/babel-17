(module coin_change
  (header
    (purpose "Find the fewest coins that make up an amount, or report that no combination does.")
    (invariants "A result is the coin count of a smallest valid change; -1 means no valid change exists.")
    (failures "Allocation failure aborts."))
  (ghost-fn total_amount ((counts (seq int)) (coins (seq int))) int
    (requires (== (len counts) (len coins)))
    (decreases (len counts))
    (body (if (== (len counts) 0)
            0
            (+ (* (idx counts 0) (idx coins 0)) (total_amount (drop counts 1) (drop coins 1))))))
  (ghost-fn total_coins ((counts (seq int))) int (decreases (len counts))
    (body (if (== (len counts) 0) 0 (+ (idx counts 0) (total_coins (drop counts 1))))))
  (ghost-fn is_valid_change ((counts (seq int)) (coins (seq int)) (amount int)) bool
    (body (and (== (len counts) (len coins))
               (and (forall ((i int)) (=> (and (<= 0 i) (< i (len counts))) (>= (idx counts i) 0)))
                    (== (total_amount counts coins) amount)))))
  (spec coin_change
    (params (coins (ref (slice i64))) (amount i64))
    (returns (min_coins i64))
    (requires
      (> (len coins) 0)
      (<= (len coins) 100)
      (<= amount 10000)
      (forall ((i int)) (=> (and (<= 0 i) (< i (len coins))) (> (idx coins i) 0)))
      (forall ((i int)) (=> (and (<= 0 i) (< i (len coins))) (<= (idx coins i) 10000))))
    (ensures
      (=> (!= min_coins -1)
          (and (exists ((counts (seq int))) (and (is_valid_change counts coins amount) (== (total_coins counts) min_coins)))
               (forall ((counts (seq int))) (=> (is_valid_change counts coins amount) (>= (total_coins counts) min_coins)))))
      (=> (== min_coins -1)
          (forall ((counts (seq int))) (=> (is_valid_change counts coins amount) false))))
    (effects alloc))
  (def coin_change
    (body
      (if (< amount 0) (return -1) (block))
      (let-mut dp (vec i64) (seq-build (+ amount 1) (fn (j) -1)))
      (set-idx dp 0 0)
      (let-mut a i64 1)
      (while (<= a amount)
        (invariant (and (<= 1 a) (<= a (+ amount 1))))
        (invariant (== (len dp) (+ amount 1)))
        (invariant (forall ((b int)) (=> (and (<= 0 b) (<= b amount)) (and (<= -1 (idx dp b)) (<= (idx dp b) b)))))
        (decreases (- (+ amount 1) a))
        (let-mut c i64 0)
        (while (< c (len coins))
          (invariant (and (<= 0 c) (<= c (len coins))))
          (invariant (and (<= 1 a) (<= a amount)))
          (invariant (== (len dp) (+ amount 1)))
          (invariant (forall ((b int)) (=> (and (<= 0 b) (<= b amount)) (and (<= -1 (idx dp b)) (<= (idx dp b) b)))))
          (decreases (- (len coins) c))
          (let coin i64 (idx coins c))
          (if (<= coin a)
            (if (!= (idx dp (- a coin)) -1)
              (if (or (== (idx dp a) -1) (< (+ (idx dp (- a coin)) 1) (idx dp a)))
                (set-idx dp a (+ (idx dp (- a coin)) 1))
                (block))
              (block))
            (block))
          (set c (+ c 1)))
        (set a (+ a 1)))
      (return (idx dp amount)))))
