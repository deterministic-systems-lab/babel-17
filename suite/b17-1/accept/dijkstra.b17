(module dijkstra
  (header
    (purpose "Find the length of a shortest path from one vertex to each vertex of a directed graph with non-negative edge weights, with Dijkstra's algorithm, or report that none exists.")
    (invariants "A distance is the weight of a lightest path; none means the vertex is unreachable.")
    (failures "Allocation failure aborts."))
  (data weighted_graph () (weighted_graph (adj (vec (vec (tuple i64 i64))))))
  (ghost-fn size ((wg weighted_graph)) int
    (body (len (field wg adj))))
  (ghost-fn view ((wg weighted_graph)) (seq (seq (tuple int int)))
    (body (field wg adj)))
  (ghost-fn well_formed ((wg weighted_graph)) bool
    (body (and
      (forall ((u int) (i int))
        (=> (and (and (<= 0 u) (< u (len (field wg adj)))) (and (<= 0 i) (< i (len (idx (field wg adj) u)))))
            (and (<= 0 (get (idx (idx (field wg adj) u) i) 0)) (< (get (idx (idx (field wg adj) u) i) 0) (len (field wg adj))))))
      (forall ((u int) (i int) (j int))
        (=> (and (and (and (<= 0 u) (< u (len (field wg adj)))) (and (<= 0 i) (< i (len (idx (field wg adj) u)))))
                 (and (and (<= 0 j) (< j (len (idx (field wg adj) u)))) (!= i j)))
            (!= (get (idx (idx (field wg adj) u) i) 0) (get (idx (idx (field wg adj) u) j) 0)))))))
  (ghost-fn has_edge ((g (seq (seq (tuple int int)))) (u int) (v int) (w int)) bool
    (body (exists ((i int))
      (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u)))))
           (and (== (get (idx (idx g u) i) 0) v) (== (get (idx (idx g u) i) 1) w))))))
  (ghost-fn connected ((g (seq (seq (tuple int int)))) (u int) (v int)) bool
    (body (exists ((w int)) (has_edge g u v w))))
  (ghost-fn is_path ((g (seq (seq (tuple int int)))) (p (seq int))) bool
    (body (and (> (len p) 0)
               (forall ((i int)) (=> (and (<= 0 i) (< i (- (len p) 1))) (connected g (idx p i) (idx p (+ i 1))))))))
  (ghost-fn weight_from ((row (seq (tuple int int))) (v int) (i int)) int (requires (and (<= 0 i) (<= i (len row))))
    (decreases (- (len row) i))
    (body (if (== i (len row)) 0 (if (== (get (idx row i) 0) v) (get (idx row i) 1) (weight_from row v (+ i 1))))))
  (ghost-fn get_edge_weight ((g (seq (seq (tuple int int)))) (u int) (v int)) int
    (body (if (and (<= 0 u) (< u (len g))) (weight_from (idx g u) v 0) 0)))
  (ghost-fn path_weight ((g (seq (seq (tuple int int)))) (p (seq int))) int (decreases (len p))
    (body (if (< (len p) 2) 0
            (+ (path_weight g (take p (- (len p) 1))) (get_edge_weight g (idx p (- (len p) 2)) (idx p (- (len p) 1)))))))
  (ghost-fn is_shortest_dist ((g (seq (seq (tuple int int)))) (start int) (end int) (d int)) bool
    (body (and
      (exists ((p (seq int)))
        (and (and (is_path g p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) end))) (== (path_weight g p) d)))
      (forall ((p (seq int)))
        (=> (and (is_path g p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) end))) (>= (path_weight g p) d))))))
  (ghost-fn weights_non_negative ((g (seq (seq (tuple int int))))) bool
    (body (forall ((u int) (v int) (w int)) (=> (has_edge g u v w) (>= w 0)))))
  (ghost-fn weights_and_size_bounded ((g (seq (seq (tuple int int))))) bool
    (body (and (<= (len g) 100000)
               (forall ((u int) (v int) (w int)) (=> (has_edge g u v w) (and (>= w -100000) (<= w 100000)))))))
  (spec dijkstra_shortest_paths
    (params (graph weighted_graph) (start i64))
    (returns (res (vec (option i64))))
    (requires (well_formed graph) (and (<= 0 start) (< start (size graph))) (weights_non_negative (view graph))
              (weights_and_size_bounded (view graph)))
    (ensures (== (len res) (size graph))
             (forall ((v int))
               (=> (and (<= 0 v) (< v (size graph)))
                   (match (idx res v)
                     (case (none) (forall ((p (seq int)))
                                    (=> (and (is_path (view graph) p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) v))) false)))
                     (case (some d) (is_shortest_dist (view graph) start v d))))))
    (effects alloc))

  (ghost-fn outside ((vis (seq bool)) (k int)) int (requires (and (<= 0 k) (<= k (len vis)))) (decreases k)
    (body (if (== k 0) 0 (+ (outside vis (- k 1)) (if (idx vis (- k 1)) 0 1)))))
  (ghost-fn in_range ((g (seq (seq (tuple int int))))) bool
    (body (forall ((a int) (i int)) (=> (and (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
      (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len g)))))))
  (ghost-fn distinct ((g (seq (seq (tuple int int))))) bool
    (body (forall ((u int) (i int) (j int))
      (=> (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u))))) (and (and (<= 0 j) (< j (len (idx g u)))) (!= i j)))
          (!= (get (idx (idx g u) i) 0) (get (idx (idx g u) j) 0))))))
  (ghost-fn lower ((g (seq (seq (tuple int int)))) (start int) (v int) (d int)) bool
    (body (forall ((p (seq int)))
      (=> (and (is_path g p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) v))) (>= (path_weight g p) d)))))
  (ghost-fn witnesses ((g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (wit (seq (seq int)))) bool
    (body (forall ((v int))
      (=> (and (and (<= 0 v) (< v (len seen))) (and (and (< v (len dist)) (< v (len wit))) (idx seen v)))
          (and (and (is_path g (idx wit v)) (and (== (idx (idx wit v) 0) start) (== (idx (idx wit v) (- (len (idx wit v)) 1)) v)))
               (== (path_weight g (idx wit v)) (idx dist v)))))))
  (ghost-fn settled ((g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (done (seq bool))) bool
    (body (forall ((v int))
      (=> (and (and (<= 0 v) (< v (len done))) (and (< v (len dist)) (idx done v))) (lower g start v (idx dist v))))))
  (ghost-fn closed ((g (seq (seq (tuple int int)))) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (ex int)) bool
    (body (forall ((x int) (i int))
      (=> (and (and (and (<= 0 x) (< x (len g))) (and (<= 0 i) (< i (len (idx g x)))))
               (and (and (and (< x (len done)) (< x (len dist))) (and (idx done x) (!= x ex)))
                    (and (and (<= 0 (get (idx (idx g x) i) 0)) (< (get (idx (idx g x) i) 0) (len done)))
                         (and (and (< (get (idx (idx g x) i) 0) (len seen)) (< (get (idx (idx g x) i) 0) (len dist)))
                              (not (idx done (get (idx (idx g x) i) 0)))))))
          (and (idx seen (get (idx (idx g x) i) 0))
               (<= (idx dist (get (idx (idx g x) i) 0)) (+ (idx dist x) (get (idx (idx g x) i) 1))))))))
  (ghost-fn partial ((g (seq (seq (tuple int int)))) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (u int) (du int) (k int)) bool
    (body (forall ((i int))
      (=> (and (and (and (<= 0 u) (< u (len g))) (and (and (<= 0 i) (< i k)) (< i (len (idx g u)))))
               (and (and (<= 0 (get (idx (idx g u) i) 0)) (< (get (idx (idx g u) i) 0) (len done)))
                    (and (and (< (get (idx (idx g u) i) 0) (len seen)) (< (get (idx (idx g u) i) 0) (len dist)))
                         (not (idx done (get (idx (idx g u) i) 0))))))
          (and (idx seen (get (idx (idx g u) i) 0))
               (<= (idx dist (get (idx (idx g u) i) 0)) (+ du (get (idx (idx g u) i) 1))))))))
  (ghost-fn sub ((done (seq bool)) (seen (seq bool))) bool
    (body (forall ((v int)) (=> (and (and (<= 0 v) (< v (len done))) (and (< v (len seen)) (idx done v))) (idx seen v)))))
  (ghost-fn bounded ((dist (seq int)) (seen (seq bool)) (b int)) bool
    (body (forall ((v int)) (=> (and (and (<= 0 v) (< v (len seen))) (and (< v (len dist)) (idx seen v)))
      (and (<= 0 (idx dist v)) (<= (idx dist v) b))))))
  (ghost-fn least ((done (seq bool)) (seen (seq bool)) (dist (seq int)) (d int) (k int)) bool
    (body (forall ((j int))
      (=> (and (and (<= 0 j) (< j k)) (and (and (< j (len done)) (< j (len seen))) (and (< j (len dist)) (and (not (idx done j)) (idx seen j)))))
          (<= d (idx dist j))))))
  (ghost-fn none_open ((done (seq bool)) (seen (seq bool)) (k int)) bool
    (body (forall ((j int)) (=> (and (and (<= 0 j) (< j k)) (and (< j (len done)) (< j (len seen)))) (or (idx done j) (not (idx seen j)))))))
  (ghost-fn upd ((s0 (seq int)) (s1 (seq int)) (v int) (x int)) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))
  (ghost-fn updb ((s0 (seq bool)) (s1 (seq bool)) (v int) (x bool)) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))
  (ghost-fn updw ((s0 (seq (seq int))) (s1 (seq (seq int))) (v int) (x (seq int))) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))

  (lemma outside_all (params (vis (seq bool)) (k int))
    (requires (and (<= 0 k) (<= k (len vis))) (forall ((j int)) (=> (and (<= 0 j) (< j (len vis))) (not (idx vis j)))))
    (ensures (== (outside vis k) k))
    (decreases k)
    (body (if (> k 0) (call outside_all vis (- k 1)) (block))))
  (lemma outside_range (params (vis (seq bool)) (k int))
    (requires (and (<= 0 k) (<= k (len vis))))
    (ensures (and (>= (outside vis k) 0) (<= (outside vis k) k)))
    (decreases k)
    (body (if (> k 0) (call outside_range vis (- k 1)) (block))))
  (lemma outside_drop (params (vis0 (seq bool)) (vis (seq bool)) (y int) (k int))
    (requires (updb vis0 vis y true) (not (idx vis0 y)) (and (<= 0 k) (<= k (len vis0))))
    (ensures (== (outside vis k) (- (outside vis0 k) (if (< y k) 1 0))))
    (decreases k)
    (body (if (> k 0) (call outside_drop vis0 vis y (- k 1)) (block))))
  (lemma entry_w (params (g (seq (seq (tuple int int)))) (a int) (i int))
    (requires (weights_non_negative g) (weights_and_size_bounded g) (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
    (ensures (and (<= 0 (get (idx (idx g a) i) 1)) (<= (get (idx (idx g a) i) 1) 100000)))
    (body (assert (has_edge g a (get (idx (idx g a) i) 0) (get (idx (idx g a) i) 1)))))
  (lemma entry_nn (params (g (seq (seq (tuple int int)))) (a int) (i int))
    (requires (weights_non_negative g) (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
    (ensures (>= (get (idx (idx g a) i) 1) 0))
    (body (assert (has_edge g a (get (idx (idx g a) i) 0) (get (idx (idx g a) i) 1)))))
  (lemma wf_nonneg (params (row (seq (tuple int int))) (v int) (i int))
    (requires (and (<= 0 i) (<= i (len row))) (forall ((j int)) (=> (and (<= 0 j) (< j (len row))) (>= (get (idx row j) 1) 0))))
    (ensures (>= (weight_from row v i) 0))
    (decreases (- (len row) i))
    (body (if (< i (len row)) (call wf_nonneg row v (+ i 1)) (block))))
  (lemma gew_nonneg (params (g (seq (seq (tuple int int)))) (a int) (b int))
    (requires (weights_non_negative g))
    (ensures (>= (get_edge_weight g a b) 0))
    (body
      (if (and (<= 0 a) (< a (len g)))
        (block
          (forall ((j int)) (call entry_nn g a j))
          (call wf_nonneg (idx g a) b 0))
        (block))))
  (lemma wf_entry (params (row (seq (tuple int int))) (v int) (i int) (j int))
    (requires (and (<= 0 j) (<= j i)) (< i (len row)) (== (get (idx row i) 0) v)
              (forall ((a int) (b int)) (=> (and (and (and (<= 0 a) (< a (len row))) (and (<= 0 b) (< b (len row)))) (!= a b))
                (!= (get (idx row a) 0) (get (idx row b) 0)))))
    (ensures (== (weight_from row v j) (get (idx row i) 1)))
    (decreases (- i j))
    (body (if (< j i) (call wf_entry row v i (+ j 1)) (block))))
  (lemma gew_entry (params (g (seq (seq (tuple int int)))) (a int) (i int))
    (requires (distinct g) (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
    (ensures (== (get_edge_weight g a (get (idx (idx g a) i) 0)) (get (idx (idx g a) i) 1)))
    (body (call wf_entry (idx g a) (get (idx (idx g a) i) 0) i 0)))
  (lemma pw_eq (params (g (seq (seq (tuple int int)))) (s (seq int)) (t (seq int)))
    (requires (== (len s) (len t)) (forall ((k int)) (=> (and (<= 0 k) (< k (len s))) (== (idx s k) (idx t k)))))
    (ensures (== (path_weight g s) (path_weight g t)))
    (decreases (len s))
    (body (if (>= (len s) 2) (call pw_eq g (take s (- (len s) 1)) (take t (- (len t) 1))) (block))))
  (lemma pw_nonneg (params (g (seq (seq (tuple int int)))) (p (seq int)))
    (requires (weights_non_negative g))
    (ensures (>= (path_weight g p) 0))
    (decreases (len p))
    (body
      (if (>= (len p) 2)
        (block (call pw_nonneg g (take p (- (len p) 1))) (call gew_nonneg g (idx p (- (len p) 2)) (idx p (- (len p) 1))))
        (block))))
  (lemma pw_mono (params (g (seq (seq (tuple int int)))) (p (seq int)) (k int))
    (requires (weights_non_negative g) (and (<= 1 k) (<= k (len p))))
    (ensures (<= (path_weight g (take p k)) (path_weight g p)))
    (decreases (len p))
    (body
      (if (== k (len p))
        (call pw_eq g (take p k) p)
        (block
          (call pw_mono g (take p (- (len p) 1)) k)
          (call gew_nonneg g (idx p (- (len p) 2)) (idx p (- (len p) 1)))))))
  (lemma pw_append (params (g (seq (seq (tuple int int)))) (p (seq int)) (v int))
    (requires (> (len p) 0))
    (ensures (== (path_weight g (concat p (seq-lit v))) (+ (path_weight g p) (get_edge_weight g (idx p (- (len p) 1)) v))))
    (body (call pw_eq g (take (concat p (seq-lit v)) (len p)) p)))
  (lemma cross (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (u int) (p (seq int)) (m int))
    (requires (in_range g) (distinct g) (weights_non_negative g)
              (== (len dist) (len g)) (== (len seen) (len g)) (== (len done) (len g))
              (and (<= 0 start) (< start (len g))) (idx seen start) (== (idx dist start) 0)
              (settled g start dist done) (closed g dist seen done -1)
              (and (<= 0 u) (< u (len g))) (least done seen dist (idx dist u) (len g))
              (is_path g p) (== (idx p 0) start) (== (idx p (- (len p) 1)) u)
              (and (<= 0 m) (< m (len p))) (forall ((i int)) (=> (and (<= 0 i) (< i m)) (idx done (idx p i))))
              (not (idx done (idx p m))))
    (ensures (>= (path_weight g p) (idx dist u)))
    (body
      (if (== m 0)
        (call pw_nonneg g p)
        (block
          (assert (connected g (idx p (- m 1)) (idx p m)))
          (obtain ((w int)) (has_edge g (idx p (- m 1)) (idx p m) w))
          (obtain ((i int)) (and (and (<= 0 i) (< i (len (idx g (idx p (- m 1))))))
                                 (and (== (get (idx (idx g (idx p (- m 1))) i) 0) (idx p m)) (== (get (idx (idx g (idx p (- m 1))) i) 1) w))))
          (call gew_entry g (idx p (- m 1)) i)
          (call pw_mono g p (+ m 1))))))
  (lemma walk (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (u int) (p (seq int)) (m int))
    (requires (in_range g) (distinct g) (weights_non_negative g)
              (== (len dist) (len g)) (== (len seen) (len g)) (== (len done) (len g))
              (and (<= 0 start) (< start (len g))) (idx seen start) (== (idx dist start) 0)
              (settled g start dist done) (closed g dist seen done -1)
              (and (<= 0 u) (< u (len g))) (least done seen dist (idx dist u) (len g)) (not (idx done u))
              (is_path g p) (== (idx p 0) start) (== (idx p (- (len p) 1)) u)
              (and (<= 0 m) (< m (len p))) (forall ((i int)) (=> (and (<= 0 i) (< i m)) (idx done (idx p i)))))
    (ensures (>= (path_weight g p) (idx dist u)))
    (decreases (- (len p) m))
    (body
      (if (idx done (idx p m))
        (call walk g start dist seen done u p (+ m 1))
        (call cross g start dist seen done u p m))))
  (lemma extract (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (u int) (p (seq int)))
    (requires (in_range g) (distinct g) (weights_non_negative g)
              (== (len dist) (len g)) (== (len seen) (len g)) (== (len done) (len g))
              (and (<= 0 start) (< start (len g))) (idx seen start) (== (idx dist start) 0)
              (settled g start dist done) (closed g dist seen done -1)
              (and (<= 0 u) (< u (len g))) (least done seen dist (idx dist u) (len g)) (not (idx done u))
              (is_path g p) (== (idx p 0) start) (== (idx p (- (len p) 1)) u))
    (ensures (>= (path_weight g p) (idx dist u)))
    (body
      (call walk g start dist seen done u p 0)))
  (lemma least_new (params (done (seq bool)) (seen (seq bool)) (dist (seq int)) (d0 int) (found bool) (k int))
    (requires (and (<= 0 k) (< k (len done))) (== (len seen) (len done)) (== (len dist) (len done))
              (=> found (least done seen dist d0 k)) (=> (not found) (none_open done seen k))
              (not (idx done k)) (idx seen k) (=> found (< (idx dist k) d0)))
    (ensures (least done seen dist (idx dist k) (+ k 1)))
    (body))
  (lemma least_keep (params (done (seq bool)) (seen (seq bool)) (dist (seq int)) (d int) (k int))
    (requires (and (<= 0 k) (< k (len done))) (== (len seen) (len done)) (== (len dist) (len done))
              (least done seen dist d k) (or (or (idx done k) (not (idx seen k))) (<= d (idx dist k))))
    (ensures (least done seen dist d (+ k 1)))
    (body))
  (lemma none_keep (params (done (seq bool)) (seen (seq bool)) (k int))
    (requires (and (<= 0 k) (< k (len done))) (== (len seen) (len done))
              (none_open done seen k) (or (idx done k) (not (idx seen k))))
    (ensures (none_open done seen (+ k 1)))
    (body))
  (lemma relax (params (g (seq (seq (tuple int int)))) (start int) (dist0 (seq int)) (seen0 (seq bool)) (wit0 (seq (seq int)))
                       (dist (seq int)) (seen (seq bool)) (wit (seq (seq int))) (done (seq bool)) (u int) (du int) (i int) (v int) (w int) (b int))
    (requires (in_range g) (distinct g)
              (== (len dist0) (len g)) (== (len seen0) (len g)) (== (len done) (len g)) (== (len wit0) (len g))
              (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u))))
              (== v (get (idx (idx g u) i) 0)) (== w (get (idx (idx g u) i) 1))
              (idx done u) (idx seen0 u) (== (idx dist0 u) du)
              (and (<= 0 start) (< start (len g))) (and (idx seen0 start) (== (idx dist0 start) 0))
              (sub done seen0) (witnesses g start dist0 seen0 wit0) (settled g start dist0 done)
              (closed g dist0 seen0 done u) (partial g dist0 seen0 done u du i) (bounded dist0 seen0 b)
              (>= du 0) (>= w 0) (<= (+ du w) b)
              (not (idx done v)) (or (not (idx seen0 v)) (< (+ du w) (idx dist0 v)))
              (upd dist0 dist v (+ du w)) (updb seen0 seen v true) (updw wit0 wit v (concat (idx wit0 u) (seq-lit v))))
    (ensures (and (idx seen start) (== (idx dist start) 0)) (sub done seen) (witnesses g start dist seen wit)
             (settled g start dist done) (closed g dist seen done u) (partial g dist seen done u du (+ i 1))
             (bounded dist seen b) (and (idx seen u) (== (idx dist u) du)))
    (body
      (call gew_entry g u i)
      (call pw_append g (idx wit0 u) v)
      (assert (has_edge g u v w))
      (assert (connected g u v))))
  (lemma skip (params (g (seq (seq (tuple int int)))) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (u int) (du int) (i int))
    (requires (in_range g) (== (len dist) (len g)) (== (len seen) (len g)) (== (len done) (len g))
              (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u)))) (partial g dist seen done u du i)
              (or (idx done (get (idx (idx g u) i) 0))
                  (and (idx seen (get (idx (idx g u) i) 0)) (<= (idx dist (get (idx (idx g u) i) 0)) (+ du (get (idx (idx g u) i) 1))))))
    (ensures (partial g dist seen done u du (+ i 1)))
    (body))
  (lemma close_u (params (g (seq (seq (tuple int int)))) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (u int) (du int))
    (requires (and (<= 0 u) (< u (len g))) (== (len dist) (len g)) (== (len done) (len g))
              (closed g dist seen done u) (partial g dist seen done u du (len (idx g u))) (== (idx dist u) du))
    (ensures (closed g dist seen done -1))
    (body))
  (lemma all_done (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (p (seq int)) (m int))
    (requires (in_range g) (== (len dist) (len g)) (== (len seen) (len g)) (== (len done) (len g))
              (and (<= 0 start) (< start (len g))) (idx seen start)
              (closed g dist seen done -1) (none_open done seen (len g))
              (is_path g p) (== (idx p 0) start)
              (forall ((i int)) (=> (and (<= 0 i) (< i (len p))) (and (<= 0 (idx p i)) (< (idx p i) (len g)))))
              (and (<= 0 m) (< m (len p))))
    (ensures (idx done (idx p m)))
    (decreases m)
    (body
      (if (> m 0)
        (block
          (call all_done g start dist seen done p (- m 1))
          (obtain ((w int)) (has_edge g (idx p (- m 1)) (idx p m) w))
          (obtain ((e int)) (and (and (<= 0 e) (< e (len (idx g (idx p (- m 1)))))) (== (get (idx (idx g (idx p (- m 1))) e) 0) (idx p m)))))
        (block))))
  (lemma unreached (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (v int) (p (seq int)))
    (requires (in_range g) (== (len dist) (len g)) (== (len seen) (len g)) (== (len done) (len g))
              (and (<= 0 start) (< start (len g))) (idx seen start) (sub done seen)
              (closed g dist seen done -1) (none_open done seen (len g))
              (and (<= 0 v) (< v (len g))) (not (idx seen v))
              (is_path g p) (== (idx p 0) start) (== (idx p (- (len p) 1)) v))
    (ensures false)
    (body
      (call all_done g start dist seen done p (- (len p) 1))))
  (lemma answer (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (done (seq bool)) (wit (seq (seq int))) (v int))
    (requires (in_range g) (== (len dist) (len g)) (== (len seen) (len g)) (== (len done) (len g)) (== (len wit) (len g))
              (and (<= 0 start) (< start (len g))) (idx seen start) (sub done seen)
              (witnesses g start dist seen wit) (settled g start dist done)
              (closed g dist seen done -1) (none_open done seen (len g)) (and (<= 0 v) (< v (len g))))
    (ensures (=> (idx seen v) (is_shortest_dist g start v (idx dist v)))
             (=> (not (idx seen v))
                 (forall ((p (seq int))) (=> (and (is_path g p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) v))) false))))
    (body
      (if (idx seen v)
        (block
          (assert (is_path g (idx wit v))))
        (forall ((p (seq int))) (call unreached g start dist seen done v p)))))
  (def dijkstra_shortest_paths
    (body
      (let n i64 (len (field graph adj)))
      (let-mut dist (vec i64) (seq-build n (fn (j) 0)))
      (let-mut seen (vec bool) (seq-build n (fn (j) (== j start))))
      (let-mut done (vec bool) (seq-build n (fn (j) false)))
      (ghost-let-mut wit (seq (seq int)) (seq-build n (fn (j) (seq-lit start))))
      (call outside_all done n)
      (let-mut go bool true)
      (while go
        (invariant (and (and (== (len dist) n) (== (len seen) n)) (and (== (len done) n) (== (len wit) n))))
        (invariant (and (idx seen start) (== (idx dist start) 0)))
        (invariant (sub done seen))
        (invariant (witnesses (view graph) start dist seen wit))
        (invariant (settled (view graph) start dist done))
        (invariant (closed (view graph) dist seen done -1))
        (invariant (and (>= (outside done n) 0) (<= (outside done n) n)))
        (invariant (bounded dist seen (* (- n (outside done n)) 100000)))
        (invariant (=> (not go) (none_open done seen n)))
        (decreases (+ (* 2 (outside done n)) (if go 1 0)))
        (let-mut found bool false)
        (let-mut u i64 0)
        (let-mut k i64 0)
        (while (< k n)
          (invariant (and (<= 0 k) (<= k n)))
          (invariant (and (<= 0 u) (< u n)))
          (invariant (=> found (and (not (idx done u)) (idx seen u))))
          (invariant (=> found (least done seen dist (idx dist u) k)))
          (invariant (=> (not found) (none_open done seen k)))
          (decreases (- n k))
          (if (and (and (not (idx done k)) (idx seen k)) (or (not found) (< (idx dist k) (idx dist u))))
            (block (call least_new done seen dist (idx dist u) found k) (set u k) (set found true))
            (if found (call least_keep done seen dist (idx dist u) k) (call none_keep done seen k)))
          (set k (+ k 1)))
        (if found
          (block
            (forall ((p (seq int))) (call extract (view graph) start dist seen done u p))
            (let du i64 (idx dist u))
            (ghost-let done0 (seq bool) done)
            (set-idx done u true)
            (call outside_drop done0 done u n)
            (call outside_range done n)
            (let deg i64 (len (idx (field graph adj) u)))
            (let-mut i i64 0)
            (while (< i deg)
              (invariant (and (<= 0 i) (<= i deg)))
              (invariant (and (and (== (len dist) n) (== (len seen) n)) (== (len wit) n)))
              (invariant (and (idx seen start) (== (idx dist start) 0)))
              (invariant (sub done seen))
              (invariant (witnesses (view graph) start dist seen wit))
              (invariant (settled (view graph) start dist done))
              (invariant (closed (view graph) dist seen done u))
              (invariant (partial (view graph) dist seen done u du i))
              (invariant (bounded dist seen (* (- n (outside done n)) 100000)))
              (invariant (and (idx seen u) (== (idx dist u) du)))
              (decreases (- deg i))
              (let e (tuple i64 i64) (idx (idx (field graph adj) u) i))
              (let v i64 (get e 0))
              (call entry_w (view graph) u i)
              (if (and (not (idx done v)) (or (not (idx seen v)) (< (+ du (get e 1)) (idx dist v))))
                (block
                  (ghost-let dist0 (seq int) dist)
                  (ghost-let seen0 (seq bool) seen)
                  (ghost-let wit0 (seq (seq int)) wit)
                  (ghost-set wit (seq-build n (fn (j) (if (== j v) (concat (idx wit u) (seq-lit v)) (idx wit j)))))
                  (set-idx dist v (+ du (get e 1)))
                  (set-idx seen v true)
                  (call relax (view graph) start dist0 seen0 wit0 dist seen wit done u du i v (get e 1) (* (- n (outside done n)) 100000)))
                (call skip (view graph) dist seen done u du i))
              (set i (+ i 1)))
            (call close_u (view graph) dist seen done u du))
          (set go false)))
      (forall ((v int)) (call answer (view graph) start dist seen done wit v))
      (return (seq-build n (fn (v) (if (idx seen v) (some (idx dist v)) (none))))))))
