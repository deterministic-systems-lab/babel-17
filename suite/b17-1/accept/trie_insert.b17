(module trie_insert
  (header
    (purpose "Insert a byte string into a trie whose nodes have 256 optional children.")
    (invariants "The result is a pruned, well-formed trie holding the old keys and the new one.")
    (failures "Allocation failure aborts."))
  (data node () (node (is_end bool) (children (vec (option node)))))
  (ghost-fn is_empty ((n node)) bool (requires (== (len (field n children)) 256))
    (body (and (not (field n is_end))
               (forall ((i int)) (=> (and (<= 0 i) (< i 256)) (is none (idx (field n children) i)))))))
  (ghost-fn well_formed ((n node)) bool (decreases (rank n))
    (body (and (== (len (field n children)) 256)
               (forall ((i int)) (=> (and (<= 0 i) (< i 256))
                 (match (idx (field n children) i)
                   (case (none) true)
                   (case (some c) (and (well_formed c) (and (== (len (field c children)) 256) (not (is_empty c)))))))))))
  (ghost-fn has_key ((n node) (key (seq int))) bool (decreases (len key))
    (body (if (== (len key) 0)
            (field n is_end)
            (if (and (<= 0 (idx key 0)) (< (idx key 0) (len (field n children))))
              (match (idx (field n children) (idx key 0))
                (case (none) false)
                (case (some c) (has_key c (drop key 1))))
              false))))
  (ghost-fn view ((n node)) (iset (seq int))
    (body (iset-of ((key (seq int))) (has_key n key))))
  (ghost-fn opt_view ((o (option node))) (iset (seq int))
    (body (match o
      (case (none) (iset-lit))
      (case (some n) (view n)))))
  (ghost-fn opt_well_formed ((o (option node))) bool
    (body (match o
      (case (none) true)
      (case (some n) (and (well_formed n) (not (is_empty n)))))))
  (lemma wf_body (params (before node) (after node) (k int) (s node))
    (requires
      (well_formed before) (well_formed s) (== (len (field s children)) 256) (not (is_empty s))
      (and (<= 0 k) (< k 256))
      (== (len (field after children)) 256)
      (== (idx (field after children) k) (some s))
      (forall ((j int)) (=> (and (and (<= 0 j) (< j 256)) (!= j k))
        (== (idx (field after children) j) (idx (field before children) j)))))
    (ensures (forall ((i int)) (=> (and (<= 0 i) (< i 256))
        (match (idx (field after children) i)
          (case (none) true)
          (case (some c) (and (well_formed c) (and (== (len (field c children)) 256) (not (is_empty c)))))))))
    (body))
  (lemma wf_from_body (params (after node))
    (requires (== (len (field after children)) 256) (forall ((i int)) (=> (and (<= 0 i) (< i 256))
        (match (idx (field after children) i)
          (case (none) true)
          (case (some c) (and (well_formed c) (and (== (len (field c children)) 256) (not (is_empty c)))))))))
    (ensures (well_formed after))
    (body))
  (lemma view_at (params (before node) (after node) (k int) (sub node) (key (seq int)) (i int) (y (seq int)))
    (requires
      (== (len (field before children)) 256)
      (== (len (field after children)) 256)
      (== (field after is_end) (field before is_end))
      (and (<= 0 k) (< k 256))
      (== (idx (field after children) k) (some sub))
      (forall ((j int)) (=> (and (and (<= 0 j) (< j 256)) (!= j k))
        (== (idx (field after children) j) (idx (field before children) j))))
      (and (<= 0 i) (< i (len key)))
      (== (idx key i) k)
      (forall ((z (seq int))) (== (contains (view sub) z)
        (contains (union (opt_view (idx (field before children) k)) (iset-lit (drop key (+ i 1)))) z))))
    (ensures (== (contains (view after) y) (or (contains (view before) y) (== y (drop key i)))))
    (body
      (if (and (> (len y) 0) (== (idx y 0) k))
        (block
          (assert (== (contains (view sub) (drop y 1))
                      (contains (union (opt_view (idx (field before children) k)) (iset-lit (drop key (+ i 1)))) (drop y 1))))
          (assert (forall ((j int)) (=> (and (<= 1 j) (< j (len y))) (== (idx y j) (idx (drop y 1) (- j 1))))))
          (assert (forall ((j int)) (=> (and (<= 1 j) (< j (- (len key) i)))
            (== (idx (drop key i) j) (idx (drop key (+ i 1)) (- j 1))))))
          (assert (== (== y (drop key i)) (== (drop y 1) (drop key (+ i 1))))))
        (block))))
  (spec insert
    (params (tree (option node)) (key (ref (slice i64))))
    (returns (res node))
    (requires
      (opt_well_formed tree)
      (forall ((k int)) (=> (contains key k) (and (<= 0 k) (< k 256)))))
    (ensures (well_formed res) (not (is_empty res)) (== (view res) (union (opt_view tree) (iset-lit key))))
    (effects alloc))
  (spec node_of
    (params (tree (option node)))
    (returns (n node))
    (requires (opt_well_formed tree))
    (ensures (well_formed n) (== (view n) (opt_view tree)))
    (effects alloc))
  (def node_of
    (body
      (match tree
        (case (none) (block (let kids (vec (option node)) (seq-build 256 (fn (i) (none)))) (return (node false kids))))
        (case (some m) (return m)))))
  (spec insert_at
    (params (tree (option node)) (key (ref (slice i64))) (i i64))
    (returns (res node))
    (requires
      (opt_well_formed tree)
      (forall ((k int)) (=> (contains key k) (and (<= 0 k) (< k 256))))
      (and (<= 0 i) (<= i (len key))))
    (ensures (well_formed res) (not (is_empty res)) (== (view res) (union (opt_view tree) (iset-lit (drop key i)))))
    (effects alloc))
  (def insert_at (decreases (- (len key) i))
    (body
      (let-mut ((n node)) (call node_of tree))
      (if (== i (len key))
        (block
          (let kids (vec (option node)) (replace (field n children) (vec-new)))
          (return (node true kids)))
        (block
          (let c i64 (idx key i))
          (assert (contains key c))
          (ghost-let before node n)
          (assert (forall ((y (seq int))) (== (contains (view before) y) (contains (opt_view tree) y))))
          (let child (option node) (replace (idx (field n children) c) (none)))
          (let ((sub node)) (call insert_at child key (+ i 1)))
          (assert (forall ((y (seq int))) (== (contains (view sub) y) (contains (union (opt_view child) (iset-lit (drop key (+ i 1)))) y))))
          (set-idx (field n children) c (some sub))
          (call wf_body before n c sub)
          (call wf_from_body n)
          (forall ((y (seq int))) (call view_at before n c sub key i y))
          (return n)))))
  (def insert
    (body
      (assert (== (drop key 0) key))
      (let ((res node)) (call insert_at tree key 0))
      (return res))))
