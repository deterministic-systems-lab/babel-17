(module kruskal
  (header
    (purpose "Find a minimum spanning tree of a connected, undirected weighted graph.")
    (invariants "The result is a spanning tree of the graph, and no spanning tree weighs less.")
    (failures "Allocation failure aborts."))
  (data weighted_graph () (weighted_graph (adj (vec (vec (tuple i64 i64))))))
  (ghost-fn size ((wg weighted_graph)) int
    (body (len (field wg adj))))
  (ghost-fn view ((wg weighted_graph)) (seq (seq (tuple int int)))
    (body (field wg adj)))
  (ghost-fn well_formed ((wg weighted_graph)) bool
    (body (and
      (forall ((u int) (i int))
        (=> (and (and (<= 0 u) (< u (len (field wg adj)))) (and (<= 0 i) (< i (len (idx (field wg adj) u)))))
            (and (<= 0 (get (idx (idx (field wg adj) u) i) 0)) (< (get (idx (idx (field wg adj) u) i) 0) (len (field wg adj))))))
      (forall ((u int) (i int) (j int))
        (=> (and (and (and (<= 0 u) (< u (len (field wg adj)))) (and (<= 0 i) (< i (len (idx (field wg adj) u)))))
                 (and (and (<= 0 j) (< j (len (idx (field wg adj) u)))) (!= i j)))
            (!= (get (idx (idx (field wg adj) u) i) 0) (get (idx (idx (field wg adj) u) j) 0)))))))
  (ghost-fn has_edge ((g (seq (seq (tuple int int)))) (u int) (v int) (w int)) bool
    (body (exists ((i int))
      (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u)))))
           (and (== (get (idx (idx g u) i) 0) v) (== (get (idx (idx g u) i) 1) w))))))
  (ghost-fn are_valid_edges ((g (seq (seq (tuple int int)))) (edges (seq (tuple int int int)))) bool
    (body (forall ((k int))
      (=> (and (<= 0 k) (< k (len edges)))
          (has_edge g (get (idx edges k) 0) (get (idx edges k) 1) (get (idx edges k) 2))))))
  (ghost-fn edge_in_set ((edges (seq (tuple int int int))) (u int) (v int)) bool
    (body (exists ((e int))
      (and (and (<= 0 e) (< e (len edges)))
           (or (and (== (get (idx edges e) 0) u) (== (get (idx edges e) 1) v))
               (and (== (get (idx edges e) 0) v) (== (get (idx edges e) 1) u)))))))
  (ghost-fn path_follows_edges ((edges (seq (tuple int int int))) (p (seq int))) bool
    (body (forall ((k int))
      (=> (and (<= 0 k) (< k (- (len p) 1))) (edge_in_set edges (idx p k) (idx p (+ k 1)))))))
  (ghost-fn edges_connected ((edges (seq (tuple int int int))) (u int) (v int)) bool
    (body (exists ((p (seq int)))
      (and (and (> (len p) 0) (and (== (idx p 0) u) (== (idx p (- (len p) 1)) v))) (path_follows_edges edges p)))))
  (ghost-fn is_spanning ((g (seq (seq (tuple int int)))) (edges (seq (tuple int int int)))) bool
    (body (forall ((u int) (v int))
      (=> (and (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g)))) (edges_connected edges u v)))))
  (ghost-fn is_spanning_tree ((g (seq (seq (tuple int int)))) (edges (seq (tuple int int int)))) bool
    (body (and (and (are_valid_edges g edges) (is_spanning g edges)) (== (len edges) (- (len g) 1)))))
  (ghost-fn total_weight ((edges (seq (tuple int int int)))) int (decreases (len edges))
    (body (if (== (len edges) 0) 0 (+ (get (idx edges 0) 2) (total_weight (drop edges 1))))))
  (ghost-fn is_mst ((g (seq (seq (tuple int int)))) (edges (seq (tuple int int int)))) bool
    (body (and (is_spanning_tree g edges)
               (forall ((other (seq (tuple int int int))))
                 (=> (is_spanning_tree g other) (<= (total_weight edges) (total_weight other)))))))
  (ghost-fn graph_has_any_edge ((g (seq (seq (tuple int int)))) (u int) (v int)) bool
    (body (exists ((i int))
      (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u))))) (== (get (idx (idx g u) i) 0) v)))))
  (ghost-fn path_follows_graph ((g (seq (seq (tuple int int)))) (p (seq int))) bool
    (body (forall ((k int))
      (=> (and (<= 0 k) (< k (- (len p) 1))) (graph_has_any_edge g (idx p k) (idx p (+ k 1)))))))
  (ghost-fn nodes_have_path ((g (seq (seq (tuple int int)))) (u int) (v int)) bool
    (body (exists ((p (seq int)))
      (and (and (> (len p) 0) (and (== (idx p 0) u) (== (idx p (- (len p) 1)) v))) (path_follows_graph g p)))))
  (ghost-fn graph_is_connected ((g (seq (seq (tuple int int))))) bool
    (body (forall ((u int) (v int))
      (=> (and (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g)))) (nodes_have_path g u v)))))
  (ghost-fn weights_bounded ((g (seq (seq (tuple int int))))) bool
    (body (and (<= (len g) 100000)
               (forall ((u int) (v int) (w int)) (=> (has_edge g u v w) (and (>= w -100000) (<= w 100000)))))))
  (spec kruskal_mst
    (params (graph weighted_graph))
    (returns (edges (vec (tuple i64 i64 i64))))
    (requires (well_formed graph) (> (size graph) 0) (weights_bounded (view graph)) (graph_is_connected (view graph)))
    (ensures (is_mst (view graph) edges))
    (effects alloc))
  (ghost-fn ends_below ((es (seq (tuple int int int))) (n int)) bool
    (body (forall ((k int))
      (=> (and (<= 0 k) (< k (len es)))
          (and (and (<= 0 (get (idx es k) 0)) (< (get (idx es k) 0) n))
               (and (<= 0 (get (idx es k) 1)) (< (get (idx es k) 1) n)))))))
  (def kruskal_mst
    (body
      (let n i64 (len (field graph adj)))
      (let-mut cands (vec (tuple i64 i64 i64)) (vec-new))
      (let-mut u i64 0)
      (while (< u n)
        (invariant (and (<= 0 u) (<= u n)))
        (invariant (ends_below cands n))
        (decreases (- n u))
        (let deg i64 (len (idx (field graph adj) u)))
        (let-mut i i64 0)
        (while (< i deg)
          (invariant (and (<= 0 i) (<= i deg)))
          (invariant (ends_below cands n))
          (decreases (- deg i))
          (let e (tuple i64 i64) (idx (idx (field graph adj) u) i))
          (if (< u (get e 0))
            (push cands (tuple u (get e 0) (get e 1)))
            (block))
          (set i (+ i 1)))
        (set u (+ u 1)))
      (let-mut s i64 0)
      (while (< s (len cands))
        (invariant (and (<= 0 s) (<= s (len cands))))
        (invariant (ends_below cands n))
        (decreases (- (len cands) s))
        (let-mut t i64 s)
        (while (and (> t 0) (> (get (idx cands (- t 1)) 2) (get (idx cands t) 2)))
          (invariant (and (<= 0 t) (<= t s)))
          (invariant (< s (len cands)))
          (invariant (ends_below cands n))
          (decreases t)
          (let prev (tuple i64 i64 i64) (idx cands (- t 1)))
          (set-idx cands (- t 1) (idx cands t))
          (set-idx cands t prev)
          (set t (- t 1)))
        (set s (+ s 1)))
      (let-mut comp (vec i64) (seq-build n (fn (j) j)))
      (let-mut tree (vec (tuple i64 i64 i64)) (vec-new))
      (let-mut x i64 0)
      (while (< x (len cands))
        (invariant (and (<= 0 x) (<= x (len cands))))
        (invariant (ends_below cands n))
        (invariant (== (len comp) n))
        (invariant (forall ((j int)) (=> (and (<= 0 j) (< j n)) (and (<= 0 (idx comp j)) (< (idx comp j) n)))))
        (decreases (- (len cands) x))
        (let edge (tuple i64 i64 i64) (idx cands x))
        (let cu i64 (idx comp (get edge 0)))
        (let cv i64 (idx comp (get edge 1)))
        (if (!= cu cv)
          (block
            (push tree edge)
            (let-mut y i64 0)
            (while (< y n)
              (invariant (and (<= 0 y) (<= y n)))
              (invariant (== (len comp) n))
              (invariant (forall ((j int)) (=> (and (<= 0 j) (< j n)) (and (<= 0 (idx comp j)) (< (idx comp j) n)))))
              (decreases (- n y))
              (if (== (idx comp y) cv) (set-idx comp y cu) (block))
              (set y (+ y 1))))
          (block))
        (set x (+ x 1)))
      (return tree))))
