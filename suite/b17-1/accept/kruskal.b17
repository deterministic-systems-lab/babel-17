(module kruskal
  (header
    (purpose "Find a minimum spanning tree of a connected, undirected weighted graph.")
    (invariants "The result is a spanning tree of the graph, and no spanning tree weighs less.")
    (failures "Allocation failure aborts."))
  (data weighted_graph () (weighted_graph (adj (vec (vec (tuple i64 i64))))))
  (ghost-fn size ((wg weighted_graph)) int
    (body (len (field wg adj))))
  (ghost-fn view ((wg weighted_graph)) (seq (seq (tuple int int)))
    (body (field wg adj)))
  (ghost-fn well_formed ((wg weighted_graph)) bool
    (body (and
      (forall ((u int) (i int))
        (=> (and (and (<= 0 u) (< u (len (field wg adj)))) (and (<= 0 i) (< i (len (idx (field wg adj) u)))))
            (and (<= 0 (get (idx (idx (field wg adj) u) i) 0)) (< (get (idx (idx (field wg adj) u) i) 0) (len (field wg adj))))))
      (forall ((u int) (i int) (j int))
        (=> (and (and (and (<= 0 u) (< u (len (field wg adj)))) (and (<= 0 i) (< i (len (idx (field wg adj) u)))))
                 (and (and (<= 0 j) (< j (len (idx (field wg adj) u)))) (!= i j)))
            (!= (get (idx (idx (field wg adj) u) i) 0) (get (idx (idx (field wg adj) u) j) 0)))))))
  (ghost-fn has_edge ((g (seq (seq (tuple int int)))) (u int) (v int) (w int)) bool
    (body (exists ((i int))
      (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u)))))
           (and (== (get (idx (idx g u) i) 0) v) (== (get (idx (idx g u) i) 1) w))))))
  (ghost-fn are_valid_edges ((g (seq (seq (tuple int int)))) (edges (seq (tuple int int int)))) bool
    (body (forall ((k int))
      (=> (and (<= 0 k) (< k (len edges)))
          (has_edge g (get (idx edges k) 0) (get (idx edges k) 1) (get (idx edges k) 2))))))
  (ghost-fn edge_in_set ((edges (seq (tuple int int int))) (u int) (v int)) bool
    (body (exists ((e int))
      (and (and (<= 0 e) (< e (len edges)))
           (or (and (== (get (idx edges e) 0) u) (== (get (idx edges e) 1) v))
               (and (== (get (idx edges e) 0) v) (== (get (idx edges e) 1) u)))))))
  (ghost-fn path_follows_edges ((edges (seq (tuple int int int))) (p (seq int))) bool
    (body (forall ((k int))
      (=> (and (<= 0 k) (< k (- (len p) 1))) (edge_in_set edges (idx p k) (idx p (+ k 1)))))))
  (ghost-fn edges_connected ((edges (seq (tuple int int int))) (u int) (v int)) bool
    (body (exists ((p (seq int)))
      (and (and (> (len p) 0) (and (== (idx p 0) u) (== (idx p (- (len p) 1)) v))) (path_follows_edges edges p)))))
  (ghost-fn is_spanning ((g (seq (seq (tuple int int)))) (edges (seq (tuple int int int)))) bool
    (body (forall ((u int) (v int))
      (=> (and (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g)))) (edges_connected edges u v)))))
  (ghost-fn is_spanning_tree ((g (seq (seq (tuple int int)))) (edges (seq (tuple int int int)))) bool
    (body (and (and (are_valid_edges g edges) (is_spanning g edges)) (== (len edges) (- (len g) 1)))))
  (ghost-fn total_weight ((edges (seq (tuple int int int)))) int (decreases (len edges))
    (body (if (== (len edges) 0) 0 (+ (get (idx edges 0) 2) (total_weight (drop edges 1))))))
  (ghost-fn is_mst ((g (seq (seq (tuple int int)))) (edges (seq (tuple int int int)))) bool
    (body (and (is_spanning_tree g edges)
               (forall ((other (seq (tuple int int int))))
                 (=> (is_spanning_tree g other) (<= (total_weight edges) (total_weight other)))))))
  (ghost-fn graph_has_any_edge ((g (seq (seq (tuple int int)))) (u int) (v int)) bool
    (body (exists ((i int))
      (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u))))) (== (get (idx (idx g u) i) 0) v)))))
  (ghost-fn path_follows_graph ((g (seq (seq (tuple int int)))) (p (seq int))) bool
    (body (forall ((k int))
      (=> (and (<= 0 k) (< k (- (len p) 1))) (graph_has_any_edge g (idx p k) (idx p (+ k 1)))))))
  (ghost-fn nodes_have_path ((g (seq (seq (tuple int int)))) (u int) (v int)) bool
    (body (exists ((p (seq int)))
      (and (and (> (len p) 0) (and (== (idx p 0) u) (== (idx p (- (len p) 1)) v))) (path_follows_graph g p)))))
  (ghost-fn graph_is_connected ((g (seq (seq (tuple int int))))) bool
    (body (forall ((u int) (v int))
      (=> (and (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g)))) (nodes_have_path g u v)))))
  (ghost-fn weights_bounded ((g (seq (seq (tuple int int))))) bool
    (body (and (<= (len g) 100000)
               (forall ((u int) (v int) (w int)) (=> (has_edge g u v w) (and (>= w -100000) (<= w 100000)))))))
  (spec kruskal_mst
    (params (graph weighted_graph))
    (returns (edges (vec (tuple i64 i64 i64))))
    (requires (well_formed graph) (> (size graph) 0) (weights_bounded (view graph)) (graph_is_connected (view graph)))
    (ensures (is_mst (view graph) edges))
    (effects alloc))

  (ghost-fn roots ((comp (seq int)) (k int)) int (requires (and (<= 0 k) (<= k (len comp)))) (decreases k)
    (body (if (== k 0) 0 (+ (roots comp (- k 1)) (if (== (idx comp (- k 1)) (- k 1)) 1 0)))))
  (ghost-fn labels ((comp (seq int)) (n int)) bool
    (body (and (== (len comp) n)
      (forall ((j int)) (=> (and (<= 0 j) (< j n))
        (and (and (<= 0 (idx comp j)) (< (idx comp j) n)) (== (idx comp (idx comp j)) (idx comp j))))))))
  (ghost-fn joined ((tree (seq (tuple int int int))) (comp (seq int)) (n int)) bool
    (body (forall ((x int) (y int))
      (=> (and (and (and (<= 0 x) (< x n)) (and (<= 0 y) (< y n))) (and (< x (len comp)) (< y (len comp))))
          (=> (== (idx comp x) (idx comp y)) (edges_connected tree x y))))))
  (ghost-fn settled ((g (seq (seq (tuple int int)))) (comp (seq int)) (u int)) bool
    (body (forall ((a int) (i int)) (=> (and (< a u) (and (and (<= 0 a) (< a (len g))) (and (and (<= 0 i) (< i (len (idx g a)))) (and (< a (len comp)) (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len comp)))))))
      (== (idx comp a) (idx comp (get (idx (idx g a) i) 0)))))))
  (ghost-fn settled_row ((g (seq (seq (tuple int int)))) (comp (seq int)) (a int) (k int)) bool
    (body (forall ((i int)) (=> (and (< i k) (and (and (<= 0 a) (< a (len g))) (and (and (<= 0 i) (< i (len (idx g a)))) (and (< a (len comp)) (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len comp)))))))
      (== (idx comp a) (idx comp (get (idx (idx g a) i) 0)))))))
  (ghost-fn crossing ((g (seq (seq (tuple int int)))) (comp (seq int)) (e (tuple int int int))) bool
    (body (and (has_edge g (get e 0) (get e 1) (get e 2))
               (and (and (and (<= 0 (get e 0)) (< (get e 0) (len comp))) (and (<= 0 (get e 1)) (< (get e 1) (len comp))))
                    (!= (idx comp (get e 0)) (idx comp (get e 1)))))))
  (ghost-fn relabelled ((comp0 (seq int)) (comp (seq int)) (cv int) (cu int) (y int)) bool
    (body (and (== (len comp) (len comp0))
      (forall ((j int)) (=> (and (<= 0 j) (< j (len comp0)))
        (== (idx comp j) (if (< j y) (if (== (idx comp0 j) cv) cu (idx comp0 j)) (idx comp0 j))))))))
  (ghost-fn root_change ((comp0 (seq int)) (comp (seq int)) (cv int)) bool
    (body (and (== (len comp) (len comp0))
      (forall ((j int)) (=> (and (<= 0 j) (< j (len comp0)))
        (== (== (idx comp j) j) (and (== (idx comp0 j) j) (!= j cv))))))))
  (ghost-fn extends ((t0 (seq (tuple int int int))) (t1 (seq (tuple int int int)))) bool
    (body (and (<= (len t0) (len t1)) (forall ((k int)) (=> (and (<= 0 k) (< k (len t0))) (== (idx t1 k) (idx t0 k)))))))

  (ghost-fn in_range ((g (seq (seq (tuple int int))))) bool
    (body (forall ((a int) (i int)) (=> (and (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
      (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len g)))))))
  (ghost-fn internal ((tree (seq (tuple int int int))) (comp (seq int))) bool
    (body (forall ((k int)) (=> (and (<= 0 k) (< k (len tree)))
      (and (and (and (<= 0 (get (idx tree k) 0)) (< (get (idx tree k) 0) (len comp)))
                (and (<= 0 (get (idx tree k) 1)) (< (get (idx tree k) 1) (len comp))))
           (== (idx comp (get (idx tree k) 0)) (idx comp (get (idx tree k) 1))))))))
  (ghost-fn lightest ((g (seq (seq (tuple int int)))) (comp (seq int)) (w int) (u int)) bool
    (body (forall ((a int) (i int)) (=> (and (< a u) (and (and (<= 0 a) (< a (len g))) (and (and (<= 0 i) (< i (len (idx g a)))) (and (< a (len comp)) (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len comp)))))))
      (or (== (idx comp a) (idx comp (get (idx (idx g a) i) 0))) (<= w (get (idx (idx g a) i) 1)))))))
  (ghost-fn lightest_row ((g (seq (seq (tuple int int)))) (comp (seq int)) (w int) (a int) (k int)) bool
    (body (forall ((i int)) (=> (and (< i k) (and (and (<= 0 a) (< a (len g))) (and (and (<= 0 i) (< i (len (idx g a)))) (and (< a (len comp)) (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len comp)))))))
      (or (== (idx comp a) (idx comp (get (idx (idx g a) i) 0))) (<= w (get (idx (idx g a) i) 1)))))))
  (ghost-fn better ((g (seq (seq (tuple int int)))) (tree (seq (tuple int int int))) (o (seq (tuple int int int)))) bool
    (body (exists ((t (seq (tuple int int int)))) (and (and (is_spanning_tree g t) (extends tree t)) (<= (total_weight t) (total_weight o))))))
  (ghost-fn good ((g (seq (seq (tuple int int)))) (tree (seq (tuple int int int)))) bool
    (body (forall ((o (seq (tuple int int int)))) (=> (is_spanning_tree g o) (better g tree o)))))
  (ghost-fn covers ((t (seq (tuple int int int))) (t2 (seq (tuple int int int)))) bool
    (body (forall ((x int)) (=> (and (<= 0 x) (< x (len t))) (edges_connected t2 (get (idx t x) 0) (get (idx t x) 1))))))
  (ghost-fn swapped ((t (seq (tuple int int int))) (t2 (seq (tuple int int int))) (j int) (l int) (e (tuple int int int))) bool
    (body (and (and (<= 0 l) (< l (len t))) (and (== (len t2) (len t))
      (forall ((k int)) (=> (and (<= 0 k) (< k (len t)))
        (== (idx t2 k) (if (== k l) e (if (== k j) (idx t l) (idx t k))))))))))

  (lemma label_of (params (comp (seq int)) (n int) (j int))
    (requires (labels comp n) (and (<= 0 j) (< j n)))
    (ensures (== (len comp) n) (and (<= 0 (idx comp j)) (< (idx comp j) n)) (== (idx comp (idx comp j)) (idx comp j)))
    (body))
  (lemma cross_of (params (g (seq (seq (tuple int int)))) (comp (seq int)) (e (tuple int int int)))
    (requires (crossing g comp e))
    (ensures (has_edge g (get e 0) (get e 1) (get e 2))
             (and (and (<= 0 (get e 0)) (< (get e 0) (len comp))) (and (<= 0 (get e 1)) (< (get e 1) (len comp))))
             (!= (idx comp (get e 0)) (idx comp (get e 1))))
    (body))
  (lemma roots_id (params (comp (seq int)) (k int))
    (requires (and (<= 0 k) (<= k (len comp))) (forall ((j int)) (=> (and (<= 0 j) (< j (len comp))) (== (idx comp j) j))))
    (ensures (== (roots comp k) k))
    (decreases k)
    (body (if (> k 0) (call roots_id comp (- k 1)) (block))))
  (lemma roots_nonneg (params (comp (seq int)) (k int))
    (requires (and (<= 0 k) (<= k (len comp))))
    (ensures (>= (roots comp k) 0))
    (decreases k)
    (body (if (> k 0) (call roots_nonneg comp (- k 1)) (block))))
  (lemma roots_drop (params (comp0 (seq int)) (comp (seq int)) (cv int) (k int))
    (requires (root_change comp0 comp cv) (and (<= 0 cv) (< cv (len comp0))) (== (idx comp0 cv) cv)
              (and (<= 0 k) (<= k (len comp0))))
    (ensures (== (roots comp k) (- (roots comp0 k) (if (< cv k) 1 0))))
    (decreases k)
    (body (if (> k 0) (call roots_drop comp0 comp cv (- k 1)) (block))))
  (lemma roots_one (params (comp (seq int)) (c int) (k int))
    (requires (and (<= 0 c) (< c (len comp))) (forall ((j int)) (=> (and (<= 0 j) (< j (len comp))) (== (idx comp j) c)))
              (and (<= 0 k) (<= k (len comp))))
    (ensures (== (roots comp k) (if (< c k) 1 0)))
    (decreases k)
    (body (if (> k 0) (call roots_one comp c (- k 1)) (block))))
  (lemma conn_self (params (t (seq (tuple int int int))) (x int))
    (ensures (edges_connected t x x))
    (body (assert (path_follows_edges t (seq-lit x)))))
  (lemma conn_extend (params (t0 (seq (tuple int int int))) (t1 (seq (tuple int int int))) (x int) (y int))
    (requires (extends t0 t1) (edges_connected t0 x y))
    (ensures (edges_connected t1 x y))
    (body
      (obtain ((p (seq int))) (and (and (and (> (len p) 0) (== (idx p 0) x)) (== (idx p (- (len p) 1)) y)) (path_follows_edges t0 p)))
      (assert (path_follows_edges t1 p))))
  (lemma conn_sym (params (t (seq (tuple int int int))) (x int) (y int))
    (requires (edges_connected t x y))
    (ensures (edges_connected t y x))
    (body
      (obtain ((p (seq int))) (and (and (and (> (len p) 0) (== (idx p 0) x)) (== (idx p (- (len p) 1)) y)) (path_follows_edges t p)))
      (ghost-let r (seq int) (seq-build (len p) (fn (j) (idx p (- (- (len p) 1) j)))))
      (assert (path_follows_edges t r))))
  (lemma conn_join (params (t (seq (tuple int int int))) (x int) (b int) (a int) (y int))
    (requires (edges_connected t x b) (edge_in_set t b a) (edges_connected t a y))
    (ensures (edges_connected t x y))
    (body
      (obtain ((p1 (seq int))) (and (and (and (> (len p1) 0) (== (idx p1 0) x)) (== (idx p1 (- (len p1) 1)) b)) (path_follows_edges t p1)))
      (obtain ((p2 (seq int))) (and (and (and (> (len p2) 0) (== (idx p2 0) a)) (== (idx p2 (- (len p2) 1)) y)) (path_follows_edges t p2)))
      (assert (path_follows_edges t (concat p1 p2)))))
  (lemma joined_pair (params (t0 (seq (tuple int int int))) (t1 (seq (tuple int int int))) (comp0 (seq int)) (comp (seq int)) (n int) (a int) (b int) (cu int) (cv int)
                             (x int) (y int))
    (requires (joined t0 comp0 n) (labels comp0 n) (extends t0 t1)
              (and (and (<= 0 a) (< a n)) (and (<= 0 b) (< b n)))
              (edge_in_set t1 a b) (== (idx comp0 a) cu) (== (idx comp0 b) cv) (!= cu cv)
              (relabelled comp0 comp cv cu n)
              (and (and (<= 0 x) (< x n)) (and (<= 0 y) (< y n))) (== (idx comp x) (idx comp y)))
    (ensures (edges_connected t1 x y))
    (body
      (if (== (idx comp0 x) (idx comp0 y))
        (call conn_extend t0 t1 x y)
        (if (== (idx comp0 x) cv)
          (block
            (call conn_extend t0 t1 x b)
            (call conn_extend t0 t1 a y)
            (assert (edge_in_set t1 b a))
            (call conn_join t1 x b a y))
          (block
            (call conn_extend t0 t1 x a)
            (call conn_extend t0 t1 b y)
            (call conn_join t1 x a b y))))))
  (lemma labels_merge (params (comp0 (seq int)) (comp (seq int)) (n int) (cu int) (cv int))
    (requires (labels comp0 n) (and (and (<= 0 cu) (< cu n)) (and (<= 0 cv) (< cv n))) (== (idx comp0 cu) cu)
              (== (idx comp0 cv) cv) (!= cu cv) (relabelled comp0 comp cv cu n))
    (ensures (labels comp n) (root_change comp0 comp cv))
    (body))
  (lemma path_comp (params (g (seq (seq (tuple int int)))) (comp (seq int)) (p (seq int)) (k int))
    (requires (settled g comp (len g)) (== (len comp) (len g))
              (forall ((a int) (i int)) (=> (and (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
                (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len g)))))
              (path_follows_graph g p) (> (len p) 0) (and (<= 0 (idx p 0)) (< (idx p 0) (len g)))
              (and (<= 0 k) (< k (len p))))
    (ensures (and (and (<= 0 (idx p k)) (< (idx p k) (len g))) (== (idx comp (idx p k)) (idx comp (idx p 0)))))
    (decreases k)
    (body
      (if (> k 0)
        (block
          (call path_comp g comp p (- k 1))
          (assert (graph_has_any_edge g (idx p (- k 1)) (idx p k)))
          (obtain ((e int)) (and (and (<= 0 e) (< e (len (idx g (idx p (- k 1)))))) (== (get (idx (idx g (idx p (- k 1))) e) 0) (idx p k)))))
        (block))))
  (lemma one_comp (params (g (seq (seq (tuple int int)))) (comp (seq int)) (v int))
    (requires (settled g comp (len g)) (== (len comp) (len g)) (> (len g) 0)
              (forall ((a int) (i int)) (=> (and (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
                (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len g)))))
              (graph_is_connected g) (and (<= 0 v) (< v (len g))))
    (ensures (== (idx comp v) (idx comp 0)))
    (body
      (assert (nodes_have_path g 0 v))
      (obtain ((p (seq int))) (and (and (and (> (len p) 0) (== (idx p 0) 0)) (== (idx p (- (len p) 1)) v)) (path_follows_graph g p)))
      (call path_comp g comp p (- (len p) 1))))
  (lemma edge_ends (params (g (seq (seq (tuple int int)))) (u int) (v int) (w int))
    (requires (in_range g) (has_edge g u v w))
    (ensures (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g))))
    (body (obtain ((i int)) (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u)))))
                                 (and (== (get (idx (idx g u) i) 0) v) (== (get (idx (idx g u) i) 1) w))))))
  (lemma step_ends (params (g (seq (seq (tuple int int)))) (t (seq (tuple int int int))) (p (seq int)) (i int))
    (requires (in_range g) (are_valid_edges g t) (path_follows_edges t p) (and (<= 0 i) (< i (- (len p) 1))))
    (ensures (and (<= 0 (idx p i)) (< (idx p i) (len g))) (and (<= 0 (idx p (+ i 1))) (< (idx p (+ i 1)) (len g))))
    (body
      (assert (edge_in_set t (idx p i) (idx p (+ i 1))))
      (obtain ((k int)) (and (and (<= 0 k) (< k (len t))) (or (and (== (get (idx t k) 0) (idx p i)) (== (get (idx t k) 1) (idx p (+ i 1)))) (and (== (get (idx t k) 0) (idx p (+ i 1))) (== (get (idx t k) 1) (idx p i))))))
      (call edge_ends g (get (idx t k) 0) (get (idx t k) 1) (get (idx t k) 2))))
  (lemma conn_trans (params (t (seq (tuple int int int))) (x int) (y int) (z int))
    (requires (edges_connected t x y) (edges_connected t y z))
    (ensures (edges_connected t x z))
    (body
      (obtain ((p1 (seq int))) (and (and (and (> (len p1) 0) (== (idx p1 0) x)) (== (idx p1 (- (len p1) 1)) y)) (path_follows_edges t p1)))
      (obtain ((p2 (seq int))) (and (and (and (> (len p2) 0) (== (idx p2 0) y)) (== (idx p2 (- (len p2) 1)) z)) (path_follows_edges t p2)))
      (ghost-let r (seq int) (seq-build (- (+ (len p1) (len p2)) 1) (fn (i) (if (< i (len p1)) (idx p1 i) (idx p2 (+ (- i (len p1)) 1))))))
      (assert (path_follows_edges t r))))
  (lemma transfer (params (t (seq (tuple int int int))) (t2 (seq (tuple int int int))) (p (seq int)) (k int))
    (requires (covers t t2) (path_follows_edges t p) (> (len p) 0) (and (<= 0 k) (< k (len p))))
    (ensures (edges_connected t2 (idx p 0) (idx p k)))
    (decreases k)
    (body
      (if (== k 0)
        (call conn_self t2 (idx p 0))
        (block
          (call transfer t t2 p (- k 1))
          (assert (edge_in_set t (idx p (- k 1)) (idx p k)))
          (obtain ((e int)) (and (and (<= 0 e) (< e (len t))) (or (and (== (get (idx t e) 0) (idx p (- k 1))) (== (get (idx t e) 1) (idx p k))) (and (== (get (idx t e) 0) (idx p k)) (== (get (idx t e) 1) (idx p (- k 1)))))))
          (assert (edges_connected t2 (get (idx t e) 0) (get (idx t e) 1)))
          (if (== (get (idx t e) 0) (idx p (- k 1))) (block) (call conn_sym t2 (get (idx t e) 0) (get (idx t e) 1)))
          (call conn_trans t2 (idx p 0) (idx p (- k 1)) (idx p k))))))
  (lemma span_pair (params (g (seq (seq (tuple int int)))) (t (seq (tuple int int int))) (t2 (seq (tuple int int int))) (u int) (v int))
    (requires (is_spanning g t) (covers t t2) (and (and (<= 0 u) (< u (len g))) (and (<= 0 v) (< v (len g)))))
    (ensures (edges_connected t2 u v))
    (body
      (assert (edges_connected t u v))
      (obtain ((p (seq int))) (and (and (and (> (len p) 0) (== (idx p 0) u)) (== (idx p (- (len p) 1)) v)) (path_follows_edges t p)))
      (call transfer t t2 p (- (len p) 1))))
  (lemma tw_eq (params (s (seq (tuple int int int))) (t (seq (tuple int int int))))
    (requires (== (len s) (len t)) (forall ((k int)) (=> (and (<= 0 k) (< k (len s))) (== (idx s k) (idx t k)))))
    (ensures (== (total_weight s) (total_weight t)))
    (decreases (len s))
    (body (if (> (len s) 0) (call tw_eq (drop s 1) (drop t 1)) (block))))
  (lemma tw_point (params (s (seq (tuple int int int))) (t (seq (tuple int int int))) (j int))
    (requires (== (len s) (len t)) (and (<= 0 j) (< j (len s)))
              (forall ((k int)) (=> (and (and (<= 0 k) (< k (len s))) (!= k j)) (== (idx s k) (idx t k)))))
    (ensures (== (total_weight t) (+ (- (total_weight s) (get (idx s j) 2)) (get (idx t j) 2))))
    (decreases j)
    (body (if (== j 0) (call tw_eq (drop s 1) (drop t 1)) (call tw_point (drop s 1) (drop t 1) (- j 1)))))
  (lemma kept (params (t (seq (tuple int int int))) (t2 (seq (tuple int int int))) (j int) (l int) (e (tuple int int int)) (x int))
    (requires (swapped t t2 j l e) (and (<= 0 j) (< j (len t))) (and (<= 0 x) (< x (len t))) (!= x j))
    (ensures (edge_in_set t2 (get (idx t x) 0) (get (idx t x) 1)) (edges_connected t2 (get (idx t x) 0) (get (idx t x) 1)))
    (body
      (assert (== (idx t2 (if (== x l) j x)) (idx t x)))
      (assert (path_follows_edges t2 (seq-lit (get (idx t x) 0) (get (idx t x) 1))))))
  (lemma internal_merge (params (tree0 (seq (tuple int int int))) (tree (seq (tuple int int int))) (comp0 (seq int)) (comp (seq int)) (n int) (cu int) (cv int))
    (requires (internal tree0 comp0) (extends tree0 tree) (== (len tree) (+ (len tree0) 1)) (== (len comp0) n)
              (relabelled comp0 comp cv cu n)
              (and (and (<= 0 (get (idx tree (len tree0)) 0)) (< (get (idx tree (len tree0)) 0) n))
                   (and (<= 0 (get (idx tree (len tree0)) 1)) (< (get (idx tree (len tree0)) 1) n)))
              (== (idx comp0 (get (idx tree (len tree0)) 0)) cu) (== (idx comp0 (get (idx tree (len tree0)) 1)) cv))
    (ensures (internal tree comp))
    (body))
  (lemma good_nil (params (g (seq (seq (tuple int int)))) (tree (seq (tuple int int int))) (o (seq (tuple int int int))))
    (requires (== (len tree) 0) (is_spanning_tree g o))
    (ensures (better g tree o))
    (body (assert (extends tree o))))
  (lemma good_end (params (g (seq (seq (tuple int int)))) (tree (seq (tuple int int int))) (o (seq (tuple int int int))))
    (requires (good g tree) (is_spanning_tree g tree) (is_spanning_tree g o))
    (ensures (<= (total_weight tree) (total_weight o)))
    (body
      (assert (better g tree o))
      (obtain ((t (seq (tuple int int int)))) (and (and (is_spanning_tree g t) (extends tree t)) (<= (total_weight t) (total_weight o))))
      (call tw_eq tree t)))
  (lemma swap_ok (params (g (seq (seq (tuple int int)))) (tree0 (seq (tuple int int int))) (tree (seq (tuple int int int))) (comp0 (seq int)) (n int) (best (tuple int int int)) (o (seq (tuple int int int))) (t (seq (tuple int int int))) (q (seq int)) (m int))
    (requires (in_range g) (== (len g) n) (labels comp0 n) (joined tree0 comp0 n) (internal tree0 comp0)
              (crossing g comp0 best) (lightest g comp0 (get best 2) n)
              (extends tree0 tree) (== (len tree) (+ (len tree0) 1)) (== (idx tree (len tree0)) best)
              (is_spanning_tree g t) (extends tree0 t) (<= (total_weight t) (total_weight o))
              (and (and (and (> (len q) 0) (== (idx q 0) (get best 1))) (== (idx q (- (len q) 1)) (get best 0))) (path_follows_edges t q))
              (forall ((i int)) (=> (and (<= 0 i) (< i (len q))) (and (<= 0 (idx q i)) (< (idx q i) n))))
              (and (<= 0 m) (< m (- (len q) 1))) (forall ((i int)) (=> (and (<= 0 i) (<= i m)) (!= (idx comp0 (idx q i)) (idx comp0 (get best 0)))))
              (== (idx comp0 (idx q (+ m 1))) (idx comp0 (get best 0))))
    (ensures (better g tree o))
    (body
      (call cross_of g comp0 best)
      (ghost-let a int (get best 0))
      (ghost-let b int (get best 1))
      (ghost-let l int (len tree0))
      (obtain ((j int)) (and (and (<= 0 j) (< j (len t))) (or (and (== (get (idx t j) 0) (idx q m)) (== (get (idx t j) 1) (idx q (+ m 1)))) (and (== (get (idx t j) 0) (idx q (+ m 1))) (== (get (idx t j) 1) (idx q m))))))
      (ghost-let t1 (seq (tuple int int int)) (seq-build (len t) (fn (k) (if (== k j) (idx t l) (idx t k)))))
      (ghost-let t2 (seq (tuple int int int)) (seq-build (len t) (fn (k) (if (== k l) best (idx t1 k)))))
      (call tw_point t t1 j)
      (call tw_point t1 t2 l)
      (forall ((x int)) (call kept t t2 j l best x))
      (ghost-let r (seq int) (seq-build (+ m 1) (fn (i) (idx q i))))
      (call conn_extend tree0 t2 (idx q (+ m 1)) a)
      (call conn_join t2 (idx q (+ m 1)) a b (idx q m))
      (call conn_sym t2 (idx q (+ m 1)) (idx q m))
      (forall ((u int) (v int)) (call span_pair g t t2 u v))
      (assert (extends tree t2))))
  (lemma walk (params (g (seq (seq (tuple int int)))) (tree0 (seq (tuple int int int))) (tree (seq (tuple int int int))) (comp0 (seq int)) (n int) (best (tuple int int int)) (o (seq (tuple int int int))) (t (seq (tuple int int int))) (q (seq int)) (k int))
    (requires (in_range g) (== (len g) n) (labels comp0 n) (joined tree0 comp0 n) (internal tree0 comp0)
              (crossing g comp0 best) (lightest g comp0 (get best 2) n)
              (extends tree0 tree) (== (len tree) (+ (len tree0) 1)) (== (idx tree (len tree0)) best)
              (is_spanning_tree g t) (extends tree0 t) (<= (total_weight t) (total_weight o))
              (and (and (and (> (len q) 0) (== (idx q 0) (get best 1))) (== (idx q (- (len q) 1)) (get best 0))) (path_follows_edges t q))
              (forall ((i int)) (=> (and (<= 0 i) (< i (len q))) (and (<= 0 (idx q i)) (< (idx q i) n))))
              (and (<= 0 k) (< k (len q))) (forall ((i int)) (=> (and (<= 0 i) (<= i k)) (!= (idx comp0 (idx q i)) (idx comp0 (get best 0))))))
    (ensures (better g tree o))
    (decreases (- (len q) k))
    (body
      (if (== (idx comp0 (idx q (+ k 1))) (idx comp0 (get best 0)))
        (call swap_ok g tree0 tree comp0 n best o t q k)
        (call walk g tree0 tree comp0 n best o t q (+ k 1)))))
  (lemma good_step (params (g (seq (seq (tuple int int)))) (tree0 (seq (tuple int int int))) (tree (seq (tuple int int int))) (comp0 (seq int)) (n int) (best (tuple int int int)) (o (seq (tuple int int int))))
    (requires (in_range g) (== (len g) n) (labels comp0 n) (joined tree0 comp0 n) (internal tree0 comp0)
              (crossing g comp0 best) (lightest g comp0 (get best 2) n)
              (extends tree0 tree) (== (len tree) (+ (len tree0) 1)) (== (idx tree (len tree0)) best) (good g tree0) (is_spanning_tree g o))
    (ensures (better g tree o))
    (body
      (call cross_of g comp0 best)
      (obtain ((t (seq (tuple int int int)))) (and (and (is_spanning_tree g t) (extends tree0 t)) (<= (total_weight t) (total_weight o))))
      (assert (edges_connected t (get best 1) (get best 0)))
      (obtain ((q (seq int))) (and (and (and (> (len q) 0) (== (idx q 0) (get best 1))) (== (idx q (- (len q) 1)) (get best 0))) (path_follows_edges t q)))
      (forall ((i int)) (call step_ends g t q i))
      (call walk g tree0 tree comp0 n best o t q 0)))
  (def kruskal_mst
    (body
      (let n i64 (len (field graph adj)))
      (let-mut comp (vec i64) (seq-build n (fn (j) j)))
      (let-mut tree (vec (tuple i64 i64 i64)) (vec-new))
      (call roots_id comp n)
      (forall ((x int)) (call conn_self tree x))
      (forall ((o (seq (tuple int int int)))) (call good_nil (view graph) tree o))
      (assert (in_range (view graph)))
      (let-mut go bool true)
      (while go
        (invariant (labels comp n))
        (invariant (>= (roots comp n) 0))
        (invariant (== (+ (len tree) (roots comp n)) n))
        (invariant (joined tree comp n))
        (invariant (are_valid_edges (view graph) tree))
        (invariant (internal tree comp))
        (invariant (good (view graph) tree))
        (invariant (=> (not go) (settled (view graph) comp n)))
        (decreases (+ (* 2 (roots comp n)) (if go 1 0)))
        (let-mut found bool false)
        (let-mut best (tuple i64 i64 i64) (tuple 0 0 0))
        (let-mut u i64 0)
        (while (< u n)
          (invariant (and (<= 0 u) (<= u n)))
          (invariant (=> found (crossing (view graph) comp best)))
          (invariant (=> found (lightest (view graph) comp (get best 2) u)))
          (invariant (=> (not found) (settled (view graph) comp u)))
          (decreases (- n u))
          (let deg i64 (len (idx (field graph adj) u)))
          (let-mut i i64 0)
          (while (< i deg)
            (invariant (and (<= 0 i) (<= i deg)))
            (invariant (=> found (crossing (view graph) comp best)))
            (invariant (=> found (and (lightest (view graph) comp (get best 2) u) (lightest_row (view graph) comp (get best 2) u i))))
            (invariant (=> (not found) (and (settled (view graph) comp u) (settled_row (view graph) comp u i))))
            (decreases (- deg i))
            (let e (tuple i64 i64) (idx (idx (field graph adj) u) i))
            (if (and (!= (idx comp u) (idx comp (get e 0))) (or (not found) (< (get e 1) (get best 2))))
              (block
                (assert (has_edge (view graph) u (get e 0) (get e 1)))
                (set best (tuple u (get e 0) (get e 1)))
                (set found true))
              (block))
            (set i (+ i 1)))
          (set u (+ u 1)))
        (if found
          (block
            (call cross_of (view graph) comp best)
            (let a i64 (get best 0))
            (let b i64 (get best 1))
            (call label_of comp n a)
            (call label_of comp n b)
            (let cu i64 (idx comp a))
            (let cv i64 (idx comp b))
            (ghost-let comp0 (seq int) comp)
            (ghost-let tree0 (seq (tuple int int int)) tree)
            (push tree best)
            (assert (extends tree0 tree))
            (assert (== (idx tree (len tree0)) best))
            (assert (edge_in_set tree a b))
            (assert (are_valid_edges (view graph) tree))
            (let-mut y i64 0)
            (while (< y n)
              (invariant (and (<= 0 y) (<= y n)))
              (invariant (== (len comp) n))
              (invariant (relabelled comp0 comp cv cu y))
              (decreases (- n y))
              (if (== (idx comp y) cv) (set-idx comp y cu) (block))
              (set y (+ y 1)))
            (assert (== (idx comp0 cu) cu))
            (assert (== (idx comp0 cv) cv))
            (assert (!= cu cv))
            (call labels_merge comp0 comp n cu cv)
            (call roots_drop comp0 comp cv n)
            (call roots_nonneg comp n)
            (forall ((x int) (z int)) (call joined_pair tree0 tree comp0 comp n a b cu cv x z))
            (call internal_merge tree0 tree comp0 comp n cu cv)
            (forall ((o (seq (tuple int int int)))) (call good_step (view graph) tree0 tree comp0 n best o)))
          (set go false)))
      (forall ((v int)) (call one_comp (view graph) comp v))
      (call roots_one comp (idx comp 0) n)
      (assert (is_spanning_tree (view graph) tree))
      (forall ((o (seq (tuple int int int)))) (call good_end (view graph) tree o))
      (return tree))))
