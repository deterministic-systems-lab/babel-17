(module bellman_ford
  (header
    (purpose "Find the weight of a lightest path from one vertex to each vertex of a directed weighted graph with the Bellman-Ford algorithm, or report a negative cycle.")
    (invariants "A distance is the weight of a lightest path; none means the vertex is unreachable, and no result means the graph has a negative cycle.")
    (failures "Allocation failure aborts."))
  (data weighted_graph () (weighted_graph (adj (vec (vec (tuple i64 i64))))))
  (ghost-fn size ((wg weighted_graph)) int
    (body (len (field wg adj))))
  (ghost-fn view ((wg weighted_graph)) (seq (seq (tuple int int)))
    (body (field wg adj)))
  (ghost-fn well_formed ((wg weighted_graph)) bool
    (body (and
      (forall ((u int) (i int))
        (=> (and (and (<= 0 u) (< u (len (field wg adj)))) (and (<= 0 i) (< i (len (idx (field wg adj) u)))))
            (and (<= 0 (get (idx (idx (field wg adj) u) i) 0)) (< (get (idx (idx (field wg adj) u) i) 0) (len (field wg adj))))))
      (forall ((u int) (i int) (j int))
        (=> (and (and (and (<= 0 u) (< u (len (field wg adj)))) (and (<= 0 i) (< i (len (idx (field wg adj) u)))))
                 (and (and (<= 0 j) (< j (len (idx (field wg adj) u)))) (!= i j)))
            (!= (get (idx (idx (field wg adj) u) i) 0) (get (idx (idx (field wg adj) u) j) 0)))))))
  (ghost-fn has_edge ((g (seq (seq (tuple int int)))) (u int) (v int) (w int)) bool
    (body (exists ((i int))
      (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u)))))
           (and (== (get (idx (idx g u) i) 0) v) (== (get (idx (idx g u) i) 1) w))))))
  (ghost-fn connected ((g (seq (seq (tuple int int)))) (u int) (v int)) bool
    (body (exists ((w int)) (has_edge g u v w))))
  (ghost-fn is_path ((g (seq (seq (tuple int int)))) (p (seq int))) bool
    (body (and (> (len p) 0)
               (forall ((i int)) (=> (and (<= 0 i) (< i (- (len p) 1))) (connected g (idx p i) (idx p (+ i 1))))))))
  (ghost-fn weight_from ((row (seq (tuple int int))) (v int) (i int)) int (requires (and (<= 0 i) (<= i (len row))))
    (decreases (- (len row) i))
    (body (if (== i (len row)) 0 (if (== (get (idx row i) 0) v) (get (idx row i) 1) (weight_from row v (+ i 1))))))
  (ghost-fn get_edge_weight ((g (seq (seq (tuple int int)))) (u int) (v int)) int
    (body (if (and (<= 0 u) (< u (len g))) (weight_from (idx g u) v 0) 0)))
  (ghost-fn path_weight ((g (seq (seq (tuple int int)))) (p (seq int))) int (decreases (len p))
    (body (if (< (len p) 2) 0
            (+ (path_weight g (take p (- (len p) 1))) (get_edge_weight g (idx p (- (len p) 2)) (idx p (- (len p) 1)))))))
  (ghost-fn is_shortest_dist ((g (seq (seq (tuple int int)))) (start int) (end int) (d int)) bool
    (body (and
      (exists ((p (seq int)))
        (and (and (is_path g p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) end))) (== (path_weight g p) d)))
      (forall ((p (seq int)))
        (=> (and (is_path g p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) end))) (>= (path_weight g p) d))))))
  (ghost-fn has_negative_cycle ((g (seq (seq (tuple int int))))) bool
    (body (exists ((p (seq int)))
      (and (and (is_path g p) (> (len p) 1)) (and (== (idx p 0) (idx p (- (len p) 1))) (< (path_weight g p) 0))))))
  (ghost-fn weights_and_size_bounded ((g (seq (seq (tuple int int))))) bool
    (body (and (<= (len g) 100000)
               (forall ((u int) (v int) (w int)) (=> (has_edge g u v w) (and (>= w -100000) (<= w 100000)))))))
  (spec bellman_ford
    (params (graph weighted_graph) (start i64))
    (returns (res (option (vec (option i64)))))
    (requires (well_formed graph) (and (<= 0 start) (< start (size graph))) (weights_and_size_bounded (view graph)))
    (ensures (match res
               (case (none) (has_negative_cycle (view graph)))
               (case (some dists)
                 (and (== (len dists) (size graph))
                      (forall ((v int))
                        (=> (and (<= 0 v) (< v (size graph)))
                            (match (idx dists v)
                              (case (none) (forall ((p (seq int)))
                                             (=> (and (is_path (view graph) p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) v))) false)))
                              (case (some d) (is_shortest_dist (view graph) start v d)))))))))
    (effects alloc))

  (ghost-fn in_range ((g (seq (seq (tuple int int))))) bool
    (body (forall ((a int) (i int)) (=> (and (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
      (and (<= 0 (get (idx (idx g a) i) 0)) (< (get (idx (idx g a) i) 0) (len g)))))))
  (ghost-fn distinct ((g (seq (seq (tuple int int))))) bool
    (body (forall ((u int) (i int) (j int))
      (=> (and (and (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u))))) (and (and (<= 0 j) (< j (len (idx g u)))) (!= i j)))
          (!= (get (idx (idx g u) i) 0) (get (idx (idx g u) j) 0))))))
  (ghost-fn witnesses ((g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (wit (seq (seq int)))) bool
    (body (forall ((v int))
      (=> (and (and (<= 0 v) (< v (len seen))) (and (and (< v (len dist)) (< v (len wit))) (idx seen v)))
          (and (and (is_path g (idx wit v)) (and (== (idx (idx wit v) 0) start) (== (idx (idx wit v) (- (len (idx wit v)) 1)) v)))
               (== (path_weight g (idx wit v)) (idx dist v)))))))
  (ghost-fn upd ((s0 (seq int)) (s1 (seq int)) (v int) (x int)) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))
  (ghost-fn updb ((s0 (seq bool)) (s1 (seq bool)) (v int) (x bool)) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))
  (ghost-fn updw ((s0 (seq (seq int))) (s1 (seq (seq int))) (v int) (x (seq int))) bool
    (body (and (and (== (len s1) (len s0)) (and (<= 0 v) (< v (len s0))))
               (and (== (idx s1 v) x) (forall ((w int)) (=> (and (and (<= 0 w) (< w (len s0))) (!= w v)) (== (idx s1 w) (idx s0 w))))))))
  (ghost-fn upper ((g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (m int)) bool
    (body (forall ((p (seq int)))
      (=> (and (and (is_path g p) (== (idx p 0) start))
               (and (<= (len p) m) (and (and (<= 0 (idx p (- (len p) 1))) (< (idx p (- (len p) 1)) (len seen))) (< (idx p (- (len p) 1)) (len dist)))))
          (and (idx seen (idx p (- (len p) 1))) (<= (idx dist (idx p (- (len p) 1))) (path_weight g p)))))))
  (ghost-fn relaxed ((g (seq (seq (tuple int int)))) (d0 (seq int)) (s0 (seq bool)) (dist (seq int)) (seen (seq bool)) (k int)) bool
    (body (forall ((x int) (i int))
      (=> (and (and (and (and (<= 0 x) (< x k)) (< x (len g))) (and (<= 0 i) (< i (len (idx g x)))))
               (and (and (and (< x (len s0)) (< x (len d0))) (idx s0 x))
                    (and (and (<= 0 (get (idx (idx g x) i) 0)) (< (get (idx (idx g x) i) 0) (len seen))) (< (get (idx (idx g x) i) 0) (len dist)))))
          (and (idx seen (get (idx (idx g x) i) 0))
               (<= (idx dist (get (idx (idx g x) i) 0)) (+ (idx d0 x) (get (idx (idx g x) i) 1))))))))
  (ghost-fn row_ok ((g (seq (seq (tuple int int)))) (dist (seq int)) (seen (seq bool)) (u int) (du int) (k int)) bool
    (body (forall ((i int))
      (=> (and (and (and (<= 0 u) (< u (len g))) (and (and (<= 0 i) (< i k)) (< i (len (idx g u)))))
               (and (and (<= 0 (get (idx (idx g u) i) 0)) (< (get (idx (idx g u) i) 0) (len seen))) (< (get (idx (idx g u) i) 0) (len dist))))
          (and (idx seen (get (idx (idx g u) i) 0))
               (<= (idx dist (get (idx (idx g u) i) 0)) (+ du (get (idx (idx g u) i) 1))))))))
  (ghost-fn below ((d0 (seq int)) (s0 (seq bool)) (dist (seq int)) (seen (seq bool))) bool
    (body (forall ((v int))
      (=> (and (and (and (<= 0 v) (< v (len s0))) (< v (len d0))) (and (and (< v (len seen)) (< v (len dist))) (idx s0 v)))
          (and (idx seen v) (<= (idx dist v) (idx d0 v)))))))
  (ghost-fn bounded ((dist (seq int)) (seen (seq bool)) (b int)) bool
    (body (forall ((v int)) (=> (and (and (<= 0 v) (< v (len seen))) (and (< v (len dist)) (idx seen v)))
      (and (<= (- 0 b) (idx dist v)) (<= (idx dist v) b))))))
  (ghost-fn join ((a (seq int)) (b (seq int))) (seq int) (requires (> (len b) 0))
    (body (concat a (drop b 1))))

  (lemma entry_w (params (g (seq (seq (tuple int int)))) (a int) (i int))
    (requires (weights_and_size_bounded g) (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
    (ensures (and (<= -100000 (get (idx (idx g a) i) 1)) (<= (get (idx (idx g a) i) 1) 100000)))
    (body (assert (has_edge g a (get (idx (idx g a) i) 0) (get (idx (idx g a) i) 1)))))
  (lemma wf_entry (params (row (seq (tuple int int))) (v int) (i int) (j int))
    (requires (and (<= 0 j) (<= j i)) (< i (len row)) (== (get (idx row i) 0) v)
              (forall ((a int) (b int)) (=> (and (and (and (<= 0 a) (< a (len row))) (and (<= 0 b) (< b (len row)))) (!= a b))
                (!= (get (idx row a) 0) (get (idx row b) 0)))))
    (ensures (== (weight_from row v j) (get (idx row i) 1)))
    (decreases (- i j))
    (body (if (< j i) (call wf_entry row v i (+ j 1)) (block))))
  (lemma gew_entry (params (g (seq (seq (tuple int int)))) (a int) (i int))
    (requires (distinct g) (and (<= 0 a) (< a (len g))) (and (<= 0 i) (< i (len (idx g a)))))
    (ensures (== (get_edge_weight g a (get (idx (idx g a) i) 0)) (get (idx (idx g a) i) 1)))
    (body (call wf_entry (idx g a) (get (idx (idx g a) i) 0) i 0)))
  (lemma pw_append (params (g (seq (seq (tuple int int)))) (p (seq int)) (v int))
    (requires (> (len p) 0))
    (ensures (== (path_weight g (concat p (seq-lit v))) (+ (path_weight g p) (get_edge_weight g (idx p (- (len p) 1)) v))))
    (body (call law_seq_ext (take (concat p (seq-lit v)) (len p)) p)))
  (lemma pw_join (params (g (seq (seq (tuple int int)))) (a (seq int)) (b (seq int)))
    (requires (> (len a) 0) (> (len b) 0) (== (idx a (- (len a) 1)) (idx b 0)))
    (ensures (== (path_weight g (join a b)) (+ (path_weight g a) (path_weight g b))))
    (decreases (len b))
    (body
      (if (== (len b) 1)
        (call law_seq_ext (join a b) a)
        (block
          (call pw_join g a (take b (- (len b) 1)))
          (call law_seq_ext (take (join a b) (- (len (join a b)) 1)) (join a (take b (- (len b) 1))))))))
  (lemma split (params (g (seq (seq (tuple int int)))) (q (seq int)) (i int) (j int))
    (requires (and (and (<= 0 i) (< i j)) (< j (len q))) (== (idx q i) (idx q j)))
    (ensures (== (path_weight g q) (+ (path_weight g (join (take q (+ i 1)) (drop q j))) (path_weight g (take (drop q i) (+ (- j i) 1))))))
    (body
      (call law_seq_ext q (join (take q (+ i 1)) (join (take (drop q i) (+ (- j i) 1)) (drop q j))))
      (call pw_join g (take (drop q i) (+ (- j i) 1)) (drop q j))
      (call pw_join g (take q (+ i 1)) (join (take (drop q i) (+ (- j i) 1)) (drop q j)))
      (call pw_join g (take q (+ i 1)) (drop q j))))
  (lemma path_range (params (g (seq (seq (tuple int int)))) (p (seq int)) (i int))
    (requires (in_range g) (is_path g p) (and (<= 0 (idx p 0)) (< (idx p 0) (len g))) (and (<= 0 i) (< i (len p))))
    (ensures (and (<= 0 (idx p i)) (< (idx p i) (len g))))
    (body
      (if (> i 0)
        (block
          (assert (connected g (idx p (- i 1)) (idx p i)))
          (obtain ((w int)) (has_edge g (idx p (- i 1)) (idx p i) w))
          (obtain ((e int)) (and (and (<= 0 e) (< e (len (idx g (idx p (- i 1)))))) (== (get (idx (idx g (idx p (- i 1))) e) 0) (idx p i)))))
        (block))))
  (lemma few (params (q (seq int)) (n int))
    (requires (>= n 0) (forall ((k int)) (=> (and (<= 0 k) (< k (len q))) (and (<= 0 (idx q k)) (< (idx q k) n))))
              (forall ((a int) (b int)) (=> (and (and (<= 0 a) (< a b)) (< b (len q))) (!= (idx q a) (idx q b)))))
    (ensures (<= (len q) n))
    (decreases n)
    (body
      (if (> n 0)
        (if (exists ((p int)) (and (and (<= 0 p) (< p (len q))) (== (idx q p) (- n 1))))
          (block
            (obtain ((p int)) (and (and (<= 0 p) (< p (len q))) (== (idx q p) (- n 1))))
            (call few (concat (take q p) (drop q (+ p 1))) (- n 1)))
          (call few q (- n 1)))
        (if (> (len q) 0) (assert (< (idx q 0) n)) (block)))))
  (lemma pigeon (params (q (seq int)) (n int))
    (requires (>= n 0) (> (len q) n) (forall ((k int)) (=> (and (<= 0 k) (< k (len q))) (and (<= 0 (idx q k)) (< (idx q k) n)))))
    (ensures (exists ((a int) (b int)) (and (and (and (<= 0 a) (< a b)) (< b (len q))) (== (idx q a) (idx q b)))))
    (body
      (if (exists ((a int) (b int)) (and (and (and (<= 0 a) (< a b)) (< b (len q))) (== (idx q a) (idx q b))))
        (block)
        (call few q n))))
  (lemma negative (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (q (seq int)))
    (requires (in_range g) (== (len dist) (len g)) (== (len seen) (len g))
              (upper g start dist seen (len g))
              (is_path g q) (== (idx q 0) start)
              (forall ((k int)) (=> (and (<= 0 k) (< k (len q))) (and (<= 0 (idx q k)) (< (idx q k) (len g)))))
              (or (not (idx seen (idx q (- (len q) 1)))) (< (path_weight g q) (idx dist (idx q (- (len q) 1))))))
    (ensures (has_negative_cycle g))
    (decreases (len q))
    (body
      (if (> (len q) (len g))
        (block
          (call pigeon q (len g))
          (obtain ((i int) (j int)) (and (and (and (<= 0 i) (< i j)) (< j (len q))) (== (idx q i) (idx q j))))
          (call split g q i j)
          (if (< (path_weight g (take (drop q i) (+ (- j i) 1))) 0)
            (assert (is_path g (take (drop q i) (+ (- j i) 1))))
            (block
              (assert (is_path g (join (take q (+ i 1)) (drop q j))))
              (call negative g start dist seen (join (take q (+ i 1)) (drop q j))))))
        (block))))
  (lemma neg_edge (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (wit (seq (seq int))) (u int) (i int))
    (requires (in_range g) (distinct g) (== (len dist) (len g)) (== (len seen) (len g)) (== (len wit) (len g))
              (and (<= 0 start) (< start (len g)))
              (upper g start dist seen (len g)) (witnesses g start dist seen wit)
              (and (<= 0 u) (< u (len g))) (idx seen u) (and (<= 0 i) (< i (len (idx g u))))
              (or (not (idx seen (get (idx (idx g u) i) 0)))
                  (< (+ (idx dist u) (get (idx (idx g u) i) 1)) (idx dist (get (idx (idx g u) i) 0)))))
    (ensures (has_negative_cycle g))
    (body
      (call gew_entry g u i)
      (call pw_append g (idx wit u) (get (idx (idx g u) i) 0))
      (assert (has_edge g u (get (idx (idx g u) i) 0) (get (idx (idx g u) i) 1)))
      (assert (connected g u (get (idx (idx g u) i) 0)))
      (assert (is_path g (concat (idx wit u) (seq-lit (get (idx (idx g u) i) 0)))))
      (forall ((k int)) (call path_range g (concat (idx wit u) (seq-lit (get (idx (idx g u) i) 0))) k))
      (call negative g start dist seen (concat (idx wit u) (seq-lit (get (idx (idx g u) i) 0))))))
  (lemma relax (params (g (seq (seq (tuple int int)))) (start int) (d0 (seq int)) (s0 (seq bool)) (wit0 (seq (seq int)))
                       (dist1 (seq int)) (seen1 (seq bool)) (wit1 (seq (seq int))) (dist (seq int)) (seen (seq bool)) (wit (seq (seq int)))
                       (u int) (du int) (i int) (v int) (w int) (b int))
    (requires (in_range g) (distinct g)
              (== (len d0) (len g)) (== (len s0) (len g)) (== (len wit0) (len g))
              (== (len dist1) (len g)) (== (len seen1) (len g)) (== (len wit1) (len g))
              (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u))))
              (== v (get (idx (idx g u) i) 0)) (== w (get (idx (idx g u) i) 1))
              (idx s0 u) (== (idx d0 u) du)
              (and (<= 0 start) (< start (len g))) (and (idx seen1 start) (<= (idx dist1 start) 0))
              (witnesses g start d0 s0 wit0) (witnesses g start dist1 seen1 wit1)
              (below d0 s0 dist1 seen1) (relaxed g d0 s0 dist1 seen1 u) (row_ok g dist1 seen1 u du i) (bounded dist1 seen1 b)
              (<= (- 0 b) (+ du w)) (<= (+ du w) b)
              (or (not (idx seen1 v)) (< (+ du w) (idx dist1 v)))
              (upd dist1 dist v (+ du w)) (updb seen1 seen v true) (updw wit1 wit v (concat (idx wit0 u) (seq-lit v))))
    (ensures (and (idx seen start) (<= (idx dist start) 0)) (witnesses g start dist seen wit) (below d0 s0 dist seen)
             (relaxed g d0 s0 dist seen u) (row_ok g dist seen u du (+ i 1)) (bounded dist seen b))
    (body
      (call gew_entry g u i)
      (call pw_append g (idx wit0 u) v)
      (assert (has_edge g u v w))
      (assert (connected g u v))))
  (lemma skip (params (g (seq (seq (tuple int int)))) (dist (seq int)) (seen (seq bool)) (u int) (du int) (i int))
    (requires (in_range g) (== (len dist) (len g)) (== (len seen) (len g))
              (and (<= 0 u) (< u (len g))) (and (<= 0 i) (< i (len (idx g u)))) (row_ok g dist seen u du i)
              (and (idx seen (get (idx (idx g u) i) 0)) (<= (idx dist (get (idx (idx g u) i) 0)) (+ du (get (idx (idx g u) i) 1)))))
    (ensures (row_ok g dist seen u du (+ i 1)))
    (body))
  (lemma row_done (params (g (seq (seq (tuple int int)))) (d0 (seq int)) (s0 (seq bool)) (dist (seq int)) (seen (seq bool)) (u int) (du int))
    (requires (and (<= 0 u) (< u (len g))) (== (len d0) (len g)) (== (len s0) (len g)) (== (len dist) (len g)) (== (len seen) (len g))
              (relaxed g d0 s0 dist seen u) (row_ok g dist seen u du (len (idx g u))) (== (idx d0 u) du))
    (ensures (relaxed g d0 s0 dist seen (+ u 1)))
    (body))
  (lemma row_skip (params (g (seq (seq (tuple int int)))) (d0 (seq int)) (s0 (seq bool)) (dist (seq int)) (seen (seq bool)) (u int))
    (requires (and (<= 0 u) (< u (len g))) (== (len s0) (len g)) (relaxed g d0 s0 dist seen u) (not (idx s0 u)))
    (ensures (relaxed g d0 s0 dist seen (+ u 1)))
    (body))
  (lemma upper_one (params (g (seq (seq (tuple int int)))) (start int) (d0 (seq int)) (s0 (seq bool)) (dist (seq int)) (seen (seq bool)) (r int) (p (seq int)))
    (requires (in_range g) (distinct g) (== (len d0) (len g)) (== (len s0) (len g)) (== (len dist) (len g)) (== (len seen) (len g))
              (and (<= 0 start) (< start (len g))) (>= r 1)
              (upper g start d0 s0 r) (relaxed g d0 s0 dist seen (len g)) (below d0 s0 dist seen)
              (is_path g p) (== (idx p 0) start) (<= (len p) (+ r 1)))
    (ensures (and (and (<= 0 (idx p (- (len p) 1))) (< (idx p (- (len p) 1)) (len g)))
                  (and (idx seen (idx p (- (len p) 1))) (<= (idx dist (idx p (- (len p) 1))) (path_weight g p)))))
    (body
      (forall ((k int)) (call path_range g p k))
      (if (> (len p) r)
        (block
          (assert (connected g (idx p (- (len p) 2)) (idx p (- (len p) 1))))
          (obtain ((w int)) (has_edge g (idx p (- (len p) 2)) (idx p (- (len p) 1)) w))
          (obtain ((e int)) (and (and (<= 0 e) (< e (len (idx g (idx p (- (len p) 2))))))
                                 (and (== (get (idx (idx g (idx p (- (len p) 2))) e) 0) (idx p (- (len p) 1))) (== (get (idx (idx g (idx p (- (len p) 2))) e) 1) w))))
          (call gew_entry g (idx p (- (len p) 2)) e)
          (assert (is_path g (take p (- (len p) 1)))))
        (block))))
  (lemma upper_step (params (g (seq (seq (tuple int int)))) (start int) (d0 (seq int)) (s0 (seq bool)) (dist (seq int)) (seen (seq bool)) (r int))
    (requires (in_range g) (distinct g) (== (len d0) (len g)) (== (len s0) (len g)) (== (len dist) (len g)) (== (len seen) (len g))
              (and (<= 0 start) (< start (len g))) (>= r 1)
              (upper g start d0 s0 r) (relaxed g d0 s0 dist seen (len g)) (below d0 s0 dist seen))
    (ensures (upper g start dist seen (+ r 1)))
    (body (forall ((p (seq int))) (call upper_one g start d0 s0 dist seen r p))))
  (lemma low (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (p (seq int)) (k int))
    (requires (in_range g) (distinct g) (== (len dist) (len g)) (== (len seen) (len g)) (and (<= 0 start) (< start (len g))) (idx seen start)
              (relaxed g dist seen dist seen (len g))
              (is_path g p) (== (idx p 0) start)
              (forall ((i int)) (=> (and (<= 0 i) (< i (len p))) (and (<= 0 (idx p i)) (< (idx p i) (len g)))))
              (and (<= 1 k) (<= k (len p))))
    (ensures (idx seen (idx p (- k 1))) (<= (idx dist (idx p (- k 1))) (+ (idx dist start) (path_weight g (take p k)))))
    (decreases k)
    (body
      (if (> k 1)
        (block
          (call low g start dist seen p (- k 1))
          (assert (connected g (idx p (- k 2)) (idx p (- k 1))))
          (obtain ((w int)) (has_edge g (idx p (- k 2)) (idx p (- k 1)) w))
          (obtain ((e int)) (and (and (<= 0 e) (< e (len (idx g (idx p (- k 2))))))
                                 (and (== (get (idx (idx g (idx p (- k 2))) e) 0) (idx p (- k 1))) (== (get (idx (idx g (idx p (- k 2))) e) 1) w))))
          (call gew_entry g (idx p (- k 2)) e)
          (call law_take_take p k (- k 1)))
        (block))))
  (lemma low_all (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (p (seq int)))
    (requires (in_range g) (distinct g) (== (len dist) (len g)) (== (len seen) (len g)) (and (<= 0 start) (< start (len g))) (idx seen start)
              (relaxed g dist seen dist seen (len g))
              (is_path g p) (== (idx p 0) start))
    (ensures (and (and (<= 0 (idx p (- (len p) 1))) (< (idx p (- (len p) 1)) (len g)))
                  (and (idx seen (idx p (- (len p) 1))) (<= (idx dist (idx p (- (len p) 1))) (+ (idx dist start) (path_weight g p))))))
    (body
      (forall ((i int)) (call path_range g p i))
      (call low g start dist seen p (len p))
      (call law_take_all p)))
  (lemma answer (params (g (seq (seq (tuple int int)))) (start int) (dist (seq int)) (seen (seq bool)) (wit (seq (seq int))) (v int))
    (requires (in_range g) (distinct g) (== (len dist) (len g)) (== (len seen) (len g)) (== (len wit) (len g))
              (and (<= 0 start) (< start (len g))) (and (idx seen start) (<= (idx dist start) 0))
              (relaxed g dist seen dist seen (len g)) (witnesses g start dist seen wit) (and (<= 0 v) (< v (len g))))
    (ensures (=> (idx seen v) (is_shortest_dist g start v (idx dist v)))
             (=> (not (idx seen v))
                 (forall ((p (seq int))) (=> (and (is_path g p) (and (== (idx p 0) start) (== (idx p (- (len p) 1)) v))) false))))
    (body
      (forall ((p (seq int))) (call low_all g start dist seen p))
      (assert (is_path g (idx wit start)))
      (if (idx seen v) (assert (is_path g (idx wit v))) (block))))
  (def bellman_ford
    (body
      (let n i64 (len (field graph adj)))
      (let-mut dist (vec i64) (seq-build n (fn (j) 0)))
      (let-mut seen (vec bool) (seq-build n (fn (j) (== j start))))
      (ghost-let-mut wit (seq (seq int)) (seq-build n (fn (j) (seq-lit start))))
      (let-mut r i64 1)
      (while (< r n)
        (invariant (and (<= 1 r) (<= r n)))
        (invariant (and (and (== (len dist) n) (== (len seen) n)) (== (len wit) n)))
        (invariant (and (idx seen start) (<= (idx dist start) 0)))
        (invariant (witnesses (view graph) start dist seen wit))
        (invariant (upper (view graph) start dist seen r))
        (invariant (bounded dist seen (* (- r 1) 100000)))
        (decreases (- n r))
        (let d0 (vec i64) (seq-build n (fn (j) (idx dist j))))
        (let s0 (vec bool) (seq-build n (fn (j) (idx seen j))))
        (ghost-let wit0 (seq (seq int)) wit)
        (let-mut u i64 0)
        (while (< u n)
          (invariant (and (<= 0 u) (<= u n)))
          (invariant (and (and (== (len dist) n) (== (len seen) n)) (== (len wit) n)))
          (invariant (and (idx seen start) (<= (idx dist start) 0)))
          (invariant (witnesses (view graph) start dist seen wit))
          (invariant (below d0 s0 dist seen))
          (invariant (relaxed (view graph) d0 s0 dist seen u))
          (invariant (bounded dist seen (* r 100000)))
          (decreases (- n u))
          (if (idx s0 u)
            (block
              (let du i64 (idx d0 u))
              (let deg i64 (len (idx (field graph adj) u)))
              (let-mut i i64 0)
              (while (< i deg)
                (invariant (and (<= 0 i) (<= i deg)))
                (invariant (and (and (== (len dist) n) (== (len seen) n)) (== (len wit) n)))
                (invariant (and (idx seen start) (<= (idx dist start) 0)))
                (invariant (witnesses (view graph) start dist seen wit))
                (invariant (below d0 s0 dist seen))
                (invariant (relaxed (view graph) d0 s0 dist seen u))
                (invariant (row_ok (view graph) dist seen u du i))
                (invariant (bounded dist seen (* r 100000)))
                (decreases (- deg i))
                (let e (tuple i64 i64) (idx (idx (field graph adj) u) i))
                (let v i64 (get e 0))
                (call entry_w (view graph) u i)
                (let c i64 (+ du (get e 1)))
                (if (or (not (idx seen v)) (< c (idx dist v)))
                  (block
                    (ghost-let dist1 (seq int) dist)
                    (ghost-let seen1 (seq bool) seen)
                    (ghost-let wit1 (seq (seq int)) wit)
                    (ghost-set wit (seq-build n (fn (j) (if (== j v) (concat (idx wit0 u) (seq-lit v)) (idx wit j)))))
                    (set-idx dist v c)
                    (set-idx seen v true)
                    (call relax (view graph) start d0 s0 wit0 dist1 seen1 wit1 dist seen wit u du i v (get e 1) (* r 100000)))
                  (call skip (view graph) dist seen u du i))
                (set i (+ i 1)))
              (call row_done (view graph) d0 s0 dist seen u du))
            (call row_skip (view graph) d0 s0 dist seen u))
          (set u (+ u 1)))
        (call upper_step (view graph) start d0 s0 dist seen r)
        (set r (+ r 1)))
      (let-mut x i64 0)
      (while (< x n)
        (invariant (and (<= 0 x) (<= x n)))
        (invariant (relaxed (view graph) dist seen dist seen x))
        (decreases (- n x))
        (if (idx seen x)
          (block
            (let dx i64 (idx dist x))
            (let dg i64 (len (idx (field graph adj) x)))
            (let-mut k i64 0)
            (while (< k dg)
              (invariant (and (<= 0 k) (<= k dg)))
              (invariant (row_ok (view graph) dist seen x dx k))
              (decreases (- dg k))
              (let f (tuple i64 i64) (idx (idx (field graph adj) x) k))
              (let y i64 (get f 0))
              (call entry_w (view graph) x k)
              (if (or (not (idx seen y)) (< (+ dx (get f 1)) (idx dist y)))
                (block
                  (call neg_edge (view graph) start dist seen wit x k)
                  (return (none)))
                (call skip (view graph) dist seen x dx k))
              (set k (+ k 1)))
            (call row_done (view graph) dist seen dist seen x dx))
          (call row_skip (view graph) dist seen dist seen x))
        (set x (+ x 1)))
      (forall ((v int)) (call answer (view graph) start dist seen wit v))
      (return (some (seq-build n (fn (v) (if (idx seen v) (some (idx dist v)) (none)))))))))
