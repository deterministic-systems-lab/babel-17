(module fib
  (header
    (purpose "Compute the nth Fibonacci number.")
    (invariants "The result equals fib(n).")
    (failures "None. The precondition keeps every intermediate value in i64."))
  (ghost-fn fib ((n int)) int
    (requires (>= n 0))
    (decreases n)
    (body (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))))
  (spec fib_iter
    (params (n i64))
    (returns (f i64))
    (requires (>= n 0) (forall ((i int)) (=> (and (<= 0 i) (<= i n)) (in_i64 (fib i)))))
    (ensures (== f (fib n)))
    (effects))
  (def fib_iter
    (body
      (if (== n 0) (return 0) (block))
      (let-mut prev i64 0)
      (let-mut cur i64 1)
      (let-mut i i64 1)
      (while (< i n)
        (invariant (and (<= 1 i) (<= i n)))
        (invariant (and (== prev (fib (- i 1))) (== cur (fib i))))
        (decreases (- n i))
        (let next i64 (+ prev cur))
        (set prev cur)
        (set cur next)
        (set i (+ i 1)))
      (return cur))))
