(module max_element
  (header
    (purpose "Return the largest element of a non-empty sequence.")
    (invariants "The result bounds every element and occurs in the sequence.")
    (failures "None for non-empty input."))
  (spec max_element
    (params (a (ref (slice i64))))
    (returns (m i64))
    (requires (> (len a) 0))
    (ensures (forall ((i int)) (=> (and (<= 0 i) (< i (len a))) (<= (idx a i) m))) (contains a m))
    (effects))
  (def max_element
    (body
      (let-mut m i64 (idx a 0))
      (let-mut i i64 1)
      (while (< i (len a))
        (invariant (and (<= 1 i) (<= i (len a))))
        (invariant (forall ((k int)) (=> (and (<= 0 k) (< k i)) (<= (idx a k) m))))
        (invariant (contains a m))
        (decreases (- (len a) i))
        (if (> (idx a i) m) (set m (idx a i)) (block))
        (set i (+ i 1)))
      (return m))))
