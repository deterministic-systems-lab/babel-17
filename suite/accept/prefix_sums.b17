(module prefix_sums
  (header
    (purpose "Return the running totals of a sequence, starting from 0.")
    (invariants "Entry i of the output is the sum of the first i elements.")
    (failures "None. The precondition keeps every running total in i64. Allocation failure aborts."))
  (ghost-fn sum_of ((s (seq int))) int
    (decreases (len s))
    (body (if (== (len s) 0) 0 (+ (sum_of (take s (- (len s) 1))) (last s)))))
  (spec prefix_sums
    (params (a (ref (slice i64))))
    (returns (p (vec i64)))
    (requires (forall ((i int)) (=> (and (<= 0 i) (< i (len a))) (in_i64 (+ (sum_of (take a i)) (idx a i))))))
    (ensures
      (== (len p) (+ (len a) 1))
      (forall ((i int)) (=> (and (<= 0 i) (<= i (len a))) (== (idx p i) (sum_of (take a i))))))
    (effects alloc))
  (def prefix_sums
    (body
      (let-mut p (vec i64) (vec-new))
      (let-mut acc i64 0)
      (push p acc)
      (let-mut i i64 0)
      (while (< i (len a))
        (invariant (and (<= 0 i) (<= i (len a))))
        (invariant (== (len p) (+ i 1)))
        (invariant (== acc (sum_of (take a i))))
        (invariant (forall ((k int)) (=> (and (<= 0 k) (<= k i)) (== (idx p k) (sum_of (take a k))))))
        (decreases (- (len a) i))
        (set acc (+ acc (idx a i)))
        (push p acc)
        (set i (+ i 1)))
      (return p))))
