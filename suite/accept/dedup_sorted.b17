(module dedup_sorted
  (header
    (purpose "Remove duplicates from a sorted sequence, keeping one copy of each value.")
    (invariants "The output is strictly increasing and holds exactly the input's values.")
    (failures "None for sorted input. Allocation failure aborts."))
  (ghost-fn strictly_sorted ((s (seq int))) bool
    (body (forall ((i int) (j int)) (=> (and (and (<= 0 i) (< i j)) (< j (len s))) (< (idx s i) (idx s j))))))
  (spec dedup_sorted
    (params (a (ref (slice i64))))
    (returns (r (vec i64)))
    (requires (sorted a))
    (ensures (strictly_sorted r) (forall ((x int)) (== (contains a x) (contains r x))))
    (effects alloc))
  (def dedup_sorted
    (body
      (let-mut r (vec i64) (vec-new))
      (let-mut i i64 0)
      (while (< i (len a))
        (invariant (and (<= 0 i) (<= i (len a))))
        (invariant (strictly_sorted r))
        (invariant (forall ((x int)) (== (contains (take a i) x) (contains r x))))
        (invariant (=> (> (len r) 0) (and (> i 0) (== (last r) (idx a (- i 1))))))
        (decreases (- (len a) i))
        (if (or (== (len r) 0) (!= (idx r (- (len r) 1)) (idx a i)))
          (push r (idx a i))
          (block))
        (set i (+ i 1)))
      (return r))))
