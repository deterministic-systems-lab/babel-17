(module insertion_sort
  (header
    (purpose "Sort a vector, keeping exactly the same elements.")
    (invariants "The output is ordered and a permutation of the input.")
    (failures "None."))
  (spec insertion_sort
    (params (a (vec i64)))
    (returns (r (vec i64)))
    (ensures (sorted r) (== (multiset r) (multiset a)))
    (effects))
  (def insertion_sort
    (body
      (let-mut v (vec i64) a)
      (let-mut i i64 0)
      (while (< i (len v))
        (invariant (and (<= 0 i) (<= i (len v))))
        (invariant (== (len v) (len a)))
        (invariant (sorted (take v i)))
        (invariant (== (multiset v) (multiset a)))
        (decreases (- (len v) i))
        (let-mut j i64 i)
        (while (and (> j 0) (> (idx v (- j 1)) (idx v j)))
          (invariant (and (<= 0 j) (<= j i)))
          (invariant (== (len v) (len a)))
          (invariant (== (multiset v) (multiset a)))
          (invariant (forall ((p int) (q int)) (=> (and (and (<= 0 p) (< p q)) (and (<= q i) (!= q j))) (<= (idx v p) (idx v q)))))
          (invariant (forall ((q int)) (=> (and (< j q) (<= q i)) (<= (idx v j) (idx v q)))))
          (decreases j)
          (let tmp i64 (idx v (- j 1)))
          (set-idx v (- j 1) (idx v j))
          (set-idx v j tmp)
          (set j (- j 1)))
        (set i (+ i 1)))
      (return v))))
