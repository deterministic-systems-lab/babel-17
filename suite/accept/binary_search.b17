(module binary_search
  (header
    (purpose "Find key in a sorted sequence; return its index, or -1 if absent.")
    (invariants "A non-negative result indexes an occurrence of key; -1 means key is absent.")
    (failures "None for sorted input."))
  (spec binary_search
    (params (a (ref (slice i64))) (key i64))
    (returns (r i64))
    (requires (sorted a))
    (ensures
      (and (<= -1 r) (< r (len a)))
      (=> (>= r 0) (== (idx a r) key))
      (=> (== r -1) (not (contains a key))))
    (effects))
  (def binary_search
    (body
      (let-mut lo i64 0)
      (let-mut hi i64 (len a))
      (while (< lo hi)
        (invariant (and (and (<= 0 lo) (<= lo hi)) (<= hi (len a))))
        (invariant (forall ((k int)) (=> (and (<= 0 k) (< k lo)) (< (idx a k) key))))
        (invariant (forall ((k int)) (=> (and (<= hi k) (< k (len a))) (> (idx a k) key))))
        (decreases (- hi lo))
        (let mid i64 (+ lo (/ (- hi lo) 2)))
        (if (< (idx a mid) key)
          (set lo (+ mid 1))
          (if (> (idx a mid) key)
            (set hi mid)
            (return mid))))
      (return -1))))
