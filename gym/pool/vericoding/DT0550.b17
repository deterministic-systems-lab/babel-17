(module intersect1d
  (header
    (purpose "Find the intersection of two sequences: the values present in both, each once, in ascending order.")
    (invariants "Every value of the result is in both inputs, the result is strictly increasing, and every value in both inputs is in the result.")
    (failures "None. Allocation failure aborts."))
  (spec intersect1d
    (params (ar1 (ref (slice i64))) (ar2 (ref (slice i64))))
    (returns (result (vec i64)))
    (ensures
      (forall ((i int)) (=> (and (<= 0 i) (< i (len result))) (and (contains ar1 (idx result i)) (contains ar2 (idx result i)))))
      (forall ((i int) (j int)) (=> (and (and (<= 0 i) (< i j)) (< j (len result))) (< (idx result i) (idx result j))))
      (forall ((val int)) (=> (and (contains ar1 val) (contains ar2 val)) (contains result val))))
    (effects alloc))
  (ghost-fn strict ((s (seq int)))  bool
    (body (forall ((i int) (j int)) (=> (and (and (<= 0 i) (< i j)) (< j (len s))) (< (idx s i) (idx s j))))))
  (spec has
    (params (a (ref (slice i64))) (x i64))
    (returns (b bool))
    (ensures (== b (contains a x)))
    (effects))
  (def has
    (body
      (let-mut j i64 0)
      (while (< j (len a))
        (invariant (and (<= 0 j) (<= j (len a))))
        (invariant (forall ((p int)) (=> (and (<= 0 p) (< p j)) (!= (idx a p) x))))
        (decreases (- (len a) j))
        (if (== (idx a j) x) (return true) (block))
        (set j (+ j 1)))
      (return false)))
  (spec insert_sorted
    (params (r (ref (slice i64))) (x i64))
    (returns (out (vec i64)))
    (requires
      (strict r)
      (not (contains r x))
      (< (len r) 9223372036854775807))
    (ensures
      (== (len out) (+ (len r) 1))
      (strict out)
      (forall ((v int)) (=> (contains out v) (or (contains r v) (== v x))))
      (forall ((v int)) (=> (contains r v) (contains out v)))
      (contains out x))
    (effects alloc))
  (def insert_sorted
    (body
      (let-mut out (vec i64) (vec-new))
      (let-mut j i64 0)
      (while (and (< j (len r)) (< (idx r j) x))
        (invariant (and (<= 0 j) (<= j (len r))))
        (invariant (== (len out) j))
        (invariant (forall ((k int)) (=> (and (<= 0 k) (< k j)) (== (idx out k) (idx r k)))))
        (invariant (forall ((k int)) (=> (and (<= 0 k) (< k j)) (< (idx r k) x))))
        (decreases (- (len r) j))
        (push out (idx r j))
        (set j (+ j 1)))
      (let p i64 j)
      (assert (=> (< p (len r)) (< x (idx r p))))
      (push out x)
      (while (< j (len r))
        (invariant (and (<= p j) (<= j (len r))))
        (invariant (== (len out) (+ j 1)))
        (invariant (forall ((k int)) (=> (and (<= 0 k) (< k p)) (== (idx out k) (idx r k)))))
        (invariant (== (idx out p) x))
        (invariant (forall ((k int)) (=> (and (< p k) (<= k j)) (== (idx out k) (idx r (- k 1))))))
        (decreases (- (len r) j))
        (push out (idx r j))
        (set j (+ j 1)))
      (return out)))
  (def intersect1d
    (body
      (let-mut r (vec i64) (vec-new))
      (let-mut i i64 0)
      (while (< i (len ar1))
        (invariant (and (<= 0 i) (<= i (len ar1))))
        (invariant (<= (len r) i))
        (invariant (strict r))
        (invariant (forall ((v int)) (=> (contains r v) (and (contains ar1 v) (contains ar2 v)))))
        (invariant (forall ((v int)) (=> (and (contains (take ar1 i) v) (contains ar2 v)) (contains r v))))
        (decreases (- (len ar1) i))
        (let x i64 (idx ar1 i))
        (let ((in2 bool)) (call has ar2 x))
        (let ((inr bool)) (call has (borrow r) x))
        (if (and in2 (not inr))
          (block
            (let ((r2 (vec i64))) (call insert_sorted (borrow r) x))
            (set r r2))
          (block))
        (call law_take_step ar1 i)
        (set i (+ i 1)))
      (call law_take_all ar1)
      (return r))))
