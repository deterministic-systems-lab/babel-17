(module bubble_sort
  (header
    (purpose "Return a count no larger than the number of pairs bubble sort compares on a.")
    (invariants "The result is between 0 and n_choose2(len a), the number of pairs bubble sort compares.")
    (failures "None. a is only read: the Dafny method may modify it, but no ensures mentions its contents. The precondition keeps n_choose2(len a), the most swaps there can be, in i64."))
  (ghost-fn n_choose2 ((n int)) int
    (body (/ (* n (- n 1)) 2)))
  (ghost-fn sum_range ((lo int) (hi int)) int
    (decreases (- hi lo))
    (body (if (>= lo hi) 0 (- (+ (sum_range lo (- hi 1)) hi) 1))))
  (spec bubble_sort
    (params (a (ref (slice i64))))
    (returns (n i64))
    (requires (in_i64 (n_choose2 (len a))))
    (ensures
      (>= n 0)
      (<= n (n_choose2 (len a))))
    (effects))
  (lemma sum_range_closed (params (k int))
    (requires (>= k 0))
    (ensures (== (sum_range 0 k) (n_choose2 k)))
    (decreases k)
    (body
      (if (== k 0)
        (block)
        (block
          (call sum_range_closed (- k 1))
          (assert (== (sum_range 0 k) (- (+ (sum_range 0 (- k 1)) k) 1)))
          (assert (== (* k (- k 1)) (+ (* (- k 1) (- k 2)) (* 2 (- k 1)))))))))
  (lemma sum_range_mono (params (j int) (k int))
    (requires (and (<= 0 j) (<= j k)))
    (ensures (<= (sum_range 0 j) (sum_range 0 k)))
    (decreases (- k j))
    (body
      (if (== j k)
        (block)
        (block
          (call sum_range_mono j (- k 1))
          (assert (== (sum_range 0 k) (- (+ (sum_range 0 (- k 1)) k) 1)))))))
  (def bubble_sort
    (body
      (let-mut c i64 0)
      (let-mut j i64 0)
      (while (< j (len a))
        (invariant (and (<= 0 j) (<= j (len a))))
        (invariant (and (<= 0 c) (<= c (sum_range 0 j))))
        (decreases (- (len a) j))
        (assert (== (sum_range 0 (+ j 1)) (+ (sum_range 0 j) j)))
        (call sum_range_mono (+ j 1) (len a))
        (call sum_range_closed (len a))
        (let-mut i i64 0)
        (while (< i j)
          (invariant (and (<= 0 i) (<= i j)))
          (invariant (and (<= 0 c) (<= c (+ (sum_range 0 j) i))))
          (decreases (- j i))
          (if (> (idx a i) (idx a j)) (set c (+ c 1)) (block))
          (set i (+ i 1)))
        (assert (== (sum_range 0 (+ j 1)) (+ (sum_range 0 j) j)))
        (set j (+ j 1)))
      (call sum_range_closed (len a))
      (return c))))
