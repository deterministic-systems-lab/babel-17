(module sort_third
  (header
    (purpose "Sort the elements at the positions divisible by three, leaving the other positions as they were.")
    (invariants "The positions divisible by three hold their elements in order, the others are unchanged, and the output is a permutation of the input.")
    (failures "Allocation failure aborts."))
  (spec sort_third
    (params (a (ref (slice i64))))
    (returns (sorted_even (vec i64)))
    (requires (> (len a) 0))
    (ensures
      (== (len sorted_even) (len a))
      (forall ((i int) (j int))
        (=> (and (and (and (<= 0 i) (< i j)) (< j (len sorted_even))) (and (== (% i 3) 0) (== (% j 3) 0)))
            (<= (idx sorted_even i) (idx sorted_even j))))
      (forall ((i int)) (=> (and (and (<= 0 i) (< i (len a))) (!= (% i 3) 0)) (== (idx sorted_even i) (idx a i))))
      (== (multiset a) (multiset sorted_even)))
    (effects alloc))
  (ghost-fn div3 ((k int)) bool (body (== (% k 3) 0)))
  (def sort_third
    (body
      (let n i64 (len a))
      (let-mut v (vec i64) (seq-build n (fn (k) (idx a k))))
      (assert (== v a))
      (let-mut i i64 0)
      (while (< i n)
        (invariant (and (<= 0 i) (<= i n)))
        (invariant (== (len v) n))
        (invariant (== (multiset a) (multiset v)))
        (invariant (forall ((k int)) (=> (and (and (<= 0 k) (< k n)) (not (div3 k))) (== (idx v k) (idx a k)))))
        (invariant (forall ((x int) (y int))
          (=> (and (and (and (<= 0 x) (< x i)) (and (<= i y) (< y n))) (and (div3 x) (div3 y)))
              (<= (idx v x) (idx v y)))))
        (invariant (forall ((x int) (y int))
          (=> (and (and (and (<= 0 x) (< x y)) (< y i)) (and (div3 x) (div3 y)))
              (<= (idx v x) (idx v y)))))
        (decreases (- n i))
        (let-mut j i64 (+ i 1))
        (while (< j n)
          (invariant (and (< i j) (<= j n)))
          (invariant (== (len v) n))
          (invariant (== (multiset a) (multiset v)))
          (invariant (forall ((k int)) (=> (and (and (<= 0 k) (< k n)) (not (div3 k))) (== (idx v k) (idx a k)))))
          (invariant (forall ((x int) (y int))
            (=> (and (and (and (<= 0 x) (< x i)) (and (<= i y) (< y n))) (and (div3 x) (div3 y)))
                (<= (idx v x) (idx v y)))))
          (invariant (forall ((x int) (y int))
            (=> (and (and (and (<= 0 x) (< x y)) (< y i)) (and (div3 x) (div3 y)))
                (<= (idx v x) (idx v y)))))
          (invariant (forall ((y int))
            (=> (and (and (< i y) (< y j)) (and (div3 i) (div3 y))) (<= (idx v i) (idx v y)))))
          (decreases (- n j))
          (if (and (and (== (% i 3) 0) (== (% j 3) 0)) (> (idx v i) (idx v j)))
            (block
              (let tmp i64 (idx v i))
              (set-idx v i (idx v j))
              (set-idx v j tmp))
            (block))
          (set j (+ j 1)))
        (set i (+ i 1)))
      (return v))))
