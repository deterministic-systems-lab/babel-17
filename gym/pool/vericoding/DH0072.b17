(module strange_sort_list_helper
  (header
    (purpose "Sort a list, and interleave the sorted list's smallest and largest remaining elements: first, last, second, second last, and so on.")
    (invariants "The sorted list is a permutation of the input, and the strange list's even positions read the sorted list from the front and its odd positions from the back.")
    (failures "Allocation failure aborts."))
  (spec strange_sort_list_helper
    (params (s (ref (slice i64))))
    (returns (sorted_seq (vec i64)) (strange (vec i64)))
    (ensures
      (== (multiset s) (multiset sorted_seq))
      (== (len s) (len sorted_seq))
      (== (len sorted_seq) (len strange))
      (forall ((i int)) (=> (and (and (<= 0 i) (< i (len s))) (== (% i 2) 0)) (== (idx strange i) (idx sorted_seq (/ i 2)))))
      (forall ((i int)) (=> (and (and (<= 0 i) (< i (len s))) (!= (% i 2) 0))
        (== (idx strange i) (idx sorted_seq (- (- (len s) (/ (- i 1) 2)) 1))))))
    (effects alloc))
  (def strange_sort_list_helper
    (body
      (let n i64 (len s))
      (let-mut v (vec i64) (seq-build n (fn (k) (idx s k))))
      (assert (== v s))
      (let-mut i i64 0)
      (while (< i n)
        (invariant (and (<= 0 i) (<= i n)))
        (invariant (== (len v) n))
        (invariant (== (multiset v) (multiset s)))
        (decreases (- n i))
        (let-mut j i64 i)
        (while (and (> j 0) (> (idx v (- j 1)) (idx v j)))
          (invariant (and (<= 0 j) (<= j i)))
          (invariant (== (len v) n))
          (invariant (== (multiset v) (multiset s)))
          (decreases j)
          (let tmp i64 (idx v (- j 1)))
          (set-idx v (- j 1) (idx v j))
          (set-idx v j tmp)
          (set j (- j 1)))
        (set i (+ i 1)))
      (let-mut r (vec i64) (vec-new))
      (let-mut lo i64 0)
      (let-mut hi i64 n)
      (let-mut t i64 0)
      (while (< t n)
        (invariant (and (<= 0 t) (<= t n)))
        (invariant (== (len v) n))
        (invariant (== (len r) t))
        (invariant (== lo (/ (+ t 1) 2)))
        (invariant (== hi (- n (/ t 2))))
        (invariant (forall ((k int)) (=> (and (and (<= 0 k) (< k t)) (is_even k)) (== (idx r k) (idx v (at_front k))))))
        (invariant (forall ((k int)) (=> (and (and (<= 0 k) (< k t)) (not (is_even k))) (== (idx r k) (idx v (at_back n k))))))
        (decreases (- n t))
        (if (== (% t 2) 0)
          (block (push r (idx v lo)) (set lo (+ lo 1)))
          (block (push r (idx v (- hi 1))) (set hi (- hi 1))))
        (set t (+ t 1)))
      (return v r)))
  (ghost-fn is_even ((k int)) bool (body (== (% k 2) 0)))
  (ghost-fn at_front ((k int)) int (body (/ k 2)))
  (ghost-fn at_back ((n int) (k int)) int (body (- (- n (/ (- k 1) 2)) 1))))
