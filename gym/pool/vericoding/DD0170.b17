(module compute_count
  (header
    (purpose "Count the even elements among the first count_index elements of a.")
    (invariants "The result is count(count_index, a): how many of a's first count_index elements are even.")
    (failures "None. b is only read: the Dafny method may modify it, but no ensures mentions its contents."))
  (ghost-fn count ((hi int) (s (seq int))) int
    (requires (and (<= 0 hi) (<= hi (len s))))
    (decreases hi)
    (body (if (== hi 0)
            0
            (if (== (% (idx s (- hi 1)) 2) 0) (+ 1 (count (- hi 1) s)) (count (- hi 1) s)))))
  (spec compute_count
    (params (count_index i64) (a (ref (slice i64))) (b (ref (slice i64))))
    (returns (p i64))
    (requires
      (>= count_index 0)
      (or (== count_index 0) (and (== (len a) (len b)) (and (<= 1 count_index) (<= count_index (len a))))))
    (ensures
      (>= p 0)
      (== p (count count_index a)))
    (effects))
  (def compute_count
    (body
      (let-mut c i64 0)
      (let-mut i i64 0)
      (while (< i count_index)
        (invariant (and (<= 0 i) (<= i count_index)))
        (invariant (and (<= 0 c) (<= c i)))
        (invariant (== c (count i a)))
        (decreases (- count_index i))
        (if (== (% (idx a i) 2) 0) (set c (+ c 1)) (block))
        (set i (+ i 1)))
      (return c))))
