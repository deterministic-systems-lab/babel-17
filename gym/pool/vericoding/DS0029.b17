(module lcm_int
  (header
    (purpose "Return a non-negative common multiple of two non-zero integers.")
    (invariants "The result is non-negative and a multiple of both a and b.")
    (failures "None. The precondition keeps |a|, |b| and their product in i64."))
  (ghost-fn abs ((x int)) int
    (body (if (< x 0) (neg x) x)))
  (spec lcm_int
    (params (a i64) (b i64))
    (returns (result i64))
    (requires
      (!= a 0)
      (!= b 0)
      (> a -9223372036854775808)
      (> b -9223372036854775808)
      (in_i64 (* (abs a) (abs b))))
    (ensures
      (>= result 0)
      (== (% result a) 0)
      (== (% result b) 0))
    (effects))
  (ghost-fn gcd ((x int) (y int)) int
    (requires (and (>= x 0) (>= y 0)))
    (decreases y)
    (body (if (== y 0) x (gcd y (% x y)))))
  (lemma mul_divmod (params (d int) (k int))
    (requires (!= d 0))
    (ensures (== (/ (* d k) d) k) (== (% (* d k) d) 0))
    (body))
  (lemma gcd_div (params (x int) (y int))
    (requires (>= x 0) (>= y 0) (> (+ x y) 0))
    (ensures (> (gcd x y) 0) (== (% x (gcd x y)) 0) (== (% y (gcd x y)) 0))
    (decreases y)
    (body
      (if (== y 0)
        (block (call mul_divmod x 1) (call mul_divmod x 0))
        (block
          (call gcd_div y (% x y))
          (ghost-let g int (gcd y (% x y)))
          (assert (== (gcd x y) g))
          (assert (== y (* g (/ y g))))
          (assert (== (% x y) (* g (/ (% x y) g))))
          (assert (== x (+ (* y (/ x y)) (% x y))))
          (assert (== x (* g (+ (* (/ y g) (/ x y)) (/ (% x y) g)))))
          (call mul_divmod g (+ (* (/ y g) (/ x y)) (/ (% x y) g)))))))
  (def lcm_int
    (body
      (let x i64 (if (< a 0) (neg a) a))
      (let y i64 (if (< b 0) (neg b) b))
      (let-mut u i64 x)
      (let-mut v i64 y)
      (while (!= v 0)
        (invariant (and (> u 0) (>= v 0)))
        (invariant (== (gcd u v) (gcd x y)))
        (decreases v)
        (let t i64 (% u v))
        (set u v)
        (set v t))
      (call gcd_div x y)
      (let r i64 (/ (* x y) u))
      (ghost-let kx int (/ x u))
      (ghost-let ky int (/ y u))
      (ghost-let sa int (if (< a 0) -1 1))
      (ghost-let sb int (if (< b 0) -1 1))
      (assert (== x (* u kx)))
      (assert (== y (* u ky)))
      (assert (== (* x y) (* u (* kx y))))
      (call mul_divmod u (* kx y))
      (assert (== r (* kx y)))
      (assert (== y (* b sb)))
      (assert (== r (* b (* kx sb))))
      (call mul_divmod b (* kx sb))
      (assert (== (* x y) (* u (* x ky))))
      (call mul_divmod u (* x ky))
      (assert (== r (* x ky)))
      (assert (== x (* a sa)))
      (assert (== r (* a (* ky sa))))
      (call mul_divmod a (* ky sa))
      (return r))))
