(module argsort
  (header
    (purpose "Return the indices that would sort an array: the index of its smallest element first, then the next, and so on.")
    (invariants "The result is as long as the array, and among its entries that are indices of the array, the elements they index are in order.")
    (failures "Allocation failure aborts."))
  (spec argsort
    (params (a (ref (slice i64))))
    (returns (result (vec i64)))
    (ensures
      (== (len result) (len a))
      (forall ((i int) (j int))
        (=> (and (and (and (and (<= 0 i) (< i j)) (< j (len result)))
                      (and (<= 0 (idx result i)) (< (idx result i) (len a))))
                 (and (<= 0 (idx result j)) (< (idx result j) (len a))))
            (<= (idx a (idx result i)) (idx a (idx result j))))))
    (effects alloc))
  (def argsort
    (body
      (let n i64 (len a))
      (let-mut r (vec i64) (seq-build n (fn (p) p)))
      (let-mut k i64 0)
      (while (< k n)
        (invariant (and (<= 0 k) (<= k n)))
        (invariant (== (len r) n))
        (invariant (forall ((p int)) (=> (and (<= 0 p) (< p n)) (and (<= 0 (idx r p)) (< (idx r p) n)))))
        (invariant (forall ((p int) (q int)) (=> (and (and (<= 0 p) (< p q)) (< q k)) (<= (idx a (idx r p)) (idx a (idx r q))))))
        (invariant (forall ((p int) (q int)) (=> (and (and (<= 0 p) (< p k)) (and (<= k q) (< q n))) (<= (idx a (idx r p)) (idx a (idx r q))))))
        (decreases (- n k))
        (let-mut m i64 k)
        (let-mut j i64 (+ k 1))
        (while (< j n)
          (invariant (and (<= k m) (< m n)))
          (invariant (and (< k j) (<= j n)))
          (invariant (== (len r) n))
          (invariant (forall ((p int)) (=> (and (<= 0 p) (< p n)) (and (<= 0 (idx r p)) (< (idx r p) n)))))
          (invariant (forall ((t int)) (=> (and (<= k t) (< t j)) (<= (idx a (idx r m)) (idx a (idx r t))))))
          (decreases (- n j))
          (if (< (idx a (idx r j)) (idx a (idx r m))) (set m j) (block))
          (set j (+ j 1)))
        (let tmp i64 (idx r k))
        (set-idx r k (idx r m))
        (set-idx r m tmp)
        (set k (+ k 1)))
      (return r))))
