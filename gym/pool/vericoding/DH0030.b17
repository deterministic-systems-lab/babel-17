(module sort_seq_pred
  (header
    (purpose "Sort the elements at the positions a mask selects, leaving the other positions as they were.")
    (invariants "The selected positions hold their elements in order, the others are unchanged, and the output is a permutation of the input.")
    (failures "Allocation failure aborts."))
  (spec sort_seq_pred
    (params (s (ref (slice i64))) (p (ref (slice bool))))
    (returns (sorted_seq (vec i64)))
    (requires (== (len s) (len p)))
    (ensures
      (== (len sorted_seq) (len s))
      (forall ((i int) (j int))
        (=> (and (and (and (<= 0 i) (< i j)) (< j (len sorted_seq))) (and (idx p i) (idx p j)))
            (<= (idx sorted_seq i) (idx sorted_seq j))))
      (== (multiset s) (multiset sorted_seq))
      (forall ((i int)) (=> (and (and (<= 0 i) (< i (len s))) (not (idx p i))) (== (idx sorted_seq i) (idx s i)))))
    (effects alloc))
  (def sort_seq_pred
    (body
      (let n i64 (len s))
      (let-mut v (vec i64) (seq-build n (fn (k) (idx s k))))
      (assert (== v s))
      (let-mut i i64 0)
      (while (< i n)
        (invariant (and (<= 0 i) (<= i n)))
        (invariant (== (len v) n))
        (invariant (== (multiset s) (multiset v)))
        (invariant (forall ((k int)) (=> (and (and (<= 0 k) (< k n)) (not (idx p k))) (== (idx v k) (idx s k)))))
        (invariant (forall ((x int) (y int))
          (=> (and (and (and (<= 0 x) (< x i)) (and (<= i y) (< y n))) (and (idx p x) (idx p y)))
              (<= (idx v x) (idx v y)))))
        (invariant (forall ((x int) (y int))
          (=> (and (and (and (<= 0 x) (< x y)) (< y i)) (and (idx p x) (idx p y)))
              (<= (idx v x) (idx v y)))))
        (decreases (- n i))
        (let-mut j i64 (+ i 1))
        (while (< j n)
          (invariant (and (< i j) (<= j n)))
          (invariant (== (len v) n))
          (invariant (== (multiset s) (multiset v)))
          (invariant (forall ((k int)) (=> (and (and (<= 0 k) (< k n)) (not (idx p k))) (== (idx v k) (idx s k)))))
          (invariant (forall ((x int) (y int))
            (=> (and (and (and (<= 0 x) (< x i)) (and (<= i y) (< y n))) (and (idx p x) (idx p y)))
                (<= (idx v x) (idx v y)))))
          (invariant (forall ((x int) (y int))
            (=> (and (and (and (<= 0 x) (< x y)) (< y i)) (and (idx p x) (idx p y)))
                (<= (idx v x) (idx v y)))))
          (invariant (forall ((y int))
            (=> (and (and (< i y) (< y j)) (and (idx p i) (idx p y))) (<= (idx v i) (idx v y)))))
          (decreases (- n j))
          (if (and (and (idx p i) (idx p j)) (> (idx v i) (idx v j)))
            (block
              (let tmp i64 (idx v i))
              (set-idx v i (idx v j))
              (set-idx v j tmp))
            (block))
          (set j (+ j 1)))
        (set i (+ i 1)))
      (return v))))
