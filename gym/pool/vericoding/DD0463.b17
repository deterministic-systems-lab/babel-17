(module contains_duplicate
  (header
    (purpose "Decide whether a sequence's values are all distinct; as the source states it, the result is true exactly when no value repeats.")
    (invariants "The result is true exactly when no two positions hold the same value.")
    (failures "None. The precondition bounds the length by 100000 and every value by 10^9."))
  (ghost-fn distinct ((nums (seq int))) bool
    (body (forall ((i int) (j int)) (=> (and (and (<= 0 i) (< i j)) (< j (len nums))) (!= (idx nums i) (idx nums j))))))
  (spec contains_duplicate
    (params (nums (ref (slice i64))))
    (returns (result bool))
    (requires
      (and (<= 1 (len nums)) (<= (len nums) 100000))
      (forall ((i int)) (=> (and (<= 0 i) (< i (len nums))) (and (<= -1000000000 (idx nums i)) (<= (idx nums i) 1000000000)))))
    (ensures (== result (distinct nums)))
    (effects))
  (def contains_duplicate
    (body
      (let-mut i i64 0)
      (while (< i (len nums))
        (invariant (and (<= 0 i) (<= i (len nums))))
        (invariant (forall ((p int) (q int)) (=> (and (and (<= 0 p) (< p q)) (< q i)) (!= (idx nums p) (idx nums q)))))
        (decreases (- (len nums) i))
        (let-mut j i64 0)
        (while (< j i)
          (invariant (and (<= 0 j) (<= j i)))
          (invariant (forall ((p int)) (=> (and (<= 0 p) (< p j)) (!= (idx nums p) (idx nums i)))))
          (decreases (- i j))
          (if (== (idx nums j) (idx nums i)) (return false) (block))
          (set j (+ j 1)))
        (set i (+ i 1)))
      (return true))))
