(module if_power_of_four
  (header
    (purpose "Decide whether a natural number is a power of four.")
    (invariants "The result is true exactly when n equals 4 to the power m for some natural m. Every such m is below 32, since 4 to the 32nd exceeds i64.")
    (failures "None."))
  (ghost-fn power ((base int) (exp int)) int
    (requires (>= exp 0))
    (decreases exp)
    (body (if (== exp 0) 1 (* base (power base (- exp 1))))))
  (spec if_power_of_four
    (params (n i64))
    (returns (result bool))
    (requires (>= n 0))
    (ensures (== result (exists ((m int)) (and (and (<= 0 m) (< m 32)) (== n (power 4 m))))))
    (effects))
  (lemma pow_pos (params (k int))
    (requires (>= k 0))
    (ensures (>= (power 4 k) 1))
    (decreases k)
    (body (if (> k 0) (call pow_pos (- k 1)) (block))))
  (lemma pow_mono (params (a int) (b int))
    (requires (<= 0 a) (<= a b))
    (ensures (<= (power 4 a) (power 4 b)))
    (decreases (- b a))
    (body
      (if (< a b)
        (block
          (call pow_mono a (- b 1))
          (call pow_pos (- b 1))
          (assert (== (power 4 b) (* 4 (power 4 (- b 1))))))
        (block))))
  (lemma pow_small (params (k int))
    (requires (>= k 0) (in_i64 (power 4 k)))
    (ensures (< k 32))
    (body
      (if (>= k 32)
        (block (call pow_mono 32 k) (assert (== (power 4 32) 18446744073709551616)))
        (block))))
  (def if_power_of_four
    (body
      (let-mut q i64 1)
      (ghost-let-mut k int 0)
      (while (< q n)
        (invariant (>= k 0))
        (invariant (>= q 1))
        (invariant (== q (power 4 k)))
        (invariant (forall ((j int)) (=> (and (<= 0 j) (< j k)) (< (power 4 j) n))))
        (decreases (- n q))
        (if (> q (/ n 4))
          (block
            (assert (== (power 4 (+ k 1)) (* 4 q)))
            (forall ((m int)) (call pow_mono (+ k 1) m))
            (return false))
          (block))
        (set q (* q 4))
        (ghost-set k (+ k 1)))
      (if (== q n)
        (block (call pow_small k) (return true))
        (block (forall ((m int)) (call pow_mono k m)) (return false))))))
