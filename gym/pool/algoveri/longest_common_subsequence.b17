(module longest_common_subsequence
  (header
    (purpose "Find the length of a longest common subsequence of two sequences of characters.")
    (invariants "The result is the longest common subsequence's length, as its recursive definition gives it.")
    (failures "Allocation failure aborts."))
  (ghost-fn max ((a int) (b int)) int
    (body (if (> a b) a b)))
  (ghost-fn lcs_spec ((s1 (seq int)) (s2 (seq int))) int
    (decreases (+ (len s1) (len s2)))
    (body
      (if (or (== (len s1) 0) (== (len s2) 0))
        0
        (if (== (idx s1 (- (len s1) 1)) (idx s2 (- (len s2) 1)))
          (+ 1 (lcs_spec (take s1 (- (len s1) 1)) (take s2 (- (len s2) 1))))
          (max (lcs_spec (take s1 (- (len s1) 1)) s2) (lcs_spec s1 (take s2 (- (len s2) 1))))))))
  (spec solve_longest_common_subsequence
    (params (s (ref (slice i64))) (t (ref (slice i64))))
    (returns (length i64))
    (requires (<= (len s) 3000) (<= (len t) 3000))
    (ensures (== length (lcs_spec s t)) (>= length 0))
    (effects alloc))
  (lemma lcs_step (params (a (seq int)) (b (seq int)) (i int) (j int))
    (requires (and (<= 0 i) (< i (len a))) (and (<= 1 j) (<= j (len b))))
    (ensures
      (== (lcs_spec (take a (+ i 1)) (take b j))
          (if (== (idx a i) (idx b (- j 1)))
            (+ 1 (lcs_spec (take a i) (take b (- j 1))))
            (max (lcs_spec (take a i) (take b j)) (lcs_spec (take a (+ i 1)) (take b (- j 1)))))))
    (body
      (assert (== (take (take a (+ i 1)) i) (take a i)))
      (assert (== (take (take b j) (- j 1)) (take b (- j 1))))
      (assert (== (idx (take a (+ i 1)) i) (idx a i)))
      (assert (== (idx (take b j) (- j 1)) (idx b (- j 1))))))
  (def solve_longest_common_subsequence
    (body
      (let m i64 (len s))
      (let n i64 (len t))
      (let-mut prev (vec i64) (seq-build (+ n 1) (fn (k) 0)))
      (let-mut i i64 0)
      (while (< i m)
        (invariant (and (<= 0 i) (<= i m)))
        (invariant (== (len prev) (+ n 1)))
        (invariant (forall ((k int)) (=> (and (<= 0 k) (<= k n))
          (and (== (idx prev k) (lcs_spec (take s i) (take t k))) (and (<= 0 (idx prev k)) (<= (idx prev k) i))))))
        (decreases (- m i))
        (let-mut cur (vec i64) (vec-new))
        (assert (== (lcs_spec (take s (+ i 1)) (take t 0)) 0))
        (push cur 0)
        (let-mut j i64 1)
        (while (<= j n)
          (invariant (and (<= 1 j) (<= j (+ n 1))))
          (invariant (< i m))
          (invariant (== (len cur) j))
          (invariant (== (len prev) (+ n 1)))
          (invariant (forall ((k int)) (=> (and (<= 0 k) (<= k n))
            (and (== (idx prev k) (lcs_spec (take s i) (take t k))) (and (<= 0 (idx prev k)) (<= (idx prev k) i))))))
          (invariant (forall ((k int)) (=> (and (<= 0 k) (< k j))
            (and (== (idx cur k) (lcs_spec (take s (+ i 1)) (take t k))) (and (<= 0 (idx cur k)) (<= (idx cur k) (+ i 1)))))))
          (decreases (- (+ n 1) j))
          (call lcs_step s t i j)
          (if (== (idx s i) (idx t (- j 1)))
            (push cur (+ (idx prev (- j 1)) 1))
            (if (> (idx prev j) (idx cur (- j 1)))
              (push cur (idx prev j))
              (push cur (idx cur (- j 1)))))
          (set j (+ j 1)))
        (set prev cur)
        (set i (+ i 1)))
      (assert (== (take s m) s))
      (assert (== (take t n) t))
      (return (idx prev n)))))
