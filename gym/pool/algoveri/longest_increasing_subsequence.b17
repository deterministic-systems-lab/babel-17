(module longest_increasing_subsequence
  (header
    (purpose "Find the length of a longest strictly increasing subsequence.")
    (invariants "Every increasing subsequence is at most as long as the result, and some has exactly its length.")
    (failures "Allocation failure aborts."))
  (ghost-fn is_valid_is ((s (seq int)) (indices (seq int))) bool
    (body (and (forall ((k int) (m int)) (=> (and (<= 0 k) (and (< k m) (< m (len indices)))) (< (idx indices k) (idx indices m))))
               (and (forall ((k int)) (=> (and (<= 0 k) (< k (len indices))) (and (<= 0 (idx indices k)) (< (idx indices k) (len s)))))
                    (forall ((k int) (m int)) (=> (and (<= 0 k) (and (< k m) (< m (len indices))))
                                                  (< (idx s (idx indices k)) (idx s (idx indices m)))))))))
  (ghost-fn ends_at ((s (seq int)) (w (seq int)) (j int)) bool
    (body (and (and (is_valid_is s w) (> (len w) 0)) (== (idx w (- (len w) 1)) j))))
  (ghost-fn ub ((s (seq int)) (j int) (b int)) bool
    (body (forall ((sub (seq int))) (=> (ends_at s sub j) (<= (len sub) b)))))
  (ghost-fn all_ub ((s (seq int)) (dp (seq int)) (i int)) bool
    (body (forall ((j int)) (=> (and (and (<= 0 j) (< j i)) (< j (len dp))) (ub s j (idx dp j))))))
  (ghost-fn wits ((s (seq int)) (dp (seq int)) (wit (seq (seq int))) (i int)) bool
    (body (forall ((j int)) (=> (and (and (<= 0 j) (< j i)) (and (< j (len dp)) (< j (len wit))))
      (and (ends_at s (idx wit j) j) (== (len (idx wit j)) (idx dp j)))))))
  (ghost-fn dominated ((s (seq int)) (dp (seq int)) (k int) (i int) (b int)) bool
    (body (forall ((j int)) (=> (and (and (and (<= 0 j) (< j k)) (and (< j (len dp)) (< j (len s))))
                                     (and (and (<= 0 i) (< i (len s))) (< (idx s j) (idx s i))))
                                (< (idx dp j) b)))))
  (ghost-fn capped ((dp (seq int)) (i int) (b int)) bool
    (body (forall ((j int)) (=> (and (and (<= 0 j) (< j i)) (< j (len dp)))
      (and (<= 1 (idx dp j)) (and (<= (idx dp j) (+ j 1)) (<= (idx dp j) b)))))))
  (lemma step_dom (params (s (seq int)) (dp (seq int)) (k int) (i int) (b int) (b2 int))
    (requires (dominated s dp k i b) (<= b b2) (and (<= 0 k) (< k i)) (and (< i (len s)) (== (len dp) i))
              (=> (< (idx s k) (idx s i)) (< (idx dp k) b2)))
    (ensures (dominated s dp (+ k 1) i b2))
    (body))
  (lemma step_push (params (s (seq int)) (dp0 (seq int)) (wit0 (seq (seq int))) (dp (seq int)) (wit (seq (seq int)))
                           (i int) (cur int) (cw (seq int)) (best int) (best2 int))
    (requires (wits s dp0 wit0 i) (all_ub s dp0 i) (capped dp0 i best) (ub s i cur) (ends_at s cw i) (== (len cw) cur)
              (and (<= 1 cur) (<= cur (+ i 1))) (<= best best2) (<= cur best2) (>= i 0)
              (== (len dp0) i) (== (len wit0) i) (== dp (concat dp0 (seq-lit cur))) (== wit (concat wit0 (seq-lit cw))))
    (ensures (wits s dp wit (+ i 1)) (all_ub s dp (+ i 1)) (capped dp (+ i 1) best2))
    (body))
  (lemma extend (params (s (seq int)) (w (seq int)) (k int) (i int))
    (requires (ends_at s w k) (and (< k i) (< i (len s))) (< (idx s k) (idx s i)))
    (ensures (ends_at s (concat w (seq-lit i)) i) (== (len (concat w (seq-lit i))) (+ (len w) 1)))
    (body))
  (lemma drop_last (params (s (seq int)) (sub (seq int)))
    (requires (is_valid_is s sub) (>= (len sub) 2))
    (ensures
      (ends_at s (take sub (- (len sub) 1)) (idx sub (- (len sub) 2)))
      (and (<= 0 (idx sub (- (len sub) 2))) (< (idx sub (- (len sub) 2)) (idx sub (- (len sub) 1))))
      (< (idx s (idx sub (- (len sub) 2))) (idx s (idx sub (- (len sub) 1))))
      (== (len (take sub (- (len sub) 1))) (- (len sub) 1)))
    (body))
  (lemma bound_at (params (s (seq int)) (dp (seq int)) (i int) (b int) (sub (seq int)))
    (requires (all_ub s dp i) (dominated s dp i i b) (>= b 1) (and (<= 0 i) (< i (len s))) (== (len dp) i) (ends_at s sub i))
    (ensures (<= (len sub) b))
    (body
      (if (>= (len sub) 2)
        (block
          (call drop_last s sub)
          (assert (ub s (idx sub (- (len sub) 2)) (idx dp (idx sub (- (len sub) 2)))))
          (assert (ends_at s (take sub (- (len sub) 1)) (idx sub (- (len sub) 2)))))
        (block))))
  (lemma top (params (s (seq int)) (dp (seq int)) (b int) (sub (seq int)))
    (requires (all_ub s dp (len s)) (capped dp (len s) b) (== (len dp) (len s)) (is_valid_is s sub) (> (len sub) 0))
    (ensures (<= (len sub) b))
    (body
      (assert (ends_at s sub (idx sub (- (len sub) 1))))
      (assert (ub s (idx sub (- (len sub) 1)) (idx dp (idx sub (- (len sub) 1)))))))
  (spec longest_increasing_subsequence
    (params (s (ref (slice i64))))
    (returns (result i64))
    (requires (<= (len s) 9223372036854775807))
    (ensures
      (>= result 0)
      (forall ((sub (seq int))) (=> (and (is_valid_is s sub) (> (len sub) 0)) (<= (len sub) result)))
      (exists ((sub (seq int))) (and (is_valid_is s sub) (== (len sub) result))))
    (effects alloc))
  (def longest_increasing_subsequence
    (body
      (let n i64 (len s))
      (let-mut dp (vec i64) (vec-new))
      (ghost-let-mut wit (seq (seq int)) (seq-lit))
      (let-mut best i64 0)
      (ghost-let-mut bw (seq int) (seq-lit))
      (let-mut i i64 0)
      (while (< i n)
        (invariant (and (<= 0 i) (<= i n)))
        (invariant (and (== (len dp) i) (== (len wit) i)))
        (invariant (capped dp i best))
        (invariant (and (<= 0 best) (<= best i)))
        (invariant (and (is_valid_is s bw) (== (len bw) best)))
        (invariant (wits s dp wit i))
        (invariant (all_ub s dp i))
        (decreases (- n i))
        (let-mut cur i64 1)
        (ghost-let-mut cw (seq int) (seq-lit i))
        (let-mut k i64 0)
        (while (< k i)
          (invariant (and (<= 0 k) (<= k i)))
          (invariant (< i n))
          (invariant (and (== (len dp) i) (== (len wit) i)))
          (invariant (capped dp i best))
          (invariant (and (<= 0 best) (<= best i)))
          (invariant (and (is_valid_is s bw) (== (len bw) best)))
          (invariant (wits s dp wit i))
          (invariant (all_ub s dp i))
          (invariant (and (<= 1 cur) (<= cur (+ k 1))))
          (invariant (and (ends_at s cw i) (== (len cw) cur)))
          (invariant (dominated s dp k i cur))
          (decreases (- i k))
          (if (and (< (idx s k) (idx s i)) (> (+ (idx dp k) 1) cur))
            (block
              (call extend s (idx wit k) k i)
              (call step_dom s dp k i cur (+ (idx dp k) 1))
              (ghost-set cw (concat (idx wit k) (seq-lit i)))
              (set cur (+ (idx dp k) 1)))
            (call step_dom s dp k i cur cur))
          (set k (+ k 1)))
        (forall ((sub (seq int))) (call bound_at s dp i cur sub))
        (assert (ub s i cur))
        (ghost-let dp0 (seq int) dp)
        (ghost-let wit0 (seq (seq int)) wit)
        (ghost-let best0 int best)
        (push dp cur)
        (ghost-set wit (concat wit (seq-lit cw)))
        (if (> cur best)
          (block (set best cur) (ghost-set bw cw))
          (block))
        (call step_push s dp0 wit0 dp wit i cur cw best0 best)
        (set i (+ i 1)))
      (forall ((sub (seq int))) (call top s dp best sub))
      (return best))))
