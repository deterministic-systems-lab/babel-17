(module trie_delete
  (header
    (purpose "Delete a byte string from a trie whose nodes have 256 optional children.")
    (invariants "The result is a pruned, well-formed trie, or none, holding the old keys but the deleted one.")
    (failures "Allocation failure aborts."))
  (data node () (node (is_end bool) (children (vec (option node)))))
  (ghost-fn is_empty ((n node)) bool (requires (== (len (field n children)) 256))
    (body (and (not (field n is_end))
               (forall ((i int)) (=> (and (<= 0 i) (< i 256)) (is none (idx (field n children) i)))))))
  (ghost-fn well_formed ((n node)) bool (decreases (rank n))
    (body (and (== (len (field n children)) 256)
               (forall ((i int)) (=> (and (<= 0 i) (< i 256))
                 (match (idx (field n children) i)
                   (case (none) true)
                   (case (some c) (and (well_formed c) (and (== (len (field c children)) 256) (not (is_empty c)))))))))))
  (ghost-fn has_key ((n node) (key (seq int))) bool (decreases (len key))
    (body (if (== (len key) 0)
            (field n is_end)
            (if (and (<= 0 (idx key 0)) (< (idx key 0) (len (field n children))))
              (match (idx (field n children) (idx key 0))
                (case (none) false)
                (case (some c) (has_key c (drop key 1))))
              false))))
  (ghost-fn view ((n node)) (iset (seq int))
    (body (iset-of ((key (seq int))) (has_key n key))))
  (ghost-fn opt_view ((o (option node))) (iset (seq int))
    (body (match o
      (case (none) (iset-lit))
      (case (some n) (view n)))))
  (ghost-fn opt_well_formed ((o (option node))) bool
    (body (match o
      (case (none) true)
      (case (some n) (and (well_formed n) (not (is_empty n)))))))
  (spec delete
    (params (tree (option node)) (key (ref (slice i64))))
    (returns (res (option node)))
    (requires
      (opt_well_formed tree)
      (forall ((k int)) (=> (contains key k) (and (<= 0 k) (< k 256)))))
    (ensures (opt_well_formed res) (== (opt_view res) (diff (opt_view tree) (iset-lit key))))
    (effects alloc))
  (lemma wf_body (params (before node) (after node) (k int) (sub (option node)))
    (requires
      (well_formed before) (opt_well_formed sub)
      (and (<= 0 k) (< k 256))
      (== (len (field after children)) 256)
      (== (idx (field after children) k) sub)
      (forall ((j int)) (=> (and (and (<= 0 j) (< j 256)) (!= j k))
        (== (idx (field after children) j) (idx (field before children) j)))))
    (ensures (forall ((i int)) (=> (and (<= 0 i) (< i 256))
        (match (idx (field after children) i)
          (case (none) true)
          (case (some c) (and (well_formed c) (and (== (len (field c children)) 256) (not (is_empty c)))))))))
    (body))
  (lemma wf_from_body (params (after node))
    (requires (== (len (field after children)) 256) (forall ((i int)) (=> (and (<= 0 i) (< i 256))
        (match (idx (field after children) i)
          (case (none) true)
          (case (some c) (and (well_formed c) (and (== (len (field c children)) 256) (not (is_empty c)))))))))
    (ensures (well_formed after))
    (body))
  (lemma wf_same (params (before node) (after node))
    (requires (well_formed before) (== (field after children) (field before children)))
    (ensures (well_formed after))
    (body (call wf_from_body after)))
  (lemma view_at (params (before node) (after node) (k int) (sub (option node)) (key (seq int)) (i int) (y (seq int)))
    (requires
      (== (len (field before children)) 256)
      (== (len (field after children)) 256)
      (== (field after is_end) (field before is_end))
      (and (<= 0 k) (< k 256))
      (== (idx (field after children) k) sub)
      (forall ((j int)) (=> (and (and (<= 0 j) (< j 256)) (!= j k))
        (== (idx (field after children) j) (idx (field before children) j))))
      (and (<= 0 i) (< i (len key)))
      (== (idx key i) k)
      (forall ((z (seq int))) (== (contains (opt_view sub) z)
        (contains (diff (opt_view (idx (field before children) k)) (iset-lit (drop key (+ i 1)))) z))))
    (ensures (== (contains (view after) y) (and (contains (view before) y) (!= y (drop key i)))))
    (body
      (if (and (> (len y) 0) (== (idx y 0) k))
        (block
          (assert (== (contains (opt_view sub) (drop y 1))
                      (contains (diff (opt_view (idx (field before children) k)) (iset-lit (drop key (+ i 1)))) (drop y 1))))
          (assert (forall ((j int)) (=> (and (<= 1 j) (< j (len y))) (== (idx y j) (idx (drop y 1) (- j 1))))))
          (assert (forall ((j int)) (=> (and (<= 1 j) (< j (- (len key) i)))
            (== (idx (drop key i) j) (idx (drop key (+ i 1)) (- j 1))))))
          (assert (== (== y (drop key i)) (== (drop y 1) (drop key (+ i 1))))))
        (block (assert (> (len (drop key i)) 0)) (assert (== (idx (drop key i) 0) k))))))
  (lemma view_end (params (before node) (after node) (key (seq int)) (i int) (y (seq int)))
    (requires (not (field after is_end)) (== (field after children) (field before children)) (== i (len key)))
    (ensures (== (contains (view after) y) (and (contains (view before) y) (!= y (drop key i)))))
    (body (assert (== (len (drop key i)) 0))))
  (lemma empty_no_key (params (m node) (y (seq int)))
    (requires (== (len (field m children)) 256) (is_empty m))
    (ensures (not (has_key m y)))
    (body))
  (spec all_none
    (params (kids (ref (slice (option node)))))
    (returns (r bool))
    (ensures (== r (forall ((j int)) (=> (and (<= 0 j) (< j (len kids))) (is none (idx kids j))))))
    (effects))
  (def all_none
    (body
      (let-mut j i64 0)
      (while (< j (len kids))
        (invariant (and (<= 0 j) (<= j (len kids))))
        (invariant (forall ((t int)) (=> (and (<= 0 t) (< t j)) (is none (idx kids t)))))
        (decreases (- (len kids) j))
        (if (is some (idx kids j)) (return false) (block))
        (set j (+ j 1)))
      (return true)))
  (spec prune
    (params (m node))
    (returns (res (option node)))
    (requires (== (len (field m children)) 256))
    (ensures (=> (is_empty m) (is none res)) (=> (not (is_empty m)) (== res (some m))))
    (effects))
  (def prune
    (body
      (let e bool (field m is_end))
      (let-mut x node m)
      (let kids (vec (option node)) (replace (field x children) (vec-new)))
      (assert (== kids (field m children)))
      (let ((b bool)) (call all_none (borrow kids)))
      (if (and (not e) b)
        (return (none))
        (return (some (node e kids))))))
  (spec delete_at
    (params (o (option node)) (key (ref (slice i64))) (i i64))
    (returns (res (option node)))
    (requires
      (opt_well_formed o)
      (forall ((k int)) (=> (contains key k) (and (<= 0 k) (< k 256))))
      (and (<= 0 i) (<= i (len key))))
    (ensures (opt_well_formed res) (== (opt_view res) (diff (opt_view o) (iset-lit (drop key i)))))
    (effects alloc))
  (def delete_at (decreases (- (len key) i))
    (body
      (match o
        (case (none) (return (none)))
        (case (some n)
          (block
            (ghost-let before node n)
            (let-mut m node n)
            (if (== i (len key))
              (block
                (let kids (vec (option node)) (replace (field m children) (vec-new)))
                (let after node (node false kids))
                (call wf_same before after)
                (forall ((y (seq int))) (call view_end before after key i y))
                (forall ((y (seq int))) (call empty_no_key after y))
                (let ((r1 (option node))) (call prune after))
                (return r1))
              (block
                (let c i64 (idx key i))
                (assert (contains key c))
                (let child (option node) (replace (idx (field m children) c) (none)))
                (let ((sub (option node))) (call delete_at child key (+ i 1)))
                (assert (forall ((z (seq int))) (== (contains (opt_view sub) z)
                  (contains (diff (opt_view child) (iset-lit (drop key (+ i 1)))) z))))
                (set-idx (field m children) c sub)
                (call wf_body before m c sub)
                (call wf_from_body m)
                (forall ((y (seq int))) (call view_at before m c sub key i y))
                (forall ((y (seq int))) (call empty_no_key m y))
                (let ((r2 (option node))) (call prune m))
                (return r2))))))))
  (def delete
    (body
      (assert (== (drop key 0) key))
      (let ((res (option node))) (call delete_at tree key 0))
      (return res))))
