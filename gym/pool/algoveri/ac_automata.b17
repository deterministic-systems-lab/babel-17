(module ac_automata
  (header
    (purpose "Find every occurrence of each of several patterns in a haystack, as pairs of a pattern's index and a start position.")
    (invariants "Every returned pair names a pattern that occurs at its position, and every occurrence of every pattern is returned.")
    (failures "Allocation failure aborts."))
  (ghost-fn matches_at ((haystack (seq int)) (needle (seq int)) (start_index int)) bool
    (body (and (and (<= 0 start_index) (<= (+ start_index (len needle)) (len haystack)))
               (forall ((i int)) (=> (and (<= 0 i) (< i (len needle))) (== (idx haystack (+ start_index i)) (idx needle i)))))))
  (spec ac_automata_search
    (params (haystack (ref (slice i64))) (patterns (ref (slice (vec i64)))))
    (returns (results (vec (tuple i64 i64))))
    (requires
      (> (len patterns) 0)
      (< (len haystack) 1000000)
      (< (len patterns) 1000000)
      (forall ((i int)) (=> (and (<= 0 i) (< i (len patterns))) (< (len (idx patterns i)) 1000000))))
    (ensures
      (forall ((i int))
        (=> (and (<= 0 i) (< i (len results)))
            (and (and (and (>= (get (idx results i) 0) 0) (>= (get (idx results i) 1) 0))
                      (and (<= 0 (get (idx results i) 0)) (< (get (idx results i) 0) (len patterns))))
                 (matches_at haystack (idx patterns (get (idx results i) 0)) (get (idx results i) 1)))))
      (forall ((pid int) (start int))
        (=> (and (and (and (<= 0 pid) (< pid (len patterns)))
                      (and (<= 0 start) (<= start (- (len haystack) (len (idx patterns pid))))))
                 (matches_at haystack (idx patterns pid) start))
            (exists ((k int)) (and (and (<= 0 k) (< k (len results))) (== (tuple pid start) (idx results k)))))))
    (effects alloc))
  (def ac_automata_search
    (body
      (let n i64 (len haystack))
      (let np i64 (len patterns))
      (let-mut results (vec (tuple i64 i64)) (vec-new))
      (let-mut pid i64 0)
      (while (< pid np)
        (invariant (and (<= 0 pid) (<= pid np)))
        (invariant (<= (len results) (* pid 1000001)))
        (invariant (forall ((r int))
          (=> (and (<= 0 r) (< r (len results)))
              (and (and (and (>= (get (idx results r) 0) 0) (>= (get (idx results r) 1) 0))
                        (and (<= 0 (get (idx results r) 0)) (< (get (idx results r) 0) (len patterns))))
                   (matches_at haystack (idx patterns (get (idx results r) 0)) (get (idx results r) 1))))))
        (invariant (forall ((q int) (s int))
          (=> (and (and (and (<= 0 q) (< q pid))
                        (and (<= 0 s) (<= s (- (len haystack) (len (idx patterns q))))))
                   (matches_at haystack (idx patterns q) s))
              (exists ((k int)) (and (and (<= 0 k) (< k (len results))) (== (tuple q s) (idx results k)))))))
        (decreases (- np pid))
        (let m i64 (len (idx patterns pid)))
        (let-mut i i64 0)
        (ghost-let-mut w (seq int) (seq-lit))
        (while (<= i (- n m))
          (invariant (and (<= 0 i) (or (== i 0) (<= i (+ (- n m) 1)))))
          (invariant (<= (len results) (+ (* pid 1000001) i)))
          (invariant (forall ((r int))
            (=> (and (<= 0 r) (< r (len results)))
                (and (and (and (>= (get (idx results r) 0) 0) (>= (get (idx results r) 1) 0))
                          (and (<= 0 (get (idx results r) 0)) (< (get (idx results r) 0) (len patterns))))
                     (matches_at haystack (idx patterns (get (idx results r) 0)) (get (idx results r) 1))))))
          (invariant (forall ((q int) (s int))
            (=> (and (and (and (<= 0 q) (< q pid))
                          (and (<= 0 s) (<= s (- (len haystack) (len (idx patterns q))))))
                     (matches_at haystack (idx patterns q) s))
                (exists ((k int)) (and (and (<= 0 k) (< k (len results))) (== (tuple q s) (idx results k)))))))
          (invariant (== (len w) i))
          (invariant (forall ((s int))
            (=> (and (and (<= 0 s) (< s i)) (matches_at haystack (idx patterns pid) s))
                (and (and (<= 0 (idx w s)) (< (idx w s) (len results))) (== (tuple pid s) (idx results (idx w s)))))))
          (decreases (- (+ (- n m) 1) i))
          (let-mut j i64 0)
          (while (and (< j m) (== (idx haystack (+ i j)) (idx (idx patterns pid) j)))
            (invariant (and (<= 0 j) (<= j m)))
            (invariant (forall ((t int)) (=> (and (<= 0 t) (< t j)) (== (idx haystack (+ i t)) (idx (idx patterns pid) t)))))
            (decreases (- m j))
            (set j (+ j 1)))
          (if (== j m)
            (block
              (assert (matches_at haystack (idx patterns pid) i))
              (ghost-set w (concat w (seq-lit (len results))))
              (push results (tuple pid i)))
            (block
              (assert (not (matches_at haystack (idx patterns pid) i)))
              (ghost-set w (concat w (seq-lit 0)))))
          (set i (+ i 1)))
        (set pid (+ pid 1)))
      (return results))))
