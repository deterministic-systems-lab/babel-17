(module jump_game
  (header
    (purpose "Decide whether the last index can be reached from the first, jumping from each index at most its value forward.")
    (invariants "The result is true exactly when some valid jump path exists.")
    (failures "None."))
  (ghost-fn is_valid_jump_path ((path (seq int)) (nums (seq int))) bool
    (body (and (forall ((i int)) (=> (and (<= 0 i) (< i (len path))) (and (<= 0 (idx path i)) (< (idx path i) (len nums)))))
          (and (forall ((i int)) (=> (and (<= 0 i) (< i (- (len path) 1))) (> (idx path (+ i 1)) (idx path i))))
          (and (>= (len path) 1)
          (and (== (idx path 0) 0)
          (and (== (idx path (- (len path) 1)) (- (len nums) 1))
               (forall ((i int)) (=> (and (<= 0 i) (< i (- (len path) 1)))
                                     (<= (idx path (+ i 1)) (+ (idx path i) (idx nums (idx path i)))))))))))))
  (ghost-fn path_to ((path (seq int)) (nums (seq int)) (k int)) bool
    (body (and (forall ((i int)) (=> (and (<= 0 i) (< i (len path))) (and (<= 0 (idx path i)) (< (idx path i) (len nums)))))
          (and (forall ((i int)) (=> (and (<= 0 i) (< i (- (len path) 1))) (> (idx path (+ i 1)) (idx path i))))
          (and (>= (len path) 1)
          (and (== (idx path 0) 0)
          (and (== (idx path (- (len path) 1)) k)
               (forall ((i int)) (=> (and (<= 0 i) (< i (- (len path) 1)))
                                     (<= (idx path (+ i 1)) (+ (idx path i) (idx nums (idx path i)))))))))))))
  (ghost-fn witnessed ((wit (seq (seq int))) (nums (seq int)) (reach int)) bool
    (body (forall ((k int)) (=> (and (and (<= 0 k) (<= k reach)) (and (< k (len nums)) (< k (len wit))))
                                (path_to (idx wit k) nums k)))))
  (ghost-fn capped ((nums (seq int)) (i int) (reach int)) bool
    (body (forall ((k int)) (=> (and (and (<= 0 k) (< k i)) (< k (len nums))) (<= (+ k (idx nums k)) reach)))))
  (lemma extend (params (p (seq int)) (nums (seq int)) (i int) (k int))
    (requires (and (<= 0 i) (< i (len nums))) (path_to p nums i) (< i k) (<= k (+ i (idx nums i))) (< k (len nums)))
    (ensures (path_to (concat p (seq-lit k)) nums k))
    (body))
  (lemma stuck (params (nums (seq int)) (i int) (reach int) (p (seq int)) (m int))
    (requires (capped nums i reach) (> i reach) (>= reach 0) (is_valid_jump_path p nums) (and (<= 0 m) (< m (len p))))
    (ensures (<= (idx p m) reach))
    (decreases m)
    (body (if (> m 0) (call stuck nums i reach p (- m 1)) (block))))
  (spec can_jump
    (params (nums (ref (slice i64))))
    (returns (reachable bool))
    (requires
      (> (len nums) 0)
      (<= (len nums) 10000)
      (forall ((i int)) (=> (and (<= 0 i) (< i (len nums))) (>= (idx nums i) 0)))
      (forall ((i int)) (=> (and (<= 0 i) (< i (len nums))) (<= (idx nums i) 10000))))
    (ensures (== reachable (exists ((path (seq int))) (is_valid_jump_path path nums))))
    (effects))
  (def can_jump
    (body
      (let n i64 (len nums))
      (let-mut reach i64 0)
      (let-mut i i64 0)
      (ghost-let-mut wit (seq (seq int)) (seq-build n (fn (j) (seq-lit 0))))
      (while (and (< i n) (<= i reach))
        (invariant (and (<= 0 i) (<= i n)))
        (invariant (and (<= 0 reach) (<= reach 20000)))
        (invariant (== (len wit) n))
        (invariant (witnessed wit nums reach))
        (invariant (capped nums i reach))
        (decreases (- n i))
        (let r i64 (+ i (idx nums i)))
        (if (> r reach)
          (block
            (forall ((k int)) (call extend (idx wit i) nums i k))
            (ghost-set wit (seq-build n (fn (j) (if (and (< reach j) (<= j r)) (concat (idx wit i) (seq-lit j)) (idx wit j)))))
            (set reach r))
          (block))
        (set i (+ i 1)))
      (if (>= reach (- n 1))
        (assert (is_valid_jump_path (idx wit (- n 1)) nums))
        (forall ((p (seq int))) (call stuck nums i reach p (- (len p) 1))))
      (return (>= reach (- n 1))))))
