{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive-git.sh",
            "statusMessage": "checking git safety"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__codex-cli__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-subagent-escalation.sh",
            "statusMessage": "checking subagent authority"
          }
        ]
      }
    ]
  }
}
